The empty registry must compile, including its refutation cases.

  $ ../tools/gen_experimental_features.exe empty.ml empty.mli
  $ sed '/^$/d' empty.ml
  (* Generated by tools/gen_experimental_features.ml. Do not edit. *)
  type review_level = Ai_reviewed | Human_reviewed
  type t = |
  let all : t list = []
  let flag_name : t -> string = function
    | _ -> .
  let review_level : t -> review_level = function
    | _ -> .
  $ ocamlc -c empty.mli empty.ml

Registrations support comments, either key order, tabs and CRLF. The generated
identifiers distinguish hyphens from dots and support leading digits.

  $ mkdir -p first nested/second third fourth
  $ printf 'flag a-b\nlevel ai-reviewed\n' > first/SCRUTINY
  $ printf '# A comment\nlevel human-reviewed # another comment\n\nflag a.b\n' \
  >   > nested/second/SCRUTINY
  $ printf '\tflag 0\r\nlevel ai-reviewed\r\n' > third/SCRUTINY
  $ printf 'flag a.b-1\nlevel human-reviewed\n' > fourth/SCRUTINY
  $ ../tools/gen_experimental_features.exe registry.ml registry.mli \
  >   nested/second/SCRUTINY fourth/SCRUTINY \
  >   first/SCRUTINY third/SCRUTINY
  $ cat > use_registry.ml <<'EOF'
  > open Registry
  > let () =
  >   (match all with
  >   | [Feature_0; Feature_a_b; Feature_a'b; Feature_a'b_1] -> ()
  >   | _ -> failwith "unexpected feature identifiers or ordering");
  >   List.iter
  >     (fun feature ->
  >       let level =
  >         match review_level feature with
  >         | Ai_reviewed -> "ai-reviewed"
  >         | Human_reviewed -> "human-reviewed"
  >       in
  >       Printf.printf "%s %s\n" (flag_name feature) level)
  >     all
  > EOF
  $ ocamlc -o use_registry.exe registry.mli registry.ml use_registry.ml
  $ ocamlrun ./use_registry.exe
  0 ai-reviewed
  a-b ai-reviewed
  a.b human-reviewed
  a.b-1 human-reviewed

Input ordering does not change either generated file.

  $ ../tools/gen_experimental_features.exe reordered.ml reordered.mli \
  >   third/SCRUTINY first/SCRUTINY fourth/SCRUTINY nested/second/SCRUTINY
  $ cmp registry.ml reordered.ml
  $ cmp registry.mli reordered.mli

Malformed registrations are rejected before either output is overwritten.

  $ reject () {
  >   printf '%b' "$1" > invalid
  >   ../tools/gen_experimental_features.exe registry.ml registry.mli invalid
  > }
  $ reject ''
  invalid:1: missing flag
  [2]
  $ reject 'flag a\n'
  invalid:1: missing level
  [2]
  $ reject 'level ai-reviewed\n'
  invalid:1: missing flag
  [2]
  $ reject 'flag a\nflag b\nlevel ai-reviewed\n'
  invalid:2: duplicate key flag
  [2]
  $ reject 'flag a\nlevel ai-reviewed\nlevel human-reviewed\n'
  invalid:3: duplicate key level
  [2]
  $ reject 'unknown a\n'
  invalid:1: unknown key unknown
  [2]
  $ reject 'flag a extra\nlevel ai-reviewed\n'
  invalid:1: expected flag <token>
  [2]
  $ reject 'flag A\nlevel ai-reviewed\n'
  invalid:1: expected flag <token>
  [2]
  $ reject 'flag -a\nlevel ai-reviewed\n'
  invalid:1: expected flag <token>
  [2]
  $ reject 'flag a\nlevel none\n'
  invalid:2: unknown review level none
  [2]
  $ reject 'flag all\nlevel ai-reviewed\n'
  invalid:1: reserved flag name all
  [2]
  $ reject 'flag universe\nlevel ai-reviewed\n'
  invalid:1: reserved flag name universe
  [2]
  $ reject 'flag optimizations\nlevel ai-reviewed\n'
  invalid:1: reserved flag name optimizations
  [2]
  $ cmp registry.ml reordered.ml
  $ cmp registry.mli reordered.mli

Flag names must be unique across registrations.

  $ printf 'flag a-b\nlevel human-reviewed\n' > duplicate
  $ ../tools/gen_experimental_features.exe registry.ml registry.mli \
  >   first/SCRUTINY duplicate
  duplicate:1: duplicate flag a-b (also registered in first/SCRUTINY)
  [2]
  $ cmp registry.ml reordered.ml
  $ cmp registry.mli reordered.mli
