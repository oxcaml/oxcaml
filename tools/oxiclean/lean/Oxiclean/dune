(env
 (_
  (env-vars
   (LEAN_PATH ..))))

(rule
 (targets Model.olean)
 (deps
  (sandbox preserve_file_kind)
  Model.lean)
 (action
  (run lean -DautoImplicit=false -R .. -o %{targets} %{dep:Model.lean})))

