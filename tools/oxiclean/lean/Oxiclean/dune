(env (_ (env-vars (LEAN_PATH ..))))

(rule
 (targets Model.olean)
 (deps
  (sandbox preserve_file_kind)
  Model.lean)
 (action
  (run
   lean
   -R
   ..
   -o
   %{targets}
   %{dep:Model.lean})))

(rule
 (targets BuildSystem.olean)
 (deps
  (sandbox preserve_file_kind)
  BuildSystem.lean
  Model.olean)
 (action
  (run
   lean
   -R
   ..
   -o
   %{targets}
   %{dep:BuildSystem.lean})))
