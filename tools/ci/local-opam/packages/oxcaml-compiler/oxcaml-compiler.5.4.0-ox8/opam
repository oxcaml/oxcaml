opam-version: "2.0"
synopsis: "Pinned OxCaml compiler for bootstrapping CI"
maintainer: "oxcaml-team"
authors: "Xavier Leroy and many contributors"
license: "LGPL-2.1-or-later WITH OCaml-LGPL-linking-exception"
homepage: "https://oxcaml.org"
bug-reports: "https://github.com/oxcaml/oxcaml/issues"
dev-repo: "git+https://github.com/oxcaml/oxcaml.git"
depends: [
  "conf-autoconf" {build}
  "conf-which" {build}
  "ocaml-variants" {= "5.4.0+ox" & post}
  "oxcaml" {post}
  "base-unix" {post}
  "base-bigarray" {post}
  "base-threads" {post}
  "base-domains" {post}
  "base-nnp" {post}
  "ocaml-options-vanilla" {post}
  "oxcaml-patch-guards" {post}
]
flags: compiler
setenv: CAML_LD_LIBRARY_PATH = "%{lib}%/stublibs"
# Bootstrap this release using upstream OCaml, Dune and Menhir in a private
# prefix. Keep the source revision in sync with bootOxcamlSrc in default.nix.
build: [
  ["sh" "-ec" """
    echo '(dirs (:standard \\ init_deps init_ocaml init_dune init_menhir))' >> dune
    mkdir init_ocaml init_dune init_menhir
    tar -xf init-compiler.tar.gz -C init_ocaml --strip-components=1
    patch -d init_ocaml -p1 -i ../init-compiler.patch
    tar -xf init-dune.tbz -C init_dune --strip-components=1
    tar -xf init-menhir.tar.gz -C init_menhir --strip-components=1
    export PATH="%{build}%/init_deps/bin:$PATH"
    (
      cd init_ocaml
      case "%{os}%" in
        macos|openbsd) export CC=cc ASPP='cc -c' ;;
      esac
      ./configure --prefix="%{build}%/init_deps" --disable-ocamldoc
      make -j%{jobs}%
      make install
    )
    (
      cd init_dune
      ocaml boot/bootstrap.ml -j %{jobs}%
      ./_boot/dune.exe build dune.install --release \
        --profile dune-bootstrap -j %{jobs}%
      ./_boot/dune.exe install --root . --prefix="%{build}%/init_deps" dune
    )
    (
      cd init_menhir
      dune build --root . --profile release @install -j %{jobs}%
      dune install --prefix="%{build}%/init_deps" \
        -p menhirLib,menhir -j %{jobs}%
    )
    autoconf || autoconf27
    ./configure --enable-stack-checks --enable-poll-insertion \
      --enable-multidomain --prefix="%{prefix}%" \
      --with-dune="%{build}%/init_deps/bin/dune"
    unset INSIDE_DUNE
    make -j%{jobs}%
  """]
  ["sh" "./write-config.sh" name
    "-v" "release:string" "5.4.0-ox8"
    "-v" "commit:string" "cedb02e4747905c331fc3742c338b2213f7beed9"]
]
install: ["sh" "-ec" """
  PATH="%{build}%/init_deps/bin:$PATH" make install
"""]
url {
  src: "git+https://github.com/oxcaml/oxcaml.git#cedb02e4747905c331fc3742c338b2213f7beed9"
}
