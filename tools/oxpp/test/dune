; End to end: the binary AST is accepted by the context's compiler.

(rule
 (targets e2e.pp.mli)
 (deps e2e.mli)
 (action
  (with-stdout-to
   e2e.pp.mli
   (run %{exe:../oxpp.exe} -context %{context_name} e2e.mli))))

(rule
 (targets e2e.pp.ml)
 (deps e2e.ml)
 (action
  (with-stdout-to
   e2e.pp.ml
   (run %{exe:../oxpp.exe} -context %{context_name} e2e.ml))))

(rule
 (alias runtest)
 (targets e2e.cmi e2e.cmo)
 (deps e2e.pp.mli e2e.pp.ml)
 (action
  (progn
   (run %{ocamlc} -c -intf e2e.pp.mli -o e2e.cmi)
   (run %{ocamlc} -c -impl e2e.pp.ml -o e2e.cmo))))
