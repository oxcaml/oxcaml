; Rejections

(rule
 (alias runtest)
 (targets comprehension.ml.err)
 (deps comprehension.ml)
 (action
  (progn
   (with-stderr-to
    comprehension.ml.err
    (with-accepted-exit-codes
     2
     (run %{exe:../oxpp.exe} -context default comprehension.ml)))
   (diff comprehension.ml.expected comprehension.ml.err))))

(rule
 (alias runtest)
 (targets let_mutable.ml.err)
 (deps let_mutable.ml)
 (action
  (progn
   (with-stderr-to
    let_mutable.ml.err
    (with-accepted-exit-codes
     2
     (run %{exe:../oxpp.exe} -context default let_mutable.ml)))
   (diff let_mutable.ml.expected let_mutable.ml.err))))

