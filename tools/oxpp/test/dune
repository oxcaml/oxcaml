; Tests for tools/oxpp.
;
; The golden tests run oxpp in erasing mode and have the system compiler print
; the resulting AST back as source (-dsource), compared with the .expected
; files; they only run in the boot context, where the system compiler is the
; one on PATH.  The rejection tests compare the error message.  The end-to-end
; test compiles oxpp's binary output with the context's compiler: the system
; compiler in the boot context, OxCaml itself in the main context.  Refresh the
; .expected files with "dune promote".

(rule
 (alias runtest)
 (enabled_if
  (= %{context_name} "default"))
 (targets modes.pp.mli modes.mli.out)
 (deps modes.mli)
 (action
  (progn
   (with-stdout-to
    modes.pp.mli
    (run %{exe:../oxpp.exe} -context default modes.mli))
   (with-stderr-to
    modes.mli.out
    (run %{ocamlc} -dsource -stop-after parsing -intf modes.pp.mli))
   (diff modes.mli.expected modes.mli.out))))

(rule
 (alias runtest)
 (enabled_if
  (= %{context_name} "default"))
 (targets modes.pp.ml modes.ml.out)
 (deps modes.ml)
 (action
  (progn
   (with-stdout-to
    modes.pp.ml
    (run %{exe:../oxpp.exe} -context default modes.ml))
   (with-stderr-to
    modes.ml.out
    (run %{ocamlc} -dsource -stop-after parsing -impl modes.pp.ml))
   (diff modes.ml.expected modes.ml.out))))

