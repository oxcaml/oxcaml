(rule
 (targets Syntax.olean)
 (deps
  (sandbox preserve_file_kind)
  Syntax.lean)
 (action
  (run
   %{dep:../lean-with-flags}
   -R
   ..
   -o
   %{targets}
   %{dep:Syntax.lean})))

