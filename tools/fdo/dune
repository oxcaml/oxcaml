; The oxcaml-fdo-decode tool: decodes Linux perf LBR profiles of
; OxCaml-compiled executables with their FDO metadata.

(library
 (name fdo_decode_lib)
 (modes native)
 (flags
  (:standard -w +a-30-40-41-42))
 (libraries ocamlcommon compiler_owee unix)
 (modules perf_script fdo_metadata_decode elf_info))

(executable
 (name oxcaml_fdo_decode)
 (modes native)
 (flags
  (:standard -w +a-30-40-41-42))
 (libraries fdo_decode_lib ocamlcommon unix)
 (modules oxcaml_fdo_decode))

(install
 (files
  (oxcaml_fdo_decode.exe as oxcaml-fdo-decode))
 (section bin)
 (package ocaml))
