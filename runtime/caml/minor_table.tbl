#ifndef MINOR_TABLE_PREFIX
# define MINOR_TABLE_PREFIX
#endif

#ifndef MINOR_TABLE_FIELD
# define MINOR_TABLE_FIELD_DEFINED
# define MINOR_TABLE_FIELD(type, prefix, name) CAMLalign(8) type prefix##name;
#endif

#define MINOR_TABLE_FIELD_DELAY(type, prefix, name) \
  MINOR_TABLE_FIELD(type, prefix, name)

MINOR_TABLE_FIELD_DELAY(MINOR_TABLE_TYPE *, MINOR_TABLE_PREFIX, base)
MINOR_TABLE_FIELD_DELAY(MINOR_TABLE_TYPE *, MINOR_TABLE_PREFIX, end)
MINOR_TABLE_FIELD_DELAY(MINOR_TABLE_TYPE *, MINOR_TABLE_PREFIX, threshold)
MINOR_TABLE_FIELD_DELAY(MINOR_TABLE_TYPE *, MINOR_TABLE_PREFIX, ptr)
MINOR_TABLE_FIELD_DELAY(MINOR_TABLE_TYPE *, MINOR_TABLE_PREFIX, limit)
MINOR_TABLE_FIELD_DELAY(asize_t,            MINOR_TABLE_PREFIX, size)
MINOR_TABLE_FIELD_DELAY(asize_t,            MINOR_TABLE_PREFIX, reserve)

#undef MINOR_TABLE_FIELD_DELAY
#ifdef MINOR_TABLE_FIELD_DEFINED
# undef MINOR_TABLE_FIELD
# undef MINOR_TABLE_FIELD_DEFINED
#endif
#undef MINOR_TABLE_TYPE
#undef MINOR_TABLE_PREFIX
