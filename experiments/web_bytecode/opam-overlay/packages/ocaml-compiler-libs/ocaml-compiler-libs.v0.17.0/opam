opam-version: "2.0"
synopsis: "OCaml compiler libraries repackaged"
maintainer: "opensource@janestreet.com"
license: "MIT"
homepage: "https://github.com/janestreet/ocaml-compiler-libs"
depends: ["ocaml" {>= "5.2.0"} "dune" {>= "1.5.1"}]
build: [
  ["sh" "-ec" "python3 - <<'PY'\nfrom pathlib import Path\np = Path('src/read_cma/read_cma.ml')\ns = p.read_text()\ns = s.replace('let compunit_name Cmo_format.{ cu_name = Compunit name ; _ } = name', 'let compunit_name Cmo_format.{ cu_name; _ } = Compilation_unit.name_as_string cu_name')\np.write_text(s)\np = Path('src/gen/gen.ml')\ns = p.read_text()\ns = s.replace('List.iter units ~f:(fun u -> pr \"module %-*s = %s\" max_len u u);', 'List.iter units ~f:(fun u -> pr \"module %-*s = %s\" max_len u u);\\n  (* [Parsetree] is interface-only in OxCaml, so it is absent from the\\n     bytecode archive even though clients of [Ocaml_common] need it. *)\\n  pr \"module Parsetree = Parsetree\";')\np.write_text(s)\nPY"]
  ["dune" "build" "-p" name "-j" jobs]
]
