depends: ["dune" {>= "2.7"} "ocaml" {>= "4.08"}]
build: [
  ["sh" "-ec" "python3 - <<'PY'\nfrom pathlib import Path\np = Path('lib/write.ml')\ns = p.read_text()\nfor a,b in [('let write_intlit = Buffer.add_string','let write_intlit ob s = Buffer.add_string ob s'),('let write_floatlit = Buffer.add_string','let write_floatlit ob s = Buffer.add_string ob s'),('let write_stringlit = Buffer.add_string','let write_stringlit ob s = Buffer.add_string ob s')]: s=s.replace(a,b)\np.write_text(s)\nPY"]
  ["dune" "build" "-p" name "-j" jobs "@install"]
]
