; Upstream runs git describe from an OCaml-syntax dune file, which here would
; report OxCaml's release tags as the js_of_ocaml version. Record the OxCaml
; commit instead (empty outside a git checkout, e.g. in nix builds).

(rule
 (target GIT-VERSION)
 (deps
  (universe))
 (action
  (with-stdout-to
   %{target}
   (bash
    "v=$(git describe --always --dirty --exclude='*' 2>/dev/null) && echo ox-$v || true"))))
