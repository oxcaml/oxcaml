; Upstream computes this in an OCaml-syntax dune file, which needs an ocaml
; toplevel the OxCaml workspaces do not all provide. Record the OxCaml commit
; instead (empty outside a git checkout, e.g. in nix builds).

(rule
 (target GIT-VERSION)
 (deps
  (universe))
 (action
  (with-stdout-to
   %{target}
   (bash
    "v=$(git describe --always --dirty --exclude='*' 2>/dev/null) && echo ox-$v || true"))))
