(library
 (name js_of_ocaml_compiler)
 (public_name js_of_ocaml-compiler)
 (synopsis "Js_of_ocaml compiler library")
 (libraries
  ocaml-compiler-libs.common
  ocaml-compiler-libs.bytecomp
  menhirLib
  sedlex
  yojson)
 (flags
  (:standard -w -7-37 -safe-string))
 (preprocess
  (pps ppx_optcomp_light sedlex.ppx)))

(ocamllex annot_lexer)

; Definitions that differ between OxCaml and stock OCaml, as two source files
; rather than [@@if oxcaml] in one, so that the modules of this library the
; OxCaml compiler shares (middle_end/flambda2/to_jsir/jsoo_imports in the
; OxCaml repository) build without ppx_optcomp_light.

(rule
 (target ocaml_or_oxcaml.ml)
 (enabled_if %{oxcaml_supported})
 (action
  (copy ocaml_or_oxcaml.oxcaml.ml %{target})))

(rule
 (target ocaml_or_oxcaml.ml)
 (enabled_if
  (not %{oxcaml_supported}))
 (action
  (copy ocaml_or_oxcaml.ocaml.ml %{target})))

(menhir
 (modules js_parser)
 (flags
  --table
  --external-tokens
  Js_token
  --unused-token
  TAnnot
  --unused-token
  TComment
  --unused-token
  TCommentLineDirective
  --unused-token
  T_ERROR))

(menhir
 (modules annot_parser))

(rule
 (targets compiler_version.ml)
 (deps
  (:input-file ../../version.ml.in))
 (action
  (copy %{input-file} %{targets})))
