(executables
 (names jsoo_mkcmis jsoo_listunits)
 (public_names jsoo_mkcmis jsoo_listunits)
 ;; jsoo_mktop drives ocamlfind, which the compiler package doesn't have.
 (modules
  (:standard \ jsoo_mktop))
 (package js_of_ocaml-toplevel)
 (libraries
  js_of_ocaml-compiler
  js_of_ocaml-compiler.runtime-files
  (select
   jsoo_findlib.ml
   from
   ;; Without findlib, only .cmi/.cma arguments are supported.
   (js_of_ocaml-compiler.findlib-support -> jsoo_findlib.findlib.ml)
   (-> jsoo_findlib.stub.ml))))
