; Syntax errors reported by a driver built with the shipped ppxlib: explained
; by lrgrep when one of its rules matches, and as reported by the compiler's
; parser otherwise.

(executable
 (name driver)
 (modules driver)
 (libraries ppxlib))

; Without colors: under dune, in the Nix builder, the driver colors its errors
; even with a (setenv) in the action, so set OCAML_COLOR on its command line.

(rule
 (alias runtest)
 (action
  (progn
   (with-outputs-to
    explained.actual
    (with-accepted-exit-codes
     1
     (run env OCAML_COLOR=never ./%{dep:driver.exe} %{dep:explained.ml})))
   (diff explained.expected explained.actual)
   (with-outputs-to
    unexplained.actual
    (with-accepted-exit-codes
     1
     (run env OCAML_COLOR=never ./%{dep:driver.exe} %{dep:unexplained.ml})))
   (diff unexplained.expected unexplained.actual))))
