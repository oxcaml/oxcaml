; The standard library for ocamlopt -target js_of_ocaml: stdlib.cmjxa and the
; .cmjx files, installed next to the native ones. It is built by the installed
; compiler from the stdlib sources it ships, by rules generated by the same
; program as the native stdlib's, stdlib/dune_rules/gen.ml (see the comments
; there); it lives here rather than in the compiler's build because the
; compiler runs js_of_ocaml, which this workspace builds against the installed
; compiler. Only the generator, the module list and stdlib.ml's preprocessor
; come from the source tree (../stdlib).

(copy_files# ../stdlib/dune_rules/gen.ml)

(executable
 (name gen)
 (modules gen)
 (modes native))

; The module list of stdlib/StdlibModules, in the format of the
; build_settings.txt of the native build.

(rule
 (target build_settings.txt)
 (action
  (with-stdout-to
   %{target}
   (run
    make
    -s
    -f
    %{dep:../stdlib/StdlibModules}
    --eval
    "stdlib-modules: ; @echo stdlib_modules: $(STDLIB_MODULE_BASENAMES)"
    stdlib-modules))))

; src/ holds the sources, copied from the installed compiler.

(rule
 (target sources.dune)
 (action
  (with-stdout-to
   %{target}
   (run %{dep:gen.exe} %{dep:build_settings.txt} stdlib-js-sources))))

(subdir
 src
 (dynamic_include ../sources.dune))

(rule
 (target stdlib_module_deps.txt)
 (deps
  (:stdlib
   (glob_files src/*.ml)
   (glob_files src/*.mli)))
 (action
  (with-stdout-to
   %{target}
   (chdir
    src
    (run %{ocaml_bin}/ocamldep -one-line -as-map %{stdlib})))))

; build/ holds the compiled files.

(rule
 (target stdlib_js.dune)
 (action
  (with-stdout-to
   %{target}
   (run
    %{dep:gen.exe}
    %{dep:build_settings.txt}
    stdlib-js
    %{dep:stdlib_module_deps.txt}))))

(subdir
 build
 (dynamic_include ../stdlib_js.dune))

; Installed where ocamlopt looks for them, next to the native stdlib. The
; .cmjo files are not needed once in the library, except std_exit's.

(install
 (package stdlib-js)
 (section lib_root)
 (files
  (glob_files
   (build/*.cmjx with_prefix ocaml))
  (build/stdlib.cmjxa as ocaml/stdlib.cmjxa)
  (build/stdlib.cmja as ocaml/stdlib.cmja)
  (build/std_exit.cmjo as ocaml/std_exit.cmjo)))
