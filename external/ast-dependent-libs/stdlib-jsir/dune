; The standard library and the other libraries of the compiler distribution
; for JSIR. This lives here rather than in the compiler's build because the
; compiler in JSIR mode runs js_of_ocaml, which is not available when building
; the compiler.

(copy_files# ../stdlib/dune_rules/gen.ml)

(executable
 (name gen)
 (modules gen)
 (modes native))

(executable
 (name gen_jsir_lib)
 (modules gen_jsir_lib)
 (modes native))

(rule
 (target build_settings.txt)
 (action
  (with-stdout-to
   %{target}
   (run
    make
    -s
    -f
    %{dep:../stdlib/StdlibModules}
    --eval
    "stdlib-modules: ; @echo stdlib_modules: $(STDLIB_MODULE_BASENAMES)"
    stdlib-modules))))

(rule
 (target sources.dune)
 (action
  (with-stdout-to
   %{target}
   (run %{dep:gen.exe} %{dep:build_settings.txt} stdlib-jsir-sources))))

(subdir
 src
 (dynamic_include ../sources.dune))

(rule
 (target stdlib_module_deps.txt)
 (deps
  (:stdlib
   (glob_files src/*.ml)
   (glob_files src/*.mli)))
 (action
  (with-stdout-to
   %{target}
   (chdir
    src
    (run %{ocaml_bin}/ocamldep -one-line -as-map %{stdlib})))))

(rule
 (target stdlib_jsir.dune)
 (action
  (with-stdout-to
   %{target}
   (run
    %{dep:gen.exe}
    %{dep:build_settings.txt}
    stdlib-jsir
    %{dep:stdlib_module_deps.txt}))))

(subdir
 build
 (dynamic_include ../stdlib_jsir.dune))

(rule
 (target stdlib_upstream_compatible.dune)
 (deps
  (glob_files %{ocaml_where}/stdlib_upstream_compatible/*.ml)
  %{ocaml_where}/stdlib.cmxa
  %{ocaml_where}/stdlib_upstream_compatible/stdlib_upstream_compatible.cmxa)
 (action
  (with-stdout-to
   %{target}
   (run
    %{exe:gen_jsir_lib.exe}
    --ocaml-bin
    %{ocaml_bin}
    --ocaml-where
    %{ocaml_where}
    --name
    stdlib_upstream_compatible
    --cmxa
    %{ocaml_where}/stdlib_upstream_compatible/stdlib_upstream_compatible.cmxa
    --flags
    "-extension-universe upstream_compatible"))))

(rule
 (target stdlib_stable.dune)
 (deps
  (glob_files %{ocaml_where}/stdlib_stable/*.ml)
  %{ocaml_where}/stdlib.cmxa
  %{ocaml_where}/stdlib_stable/stdlib_stable.cmxa)
 (action
  (with-stdout-to
   %{target}
   (run
    %{exe:gen_jsir_lib.exe}
    --ocaml-bin
    %{ocaml_bin}
    --ocaml-where
    %{ocaml_where}
    --name
    stdlib_stable
    --cmxa
    %{ocaml_where}/stdlib_stable/stdlib_stable.cmxa))))

(rule
 (target stdlib_beta.dune)
 (deps
  (glob_files %{ocaml_where}/stdlib_beta/*.ml)
  %{ocaml_where}/stdlib.cmxa
  %{ocaml_where}/stdlib_beta/stdlib_beta.cmxa)
 (action
  (with-stdout-to
   %{target}
   (run
    %{exe:gen_jsir_lib.exe}
    --ocaml-bin
    %{ocaml_bin}
    --ocaml-where
    %{ocaml_where}
    --name
    stdlib_beta
    --cmxa
    %{ocaml_where}/stdlib_beta/stdlib_beta.cmxa
    --flags
    "-extension-universe beta -extension small_numbers_beta"))))

(rule
 (target stdlib_alpha.dune)
 (deps
  (glob_files %{ocaml_where}/stdlib_alpha/*.ml)
  %{ocaml_where}/stdlib.cmxa
  %{ocaml_where}/stdlib_alpha/stdlib_alpha.cmxa)
 (action
  (with-stdout-to
   %{target}
   (run
    %{exe:gen_jsir_lib.exe}
    --ocaml-bin
    %{ocaml_bin}
    --ocaml-where
    %{ocaml_where}
    --name
    stdlib_alpha
    --cmxa
    %{ocaml_where}/stdlib_alpha/stdlib_alpha.cmxa
    --flags
    "-extension-universe alpha"))))

(rule
 (target unix.dune)
 (deps
  (glob_files %{ocaml_where}/unix/*.ml)
  %{ocaml_where}/stdlib.cmxa
  %{ocaml_where}/unix/unix.cmxa)
 (action
  (with-stdout-to
   %{target}
   (run
    %{exe:gen_jsir_lib.exe}
    --ocaml-bin
    %{ocaml_bin}
    --ocaml-where
    %{ocaml_where}
    --name
    unix
    --cmxa
    %{ocaml_where}/unix/unix.cmxa
    --flags
    "-nolabels"))))

(rule
 (target str.dune)
 (deps
  (glob_files %{ocaml_where}/str/*.ml)
  %{ocaml_where}/stdlib.cmxa
  %{ocaml_where}/str/str.cmxa)
 (action
  (with-stdout-to
   %{target}
   (run
    %{exe:gen_jsir_lib.exe}
    --ocaml-bin
    %{ocaml_bin}
    --ocaml-where
    %{ocaml_where}
    --name
    str
    --cmxa
    %{ocaml_where}/str/str.cmxa))))

(rule
 (target ocamlcommon.dune)
 (deps
  (glob_files %{ocaml_where}/compiler-libs/*.ml)
  %{ocaml_where}/stdlib.cmxa
  %{ocaml_where}/compiler-libs/ocamlcommon.cmxa)
 (action
  (with-stdout-to
   %{target}
   (run
    %{exe:gen_jsir_lib.exe}
    --ocaml-bin
    %{ocaml_bin}
    --ocaml-where
    %{ocaml_where}
    --name
    ocamlcommon
    --cmxa
    %{ocaml_where}/compiler-libs/ocamlcommon.cmxa
    --flags
    "-w -67-47 -alert -unsafe_multidomain -alert -unsafe_effects"))))

(rule
 (target ocamlfrontend.dune)
 (deps
  (glob_files %{ocaml_where}/compiler-libs/*.ml)
  %{ocaml_where}/stdlib.cmxa
  %{ocaml_where}/compiler-libs/ocamlcommon.cmxa
  %{ocaml_where}/compiler-libs/ocamlfrontend.cmxa)
 (action
  (with-stdout-to
   %{target}
   (run
    %{exe:gen_jsir_lib.exe}
    --ocaml-bin
    %{ocaml_bin}
    --ocaml-where
    %{ocaml_where}
    --name
    ocamlfrontend
    --cmxa
    %{ocaml_where}/compiler-libs/ocamlfrontend.cmxa
    --flags
    "-w -67-47 -alert -unsafe_multidomain -alert -unsafe_effects"
    --dep
    .=%{ocaml_where}/compiler-libs/ocamlcommon.cmxa))))

(subdir
 build/stdlib_upstream_compatible
 (dynamic_include ../../stdlib_upstream_compatible.dune))

(subdir
 build/stdlib_stable
 (dynamic_include ../../stdlib_stable.dune))

(subdir
 build/stdlib_beta
 (dynamic_include ../../stdlib_beta.dune))

(subdir
 build/stdlib_alpha
 (dynamic_include ../../stdlib_alpha.dune))

(subdir
 build/unix
 (dynamic_include ../../unix.dune))

(subdir
 build/str
 (dynamic_include ../../str.dune))

(subdir
 build/compiler-libs
 (dynamic_include ../../ocamlcommon.dune)
 (dynamic_include ../../ocamlfrontend.dune))

(install
 (package stdlib-jsir)
 (section lib_root)
 (files
  (glob_files_rec
   (build/*.{cmjx,cmjxa,cmja} with_prefix ocaml))
  (build/std_exit.cmjo as ocaml/std_exit.cmjo)))
