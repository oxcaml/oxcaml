; The standard library and the other libraries of the compiler distribution
; for JSIR. This lives here rather than with the compiler's libraries because
; the compiler in JSIR mode runs js_of_ocaml or wasm_of_ocaml, so they can only
; be built once those are: against an installed compiler, or in the main
; context of the compiler's build, with the boot compiler and its standard
; library (see the top-level Makefile). wasm_of_ocaml runs the Binaryen tools
; (wasm-opt, wasm-merge), which must be in the PATH.
;
; Every stanza is disabled unless OXCAML_BUILD_STDLIB_JSIR=true, which the
; top-level Makefile sets for the builds that want this library: other builds
; of the compiler's workspace, such as its boot context or Merlin's, would
; otherwise generate these rules from the wrong standard library.
;
; The libraries other than the standard library are only built in the main
; context, from the sources and the native builds of the same libraries there.
; They are compiled with the optimisation flags of their native builds, which
; the main context puts in STDLIB_JSIR_OCAMLOPT_FLAGS (see Makefile.common-ox).

(copy_files#
 (enabled_if %{env:OXCAML_BUILD_STDLIB_JSIR=false})
 (files ../stdlib/dune_rules/gen.ml))

(executable
 (name gen)
 (enabled_if %{env:OXCAML_BUILD_STDLIB_JSIR=false})
 (modules gen)
 (modes native))

(executable
 (name gen_jsir_lib)
 (enabled_if
  (and
   %{env:OXCAML_BUILD_STDLIB_JSIR=false}
   (= %{context_name} main)))
 (modules gen_jsir_lib)
 (modes native))

(rule
 (target build_settings.txt)
 (enabled_if %{env:OXCAML_BUILD_STDLIB_JSIR=false})
 (action
  (with-stdout-to
   %{target}
   (run
    make
    -s
    -f
    %{dep:../stdlib/StdlibModules}
    -f
    %{dep:stdlib_modules.mk}
    stdlib-modules))))

(rule
 (target sources.dune)
 (enabled_if %{env:OXCAML_BUILD_STDLIB_JSIR=false})
 (action
  (with-stdout-to
   %{target}
   (run %{dep:gen.exe} %{dep:build_settings.txt} stdlib-jsir-sources))))

(rule
 (target sources.dune)
 (enabled_if
  (not %{env:OXCAML_BUILD_STDLIB_JSIR=false}))
 (action
  (write-file %{target} "")))

(subdir
 src
 (dynamic_include ../sources.dune))

(rule
 (target stdlib_module_deps.txt)
 (enabled_if %{env:OXCAML_BUILD_STDLIB_JSIR=false})
 (deps
  (:stdlib
   (glob_files src/*.ml)
   (glob_files src/*.mli)))
 (action
  (with-stdout-to
   %{target}
   (chdir
    src
    (run %{ocaml_bin}/ocamldep -one-line -as-map %{stdlib})))))

(rule
 (target stdlib_jsir.dune)
 (enabled_if %{env:OXCAML_BUILD_STDLIB_JSIR=false})
 (action
  (with-stdout-to
   %{target}
   (run
    %{dep:gen.exe}
    %{dep:build_settings.txt}
    stdlib-jsir
    %{dep:stdlib_module_deps.txt}))))

(rule
 (target stdlib_jsir.dune)
 (enabled_if
  (not %{env:OXCAML_BUILD_STDLIB_JSIR=false}))
 (action
  (write-file %{target} "")))

(subdir
 build
 (dynamic_include ../stdlib_jsir.dune))

(rule
 (target stdlib_upstream_compatible.dune)
 (enabled_if
  (and
   %{env:OXCAML_BUILD_STDLIB_JSIR=false}
   (= %{context_name} main)))
 (deps
  (glob_files %{workspace_root}/otherlibs/stdlib_upstream_compatible/*.ml)
  (glob_files
   %{workspace_root}/otherlibs/stdlib_upstream_compatible/*.ml-gen)
  %{workspace_root}/otherlibs/stdlib_upstream_compatible/stdlib_upstream_compatible.cmxa)
 (action
  (with-stdout-to
   %{target}
   (chdir
    %{workspace_root}
    (run
     %{exe:gen_jsir_lib.exe}
     --ocaml-bin
     %{ocaml_bin}
     --ocaml-where
     %{ocaml_where}
     --flags
     %{env:STDLIB_JSIR_OCAMLOPT_FLAGS=}
     --name
     stdlib_upstream_compatible
     --cmxa
     otherlibs/stdlib_upstream_compatible/stdlib_upstream_compatible.cmxa
     --cmi-dir
     otherlibs/stdlib_upstream_compatible/.stdlib_upstream_compatible.objs/byte
     ; keep in sync with otherlibs/stdlib_upstream_compatible/dune
     --flags
     "-extension-universe upstream_compatible")))))

