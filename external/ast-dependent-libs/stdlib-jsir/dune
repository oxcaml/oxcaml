 build/stdlib_alpha
 (dynamic_include ../../stdlib_alpha.dune))

(subdir
 build/unix
 (dynamic_include ../../unix.dune))

(subdir
 build/str
 (dynamic_include ../../str.dune))

(subdir
 build/compiler-libs
 (dynamic_include ../../ocamlcommon.dune)
 (dynamic_include ../../ocamlfrontend.dune))

(install
 (package stdlib-jsir)
 (enabled_if %{env:OXCAML_BUILD_STDLIB_JSIR=false})
 (section lib_root)
 (files
  (glob_files_rec
   (build/*.{cmjx,cmjxa,cmja} with_prefix ocaml))
  (build/std_exit.cmjo as ocaml/std_exit.cmjo)))

(install
 (package stdlib-wasm)
 (enabled_if %{env:OXCAML_BUILD_STDLIB_JSIR=false})
 (section lib_root)
 (files
  (glob_files_rec
   (build/*.{cmwx,cmwxa,cmwa} with_prefix ocaml))
  (build/std_exit.cmwo as ocaml/std_exit.cmwo)))
