(rule
 (target ocamlcommon.dune)
 (enabled_if
  (and
   %{env:OXCAML_BUILD_STDLIB_JSIR=false}
   (= %{context_name} main)))
 (deps
  (glob_files %{workspace_root}/*.ml)
  %{workspace_root}/ocamlcommon.cmxa)
 (action
  (with-stdout-to
   %{target}
   (chdir
    %{workspace_root}
    (run
     %{exe:gen_jsir_lib.exe}
     --ocaml-bin
     %{ocaml_bin}
     --ocaml-where
     %{ocaml_where}
     --flags
     %{env:STDLIB_JSIR_OCAMLOPT_FLAGS=}
     --name
     ocamlcommon
     --cmxa
     ocamlcommon.cmxa
     --cmi-dir
     .ocamlcommon.objs/byte
     ; keep in sync with the ocamlcommon library in the root dune file
     --flags
     "-w -67-47")))))

(rule
 (target ocamlfrontend.dune)
 (enabled_if
  (and
   %{env:OXCAML_BUILD_STDLIB_JSIR=false}
   (= %{context_name} main)))
 (deps
  (glob_files %{workspace_root}/*.ml)
  %{workspace_root}/ocamlfrontend.cmxa
  %{workspace_root}/ocamlcommon.cmxa)
 (action
  (with-stdout-to
   %{target}
   (chdir
    %{workspace_root}
    (run
     %{exe:gen_jsir_lib.exe}
     --ocaml-bin
     %{ocaml_bin}
     --ocaml-where
     %{ocaml_where}
     --flags
     %{env:STDLIB_JSIR_OCAMLOPT_FLAGS=}
     --name
     ocamlfrontend
     --cmxa
     ocamlfrontend.cmxa
     --cmi-dir
     .ocamlfrontend.objs/byte
     ; keep in sync with the ocamlfrontend library in the root dune file
     --flags
     "-w -47"
     --dep
     .=ocamlcommon.cmxa=.ocamlcommon.objs/byte)))))

(rule
 (targets
  stdlib_upstream_compatible.dune
  stdlib_stable.dune
  stdlib_beta.dune
  stdlib_alpha.dune
  unix.dune
  str.dune
  ocamlcommon.dune
  ocamlfrontend.dune)
 (enabled_if
  (not
   (and
    %{env:OXCAML_BUILD_STDLIB_JSIR=false}
    (= %{context_name} main))))
 (action
  (progn
   (write-file stdlib_upstream_compatible.dune "")
   (write-file stdlib_stable.dune "")
   (write-file stdlib_beta.dune "")
   (write-file stdlib_alpha.dune "")
   (write-file unix.dune "")
   (write-file str.dune "")
   (write-file ocamlcommon.dune "")
   (write-file ocamlfrontend.dune ""))))

