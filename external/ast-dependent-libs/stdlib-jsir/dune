; The standard library and the otherlibs compiled for ocamlopt -target
; js_of_ocaml. This lives here rather than in the compiler's build because the
; compiler in JSIR mode runs js_of_ocaml, which is not available when building
; the compiler.
;
; Each library is rebuilt from its sources against the .cmi files of the
; installed compiler, as gen_jsir.ml describes. To add one, list it below; it
; needs a flags.sexp next to its dune file (see otherlibs/unix/dune).

(copy_files# ../stdlib/dune_rules/stdlib_flags.ml)

(executable
 (name gen_jsir)
 (modules gen_jsir spec library objinfo emit stdlib_flags)
 (modes native))

; The installed archives and sources are read too; they change with the
; installed compiler, which every rule depends on.
(rule
 (targets libs.dune install.sexp)
 (deps
  %{ocamlopt}
  (:flags
   (glob_files_rec ../otherlibs/flags.sexp)))
 (action
  (with-stdout-to
   libs.dune
   (run
    %{dep:gen_jsir.exe}
    -ocaml-where
    %{ocaml_where}
    -ocamlobjinfo
    %{ocaml_bin}/ocamlobjinfo
    -install
    install.sexp
    %{flags}
    stdlib
    stdlib_upstream_compatible
    stdlib_stable
    stdlib_beta
    stdlib_alpha
    unix
    str))))

(subdir
 build
 (dynamic_include ../libs.dune))

(install
 (package stdlib-jsir)
 (section lib_root)
 (files
  (include install.sexp)))
