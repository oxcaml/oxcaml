; The standard library for JSIR. This lives here rather than with the
; compiler's standard library because the compiler in JSIR mode runs
; js_of_ocaml, so it can only be built once js_of_ocaml is: against an
; installed compiler, or in the main context of the compiler's build, with the
; boot compiler and its standard library (see the top-level Makefile).
;
; Every stanza is disabled unless OXCAML_BUILD_STDLIB_JSIR=true, which the
; top-level Makefile sets for the builds that want this library: other builds
; of the compiler's workspace, such as its boot context or Merlin's, would
; otherwise generate these rules from the wrong standard library.

(copy_files#
 (enabled_if %{env:OXCAML_BUILD_STDLIB_JSIR=false})
 (files ../stdlib/dune_rules/gen.ml))

(executable
 (name gen)
 (enabled_if %{env:OXCAML_BUILD_STDLIB_JSIR=false})
 (modules gen)
 (modes native))

(rule
 (target build_settings.txt)
 (enabled_if %{env:OXCAML_BUILD_STDLIB_JSIR=false})
 (action
  (with-stdout-to
   %{target}
   (run
    make
    -s
    -f
    %{dep:../stdlib/StdlibModules}
    -f
    %{dep:stdlib_modules.mk}
    stdlib-modules))))

(rule
 (target sources.dune)
 (enabled_if %{env:OXCAML_BUILD_STDLIB_JSIR=false})
 (action
  (with-stdout-to
   %{target}
   (run %{dep:gen.exe} %{dep:build_settings.txt} stdlib-jsir-sources))))

(rule
 (target sources.dune)
 (enabled_if
  (not %{env:OXCAML_BUILD_STDLIB_JSIR=false}))
 (action
  (write-file %{target} "")))

(subdir
 src
 (dynamic_include ../sources.dune))

(rule
 (target stdlib_module_deps.txt)
 (enabled_if %{env:OXCAML_BUILD_STDLIB_JSIR=false})
 (deps
  (:stdlib
   (glob_files src/*.ml)
   (glob_files src/*.mli)))
 (action
  (with-stdout-to
   %{target}
   (chdir
    src
    (run %{ocaml_bin}/ocamldep -one-line -as-map %{stdlib})))))

(rule
 (target stdlib_jsir.dune)
 (enabled_if %{env:OXCAML_BUILD_STDLIB_JSIR=false})
 (action
  (with-stdout-to
   %{target}
   (run
    %{dep:gen.exe}
    %{dep:build_settings.txt}
    stdlib-jsir
    %{dep:stdlib_module_deps.txt}))))

(rule
 (target stdlib_jsir.dune)
 (enabled_if
  (not %{env:OXCAML_BUILD_STDLIB_JSIR=false}))
 (action
  (write-file %{target} "")))

(subdir
 build
 (dynamic_include ../stdlib_jsir.dune))

(install
 (package stdlib-jsir)
 (enabled_if %{env:OXCAML_BUILD_STDLIB_JSIR=false})
 (section lib_root)
 (files
  (glob_files
   (build/*.cmjx with_prefix ocaml))
  (build/stdlib.cmjxa as ocaml/stdlib.cmjxa)
  (build/stdlib.cmja as ocaml/stdlib.cmja)
  (build/std_exit.cmjo as ocaml/std_exit.cmjo)))
