(library
 (name ppxlib)
 (public_name ppxlib)
 (libraries
  (re_export ppxlib_ast.ast)
  compiler-libs.common
  oxcaml_private_compiler_libs
  ppxlib_ast.astlib
  ppxlib_print_diff
  ppx_derivers
  ppxlib_jane
  ppxlib_ast.traverse_builtins
  ppxlib_ast.stdppx
  sexp_type
  oxcaml_private_lrgrep)
 (flags
  (:standard -safe-string -open Oxcaml_private_compiler_libs -open Ocaml_shadow))
 (ppx.driver
  (main Ppxlib.Driver.standalone)
  (flags
   (-corrected-suffix %{corrected-suffix} -diff-cmd - -dump-ast))
  (lint_flags
   (-corrected-suffix %{corrected-suffix} -diff-cmd - -null))))

(cinaps
 (files *.ml *.mli)
 (libraries ppxlib_cinaps_helpers))

(rule
 (targets ast_pattern_generated.ml)
 (deps gen/gen_ast_pattern.exe)
 (action
  (run ./gen/gen_ast_pattern.exe %{lib:ppxlib_ast.ast:ast.ml})))

(rule
 (targets ast_builder_generated.ml)
 (deps gen/gen_ast_builder.exe)
 (action
  (run ./gen/gen_ast_builder.exe %{lib:ppxlib_ast.ast:ast.ml})))

