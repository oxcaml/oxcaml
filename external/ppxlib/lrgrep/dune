; Explains syntax errors (see HACKING.jst.md). parse_errors.ml is generated by
; lrgrep, linked into oxcaml-private/ by the top-level Makefile, from the rules
; of parse_errors.mlyl and the grammar of the compiler. The generator always
; prints statistics on stderr: only show them if it fails.

(rule
 (target parser.cmly)
 (enabled_if
  (<> %{context_name} main))
 (action
  (copy %{ocaml_where}/compiler-libs/parser.cmly %{target})))

; In the main context of the OxCaml compiler's own build, the grammar it
; generates, which is only installed afterwards.
(rule
 (target parser.cmly)
 (enabled_if
  (= %{context_name} main))
 (action
  (copy %{workspace_root}/parser.cmly %{target})))

(rule
 (target parse_errors.ml)
 (deps
  (:rules parse_errors.mlyl)
  (:grammar parser.cmly)
  (:lrgrep ../oxcaml-private/lrgrep/src/main.exe))
 (action
  (system
   "log=$(%{lrgrep} %{rules} -g %{grammar} -o %{target} 2>&1) || { echo \"$log\" >&2; exit 1; }")))

(library
 (name oxcaml_private_lrgrep)
 (public_name ppxlib.private.lrgrep)
 (libraries compiler-libs.common oxcaml_private_lrgrep_runtime)
 (flags
  (:standard -open Oxcaml_private_lrgrep_runtime)))
