#
# Build rules common to ocaml-ox and oxcaml
#

# The directory of the makefiles: Makefile sets it, Makefile.ox does not.
ROOTDIR ?= .

ws_main   = --workspace=duneconf/main.ws

ifeq ($(coverage),yes)
  coverage_dune_flags=--instrument-with bisect_ppx
  ocaml_subdirs_to_ignore=otherlibs
else
  coverage_dune_flags=
  ocaml_subdirs_to_ignore=
endif

# The libraries of external/ast-dependent-libs, which the main context can
# build, use $ as an ordinary operator, which compilers configured with
# --enable-syntax-quotations reject by default. Settings before any "_" in
# OCAMLPARAM are defaults, which command-line flags override.
main_ocamlparam = syntax-quotations=0,_
ifneq ($(BUILD_OCAMLPARAM),)
main_ocamlparam = syntax-quotations=0,$(BUILD_OCAMLPARAM)
endif

# MAIN_CONTEXT_OCAMLPARAM: settings for the main context alone, after those
# of BUILD_OCAMLPARAM, which the codegen-variant contexts have too (see
# VARIANT_ENV_VARS). It is for measuring the build of the compiler
# (profile=1 and where to write the result, as
# tools/ci/actions/run-make-target.sh and scripts/profile-compiler-build.sh
# do): the variant contexts build the main context's libraries again,
# which such a measure must not count as well.
ifneq ($(MAIN_CONTEXT_OCAMLPARAM),)
main_ocamlparam := $(main_ocamlparam),$(MAIN_CONTEXT_OCAMLPARAM)
endif

# Also for the libraries of external/ast-dependent-libs, as js_of_ocaml and
# wasm_of_ocaml ship with the compiler.
ifeq ($(main_build_profile),dev)
main_ocamlopt_optimization_flags :=
else
main_ocamlopt_optimization_flags := -O3
endif

define dune_main_context
(lang dune 3.23)
(using oxcaml 0.1)
(context (default
  (name main)
  (profile $(main_build_profile))
  (cms_cmt_dependency cms)
  ; Findlib packages from outside the build are compiled by other compilers.
  (paths
    (PATH ("$(CURDIR)/_build/_bootinstall/bin" :standard))
    (OCAMLLIB ("$(CURDIR)/_build/default/stdlib/build"))
    (OCAMLPATH ("$(CURDIR)/_build/main/no-findlib-packages"))
    (OCAMLFIND_CONF ("/dev/null")))
  (env (_
    ; Not the toplevel of this build, which only runs once installed.
    (binaries (duneconf/ocaml as ocaml))
    ; For the tests of js_of_ocaml (see jsoo-test in Makefile), as its
    ; dune-workspace and with-effects profile set them up.
    (js_of_ocaml
     (compilation_mode separate)
     (flags (:standard -w no-missing-effects-backend))
     (link_flags (:standard -w no-missing-effects-backend))
     (runtest_alias runtest-js))
    (wasm_of_ocaml
     (enabled_if %{env:WASM_OF_OCAML=false})
     (compilation_mode separate)
     (flags (:standard --effects cps))
     (runtest_alias runtest-wasm))
    (bin_annot_cms true)
    ; The root project's profiles add -warn-error +A (see the root dune file):
    ; this environment also applies to the libraries of
    ; external/ast-dependent-libs.
    (flags (:standard -directory compiler-distro -alert -unsafe_multidomain -alert -unsafe_effects))
    ; We never want to build the compiler itself with AddressSanitizer enabled.
    (ocamlopt_flags (:standard $(main_ocamlopt_optimization_flags) -fno-asan))
    ; STDLIB_JSIR_OCAMLOPT_FLAGS: for the JSIR builds of the compiler's
    ; libraries (see external/ast-dependent-libs/stdlib-jsir/dune).
    (env-vars
      ("OCAMLPARAM" "$(main_ocamlparam)")
      ("STDLIB_JSIR_OCAMLOPT_FLAGS" "$(main_ocamlopt_optimization_flags)"))))))
endef

# Codegen-variant library builds. The variant trees we build and install
# are the NON-default variants named in $(CODEGEN_VARIANTS) (computed by
# configure); names are absolute (e.g. "fp" or "base"), agreeing with
# utils/codegen_variant_name.ml, stdlib/dune_rules/gen.ml and the runtime
# archive suffixes. Otherlibs for each variant are built in a dedicated
# dune context main-<name>, each in its own workspace file so that ordinary
# $(ws_main) builds never build anything there. Each context's OCAMLLIB
# points at the variant stdlib tree (stdlib/build_<name>, built in the boot
# context by @stdlib_<name>). The per-name flag tables live in
# Makefile.codegen-variants.
include $(ROOTDIR)/Makefile.codegen-variants

# Each variant context carries its per-axis settings BOTH as ocamlopt flags
# (env + duneconf/ocamlopt_flags_main-<name>.sexp) and through OCAMLPARAM.
# The latter is load-bearing: dune compiles the generated library alias
# modules (<lib>__.ml-gen) and runs custom rules that invoke %{ocamlopt}
# directly (e.g. dynlink.cmxa) without the configured ocamlopt_flags, and
# only OCAMLPARAM reaches those. ocamlc silently ignores the keys. A
# defined-but-empty BUILD_OCAMLPARAM must degrade to the "_" form: OCAMLPARAM
# values without a "_" separator are rejected and discarded wholesale, which
# would silently drop the axis settings.
# $(call VARIANT_ENV_VARS,<name>)
VARIANT_ENV_VARS = (env-vars ("OCAMLPARAM" "syntax-quotations=0,$(if $(BUILD_OCAMLPARAM),$(BUILD_OCAMLPARAM),_),$(call codegen_variant_ocamlparam,$(1))"))

# $(call dune_variant_context,<name>)
define dune_variant_context
(lang dune 3.23)
(using oxcaml 0.1)
(context (default
  (name main-$(1))
  (profile $(main_build_profile))
  (cms_cmt_dependency cms)
  (paths
    (PATH ("$(CURDIR)/_build/_bootinstall/bin" :standard))
    (OCAMLLIB ("$(CURDIR)/_build/default/stdlib/build_$(1)"))
    (OCAMLPATH ("$(CURDIR)/_build/main/no-findlib-packages"))
    (OCAMLFIND_CONF ("/dev/null")))
  (env (_
    (binaries (duneconf/ocaml as ocaml))
    (bin_annot_cms true)
    (flags (:standard -directory compiler-distro -alert -unsafe_multidomain -alert -unsafe_effects))
    (ocamlopt_flags (:standard $(main_ocamlopt_optimization_flags) -fno-asan $(call codegen_variant_ocamlopt_flags,$(1))))
    $(call VARIANT_ENV_VARS,$(1))))))
endef


.DEFAULT_GOAL := compiler
.PHONY: boot-compiler boot-runtest compiler runtest runtest-llvmize runtest-dwarf runtest-sancov

boot_targets = \
  $(boot_ocamlc) \
  $(boot_ocamlopt) \
  $(boot_ocamlmklib) \
  $(boot_ocamldep) \
  $(boot_ocamlobjinfo) \
  ocamltest/ocamltest.native

boot-compiler: _build/_bootinstall
	$(dune) build --always-show-command-line $(coverage_dune_flags) @merlin-support $(boot_targets) @runtime_all @stdlib

boot-runtest: boot-compiler
	$(dune) build $(coverage_dune_flags) --force $(runtest_targets)

# Codegen-variant artifacts (variant runtime archives, the variant stdlib
# trees and variant otherlibs) live outside the boot-compiler/main @install
# builds (alias hygiene: @runtime_all and @stdlib stay variant-free, and
# the variant otherlibs have their own dune contexts); `make compiler`
# builds them so that everything downstream (e.g. `make _install`) has
# them. @runtime_variants and each @stdlib_<name> are empty aliases when
# codegen variants are disabled or when the name is not in the configure-
# computed build list.
variant_boot_aliases = @runtime_variants \
  $(foreach n,$(codegen_variant_names),@stdlib_$(n))

compiler: boot-compiler
	$(dune) build $(coverage_dune_flags) $(variant_boot_aliases)
	SYSTEM=$(SYSTEM) MODEL=$(MODEL) \
          ASPP="$(ASPP)" ASPPFLAGS="$(ASPPFLAGS)" $(compiler_jsoo_env) \
          $(dune) build --always-show-command-line $(ws_main) \
          --promote-install-files=false ocaml.install $(compiler_jsoo_targets) \
          tools/regalloc/regalloc.exe \
          oxcaml/testsuite/tools/expect.exe \
          oxcaml/testsuite/tools/expectnat.exe \
          oxcaml/testsuite/tools/codegen_main.exe \
          oxcaml/testsuite/tools/asmgen_$(ARCH).o \
          testsuite/lib/lib.cm{,x}a \
          testsuite/lib/testing.cm{,x}a \
          @middle_end/flambda2/tests/tools/all \
          $(ocamldir)/tools/dumpobj.bc
ifneq ($(codegen_variant_names),)
	for name in $(codegen_variant_names); do \
	  $(dune) build --always-show-command-line \
	    --workspace=duneconf/main-$$name.ws \
	    @otherlibs/codegen-variant-libs || exit 1; \
	done
endif

.PHONY: minimize-failure
minimize-failure: boot-minimizer boot-compiler
	SYSTEM=$(SYSTEM) MODEL=$(MODEL) \
          ASPP="$(ASPP)" ASPPFLAGS="$(ASPPFLAGS)" \
          ./_build/default/chamelon/chamelon.exe dune build \
          $(ws_main) \
          ocaml.install \
          tools/regalloc/regalloc.exe \
          oxcaml/testsuite/tools/expect.exe \
          oxcaml/testsuite/tools/expectnat.exe \
          oxcaml/testsuite/tools/codegen_main.exe \
          oxcaml/testsuite/tools/asmgen_$(ARCH).o \
          testsuite/lib/lib.cm{,x}a \
          testsuite/lib/testing.cm{,x}a \
          $(ocamldir)/tools/dumpobj.bc

# We want to be able to build the @runtest dune alias, but exclude
# external/merlin from that (since Merlin only builds in the boot workspace).
# Dune doesn't offer a native way to do this, so instead we list all directories
# and build @runtest in each directory, excluding external/merlin and any
# directories not in the dune workspace. (We can exclude external/ as a whole
# since all the non-merlin directories in that folder are vendored anyways.)
runtest_targets := $(sort $(addprefix @, $(addsuffix runtest, $(filter-out autom4te.cache/ build-aux/ external/ _%, $(dir $(wildcard */.))))))

# CR dkalinichenko: [runtest] is built using the main profile,
# which uses the boot compiler. Use the final compiler for [runtest],
# and implement [runtest-upstream-boot] for testing when the final compiler
# itself is miscompiled.
# OXCAML_POLL_INSERTION carries the poll setting of the codegen variant
# the runtest context builds (the configure default), for tests that must
# gate on compiler-inserted polls (oxcaml/tests/simd/preemption256.ml).
runtest: compiler
	OXCAML_NAME_MANGLING=$(NAME_MANGLING_SCHEME) OXCAML_POLL_INSERTION=$(if $(call codegen_variant_has,$(CODEGEN_DEFAULT_VARIANT),poll),true,false) $(dune) build $(ws_main) $(runtest_targets)

runtest-llvmize: compiler
	OXCAML_NAME_MANGLING=$(NAME_MANGLING_SCHEME) $(dune) build @runtest-llvmize $(ws_main)

runtest-dwarf: compiler
	OXCAML_NAME_MANGLING=$(NAME_MANGLING_SCHEME) $(dune) build @runtest-dwarf $(ws_main)

runtest-sancov: compiler
	$(dune) build @runtest-sancov $(ws_main)

# This Makefile supports old versions that don't have $(file), so we're using
# environment var trickery to get a multiline string into a file
duneconf/main.ws: export contents = $(dune_main_context)
$(foreach n,$(codegen_variant_names),$(eval duneconf/main-$(n).ws: export contents = $$(call dune_variant_context,$(n))))
duneconf/%.ws: Makefile.common-ox $(ROOTDIR)/Makefile.codegen-variants
	echo "$$contents" > $@

# We need to disable ocaml/otherlibs when compiling with coverage, because we
# need to compile against the user's opam instead. Unfortunately, Dune gives us
# no nicer way of declaring data_only_dirs differently in different workspaces,
# so we have to output a file to be included in ocaml/dune.
#
# Also, Dune only allows one (data_only_dirs) declaration per file, so here we
# have to account for the declaration that would already have been in
# ocaml/dune.
$(ocamldir)/duneconf/dirs-to-ignore.inc:
	echo "(data_only_dirs yacc $(ocaml_subdirs_to_ignore))" > $@

# The toplevel that runs build scripts in the main context, as %{ocaml} or
# ocaml: the system one, which must not see the stdlib of this build.
duneconf/ocaml: Makefile.common-ox
	printf '#!/bin/sh\nexec env -u OCAMLLIB -u OCAMLPARAM "%s" "$$@"\n' \
	  "`$(opam_exec) which ocaml`" > $@
	chmod +x $@

# Targets that should be prerequisites to any target that runs Dune
dune_config_targets = \
  duneconf/main.ws \
  duneconf/ocaml \
  $(ocamldir)/duneconf/dirs-to-ignore.inc \
  $(ocamldir)/duneconf/ox-extra.inc \
  dune-project

dune_config_targets += \
  $(foreach n,$(codegen_variant_names),duneconf/main-$(n).ws)

_build/_bootinstall: Makefile.config Makefile.common-ox \
  $(ROOTDIR)/Makefile.codegen-variants $(dune_config_targets)
	echo -n '$(NATDYNLINKOPTS)' > $(ocamldir)/natdynlinkops

# flags.sexp
# Do not include :standard as it is ignored
# See: https://github.com/ocaml/dune/issues/13225
	echo '($(if $(filter true,$(FUNCTION_SECTIONS)),-function-sections,))' > ocamlopt_upstream_flags.sexp
	echo '($(OXCAML_DWARF_FLAGS_FOR_COMPILER) $(ASSEMBLY_FLAG_FOR_COMPILER) $(if $(filter true,$(FUNCTION_SECTIONS)),-function-sections,))' > ocamlopt_oxcaml_flags.sexp
	$(foreach n,$(codegen_variant_names),echo '($(OXCAML_DWARF_FLAGS_FOR_COMPILER) $(ASSEMBLY_FLAG_FOR_COMPILER) $(if $(filter true,$(FUNCTION_SECTIONS)),-function-sections,) $(call codegen_variant_ocamlopt_flags,$(n)))' > duneconf/ocamlopt_flags_main-$(n).sexp; )

# Per-context host-variant constants modules for otherlibs/dynlink (see the
# dynlink_host_variant rule there): the default variant's values for the
# default and main contexts, each variant's values for its main-<name>
# context.
	echo '$(call codegen_variant_dynlink_consts,$(CODEGEN_DEFAULT_VARIANT))' > duneconf/dynlink_host_variant_default.ml
	cp duneconf/dynlink_host_variant_default.ml duneconf/dynlink_host_variant_main.ml
	$(foreach n,$(codegen_variant_names),echo '$(call codegen_variant_dynlink_consts,$(n))' > duneconf/dynlink_host_variant_main-$(n).ml; )
	{ for flag in $(OXCAML_DWARF_FLAGS_FOR_COMPILER) $(ASSEMBLY_FLAG_FOR_COMPILER) $(if $(filter true,$(FUNCTION_SECTIONS)),-function-sections,); do \
	    echo "$$flag"; \
	  done > ocamlopt_stdlib_flags.txt; }
	echo '( )' > boot_oc_cflags.sexp
	echo '( $(OC_CFLAGS) )' > oc_cflags.sexp
	echo '( $(subst -I $(ROOTDIR)/,-I $(CURDIR)/,$(OC_CPPFLAGS)) )' > oc_cppflags.sexp
	echo '( $(SHAREDLIB_CFLAGS) )' > sharedlib_cflags.sexp

# _build/_bootinstall: a minimal install directory for the boot compiler,
# which is placed on PATH for subsequent builds
	rm -rf _build/_bootinstall
	mkdir -p _build/_bootinstall/{bin,lib/ocaml}
	cp $^ _build/_bootinstall/lib/ocaml
	ln -sf ../../default/runtime/ocamlrun _build/_bootinstall/bin/ocamlrun
	ln -sf ../../default/$(boot_ocamlopt) _build/_bootinstall/bin/ocamlopt.opt
	ln -sf ../../default/$(boot_ocamlc) _build/_bootinstall/bin/ocamlc.opt
	ln -sf ../../default/$(boot_ocamlmklib) _build/_bootinstall/bin/ocamlmklib.opt
	ln -sf ../../default/$(boot_ocamldep) _build/_bootinstall/bin/ocamldep.opt
	ln -sf ../../default/$(boot_ocamlobjinfo) _build/_bootinstall/bin/ocamlobjinfo.opt
	ln -sf "`$(opam_exec) which ocamllex`" _build/_bootinstall/bin/ocamllex.opt
	cp duneconf/ocaml _build/_bootinstall/bin/ocaml
	for prog in ocamlopt ocamlc ocamllex ocamldep ocamlmklib; do \
	  ln -sf "$$prog.opt" "_build/_bootinstall/bin/$$prog"; \
	done

# save a bit of disk space in build trees by using cp -l on Linux
# (not available on e.g. OS X)
cpl=$(if $(filter linux,$(SYSTEM)),cp -l,cp -L)

# Assemble the contents of the install directory in _install
# This is needed to run the upstream testsuite (see runtest-upstream below)
# We use a local directory rather than the final install path, since
# the final install path may be on a different filesystem (and hence be
# slow and/or unable to make hardlinks)
.PHONY: _install install install_for_opam
_install: compiler
	rm -rf _install
	mkdir -p _install/{bin,lib/ocaml}
	$(cpl) _build/default/runtime/ocamlrun{,d} _install/bin/
# Only the executables of the ocaml package, as listed in ocaml.install: the
# main build can also build those of js_of_ocaml (see WITH_JSOO in Makefile).
	$(cpl) `grep -o '"_build/install/main/bin/[^"]*"' _build/main/ocaml.install \
	  | tr -d '"'` _install/bin/
	( cd _install/bin; for i in *.opt; do ln -s $$i $${i%.opt}; done )
	$(cpl) -R _build/default/stdlib/build/* _install/lib/ocaml/
	rm -f _install/lib/ocaml/{META,dune-package,dynlink.cmxa,dynlink/dynlink.cmxa}
	rm -f _install/lib/ocaml/{stdlib,camlinternal}*.{o,cmo}
	$(cpl) -R _build/install/main/lib/ocaml/* _install/lib/ocaml/
	if [ "x$(legacy_layout)" == "xyes" ] ; \
	then \
          for libdir in unix str dynlink bigarray ; do \
	    mv _install/lib/ocaml/$${libdir}/* _install/lib/ocaml/ ; \
            rmdir _install/lib/ocaml/$${libdir} ; \
          done \
	fi
	rm -f _install/lib/ocaml/{META,dune-package}
	rm -f _install/lib/ocaml/compiler-libs/*.cmo
	$(cpl) {_build/install/main,_install}/lib/ocaml/compiler-libs/topstart.cmo
	for file in $(toplevels_installed); do \
	  cp -f _install/lib/ocaml/compiler-libs/$${file}dirs.{cmi,mli,cmt,cmti} _install/lib/ocaml; \
	done
	mkdir _install/lib/stublibs
	cp _build/main/parser.cmly _install/lib/ocaml/compiler-libs/
ifneq ($(codegen_variant_names),)
# Assemble the codegen-variant library trees: one COMPLETE stdlib root at
# lib/ocaml/variants/<name> per built variant, mirroring the base root's
# shape, so a compile/link for a non-default codegen variant can use it
# wholesale via -I / as a remapped stdlib root. Rebuilt per variant:
# native stdlib and otherlibs artifacts (.cmx/.cmxa/.a/.cmxs/std_exit) and
# the variant runtime archives (suffixed by the name's projection onto the
# runtime axes). Copied from the base root because they are codegen-
# variant-agnostic: .cmi/.cmt*/.cms*, byte artifacts (.cma/.cmo, byte
# runtime archives), C stub archives and stublibs (built
# once with -fno-omit-frame-pointer, see configure.ac), ld.conf,
# Makefile.config, runtime-launch-info, expunge and the toplevel support
# files. The caml/ headers are copied too, except that each variant's
# caml/m.h gets a prefix naming that variant, so that C code compiled
# against the tree's headers without -DCAML_CODEGEN_VARIANT_EXPLICIT sees
# the tree's axis macros instead of the configure default's.
# Deliberately absent: findlib META files, and the compiler-libs/
# eval/ocaml-jit universe (eval and metaprogramming are unsupported under
# non-default codegen variants). A final check asserts that the assembled
# variants/ directory agrees with the configure-computed list (what
# `ocamlopt -config-var codegen_variants` will report).
	rm -rf _install/lib/ocaml/variants
	set -e; \
	for name in $(codegen_variant_names); do \
	  mkdir -p _install/lib/ocaml/variants/$$name; \
	  $(cpl) -R _build/default/stdlib/build_$$name/* \
	    _install/lib/ocaml/variants/$$name/; \
	  (set -e; \
	   cd _install/lib/ocaml; \
	   vroot=variants/$$name; \
	   rm -f $$vroot/dynlink/dynlink.cmxa; \
	   rm -f $$vroot/{stdlib,camlinternal}*.{o,cmo}; \
	   cp -f caml/* $$vroot/caml/; \
	   rm -f $$vroot/caml/m.h; \
	   { echo "/* Added at install time: these headers describe codegen"; \
	     echo "   variant $$name unless CAML_CODEGEN_VARIANT_EXPLICIT is"; \
	     echo "   defined on the command line. */"; \
	     echo '#ifndef CAML_CODEGEN_VARIANT_EXPLICIT'; \
	     echo '#define CAML_CODEGEN_VARIANT_EXPLICIT 1'; \
	     case "-$$name-" in *-fp-*) \
	       echo '#define WITH_FRAME_POINTERS 1';; esac; \
	     case "-$$name-" in *-sc-*) \
	       echo '#define STACK_CHECKS_ENABLED 1';; esac; \
	     echo '#endif'; \
	     cat caml/m.h; } > $$vroot/caml/m.h; \
	   cp -R stublibs $$vroot/; \
	   cp lib*_stubs*.a expunge $$vroot/; \
	   cp {top,opttop}dirs.{cmi,mli,cmt,cmti} $$vroot/; \
	   for libdir in unix str threads runtime_events dynlink stdlib_stable \
	     stdlib_beta stdlib_alpha stdlib_upstream_compatible ; do \
	     cp -R $$libdir $$vroot/ ; \
	   done); \
	  vroot=_install/lib/ocaml/variants/$$name; \
	  vb=_build/main-$$name/otherlibs; \
	  cpv() { rm -f "$$1/$$3"; cp "$$2" "$$1/$$3"; }; \
	  for f in unix.cmxa unix.a unix.cmxs ; do \
	    cpv $$vroot/unix $$vb/unix/$$f $$f; \
	  done; \
	  for m in unix unixLabels ; do \
	    cpv $$vroot/unix $$vb/unix/.unix.objs/native/$$m.cmx $$m.cmx; \
	  done; \
	  for f in str.cmxa str.a str.cmxs ; do \
	    cpv $$vroot/str $$vb/str/$$f $$f; \
	  done; \
	  cpv $$vroot/str $$vb/str/.str.objs/native/str.cmx str.cmx; \
	  for f in runtime_events.cmxa runtime_events.a runtime_events.cmxs ; do \
	    cpv $$vroot/runtime_events $$vb/runtime_events/$$f $$f; \
	  done; \
	  cpv $$vroot/runtime_events \
	    $$vb/runtime_events/.runtime_events.objs/native/runtime_events.cmx \
	    runtime_events.cmx; \
	  cpv $$vroot/threads $$vb/systhreads/native/threadsnat.cmxa threads.cmxa; \
	  cpv $$vroot/threads $$vb/systhreads/native/threadsnat.a threads.a; \
	  for m in event thread multicore ; do \
	    cpv $$vroot/threads \
	      $$vb/systhreads/native/.threadsnat.objs/native/$$m.cmx $$m.cmx; \
	  done; \
	  cpv $$vroot/dynlink $$vb/dynlink/dynlink.cmxa dynlink.cmxa; \
	  cpv $$vroot/dynlink $$vb/dynlink/dynlink.a dynlink.a; \
	  cpv $$vroot/dynlink \
	    $$vb/dynlink/.dynlink_internal.objs/native/dynlink.cmx dynlink.cmx; \
	  for m in dynlink_common dynlink_platform_intf dynlink_types ; do \
	    cpv $$vroot/dynlink \
	      $$vb/dynlink/.dynlink_internal_common.objs/native/$$m.cmx $$m.cmx; \
	  done; \
	  for m in dynlink_internal_byte dynlink_internal_native ; do \
	    cpv $$vroot/dynlink \
	      $$vb/dynlink/.$$m.objs/native/$$m.cmx $$m.cmx; \
	  done; \
	  cpv $$vroot/dynlink \
	    $$vb/dynlink/.dynlink_internal_native.objs/native/dynlink_host_variant.cmx \
	    dynlink_host_variant.cmx; \
	  for m in Axis_lattice Ldd_intf Ldd Misc ; do \
	    cpv $$vroot \
	      $$vb/dynlink/.dynlink_compilerlibs.objs/native/dynlink_compilerlibs__$$m.cmx \
	      dynlink_compilerlibs__$$m.cmx; \
	  done; \
	  for u in stdlib_stable stdlib_beta stdlib_alpha \
	    stdlib_upstream_compatible ; do \
	    cpv $$vroot/$$u $$vb/$$u/$$u.cmxa $$u.cmxa; \
	    cpv $$vroot/$$u $$vb/$$u/$$u.a $$u.a; \
	    cpv $$vroot/$$u $$vb/$$u/$$u.cmxs $$u.cmxs; \
	    rm -f $$vroot/$$u/*.cmx; \
	    cp $$vb/$$u/.$$u.objs/native/*.cmx $$vroot/$$u/; \
	  done; \
	  find $$vroot -name META -delete; \
	  find $$vroot -type d -empty -delete; \
	done
	@installed=`ls _install/lib/ocaml/variants | sort | tr '\n' ' '`; \
	configured=`for n in $(codegen_variant_names); do echo $$n; done \
	  | sort | tr '\n' ' '`; \
	if [ "$$installed" != "$$configured" ]; then \
	  echo "error: installed codegen variants [$$installed] disagree with" \
	    "the configured list [$$configured]"; \
	  exit 1; \
	fi
endif


# Copy _install to the final install directory, $(DESTDIR)$(prefix), unless
# that is _install itself, as with the development prefix: nothing is
# compared or copied then. The files are compared by their contents
# (--checksum): going by size and modification time, rsync would keep a
# file of the destination that only looks like this installation's, which
# files whose times were normalized do.
# A prefix that already holds an installation keeps the files that this one
# does not have, with two exceptions.
# - Under lib/ocaml/variants: the compiler offers every codegen-variant
#   tree that it finds there (see installed_codegen_variants in
#   utils/config.common.ml.in), so it would compile and link against a tree
#   that an earlier installation left behind. The second rsync only
#   deletes: it creates no file and updates none.
# - The cached generic functions of the default library root
#   (-use-cached-generic-functions), which are generated in the installed
#   tree by the compiler that was installed there: this installation's
#   default variant need not be that one's, and a link would take the
#   archive as it is.
define copy_install_to_prefix
	mkdir -p $(install_destination)
	set -e; \
	if ! [ _install -ef $(install_destination) ]; then \
	  rsync --chmod=u+rw,go+r -rl --checksum _install/ \
	    $(install_destination); \
	  if [ -d _install/lib/ocaml/variants ]; then \
	    rsync -rl --delete --existing --ignore-existing \
	      _install/lib/ocaml/variants/ \
	      $(install_destination)/lib/ocaml/variants; \
	  else \
	    rm -rf $(install_destination)/lib/ocaml/variants; \
	  fi; \
	  [ -e _install/lib/ocaml/cached-generic-functions.a ] || rm -f \
	    $(install_destination)/lib/ocaml/cached-generic-functions.a; \
	fi
endef

# The destination as one word of a shell command: between single quotes,
# with those of the name itself escaped, so that it may have spaces and
# quotes. A `$` in DESTDIR or prefix is make's, as in any variable of make:
# `$$` stands for the character.
install_destination = '$(subst ','\'',$(DESTDIR)$(prefix))'

install: _install
	$(copy_install_to_prefix)

# Same as above, but relies on a successfull earlier _install
install_for_opam:
	$(copy_install_to_prefix)

main_prefix = _build/install/main
main_build = _build/main
boot_build = _build/default

# The following horror will be removed when work to allow the testsuite to
# run on an installed tree (led by David Allsopp) is completed.
.PHONY: runtest-upstream test install_for_test
install_for_test: install
ifeq ($(with_jsir),true)
	@for program in js_of_ocaml wasm_of_ocaml; do \
	  test -x _install/bin/$$program || { \
	    echo "error: with_jsir=true but _install/bin/$$program is missing;" \
	      "make test needs jsoo-install-shipped to install into" \
	      "$(CURDIR)/_install (OXCAML_INSTALL and AST_DEPENDENT_LIBS_PREFIX)," \
	      "or use make test-without-jsir" >&2; \
	    exit 1; }; \
	done
	@for package in stdlib-jsir:cmxa-js stdlib-wasm:cmxa-wasm; do \
	  test -f _install/lib/ocaml/stdlib.$${package#*:} || { \
	    echo "error: with_jsir=true but _install/lib/ocaml/stdlib.$${package#*:}" \
	      "is missing (the $${package%:*} package was not installed)" >&2; \
	    exit 1; }; \
	done
	@for program in wasm-opt wasm-merge; do \
	  command -v $$program > /dev/null || { \
	    echo "error: with_jsir=true but $$program is not in PATH;" \
	      "wasm_of_ocaml runs the Binaryen tools" >&2; \
	    exit 1; }; \
	done
	@command -v "$${NODE:-node}" > /dev/null || { \
	  echo "error: with_jsir=true but $${NODE:-node} is not in PATH;" \
	    "ocamltest runs JSIR programs with \$$NODE (default: node)" >&2; \
	  exit 1; }
endif
	rm -rf _runtest
	mkdir _runtest
	ln -s ../_install _runtest/_install
	# Use rsync to ensure hardlinks are created on both Linux and macOS
	rsync --link-dest=../../$(ocamldir)/testsuite/ -a $(ocamldir)/testsuite/ _runtest/testsuite/
	 # replace backend-specific testsuite/tools with their new versions
	rm -f _runtest/testsuite/tools/*
	cp -a oxcaml/testsuite/tools/* _runtest/testsuite/tools/
	cp $(main_build)/oxcaml/testsuite/tools/expect.exe _runtest/testsuite/tools/expect
	chmod 755 _runtest/testsuite/tools/expect
	cp $(main_build)/middle_end/flambda2/tests/tools/fexprc.exe _runtest/testsuite/tools/fexprc
	chmod 755 _runtest/testsuite/tools/fexprc
	cp $(main_build)/oxcaml/testsuite/tools/expectnat.exe _runtest/testsuite/tools/expectnat
	chmod 755 _runtest/testsuite/tools/expectnat
	cp $(main_build)/oxcaml/testsuite/tools/codegen_main.exe \
          _runtest/testsuite/tools/codegen
	chmod 755 _runtest/testsuite/tools/codegen
	cp $(main_build)/oxcaml/testsuite/tools/asmgen_*.o \
          _runtest/testsuite/tools/
	cp $(main_build)/testsuite/lib/lib.{a,cmxa,cma} \
          _runtest/testsuite/lib/
	cp $(main_build)/testsuite/lib/.lib.objs/byte/lib.cm* \
          _runtest/testsuite/lib/
	cp $(main_build)/testsuite/lib/.lib.objs/native/lib.cm* \
          _runtest/testsuite/lib/
	cp $(main_build)/testsuite/lib/testing.{a,cmxa,cma} \
          _runtest/testsuite/lib/
	cp $(main_build)/testsuite/lib/.testing.objs/byte/testing.cm* \
          _runtest/testsuite/lib/
	cp $(main_build)/testsuite/lib/.testing.objs/native/testing.cm* \
          _runtest/testsuite/lib/

	cp $(ocamldir)/Makefile.* _runtest/

#	Create an OCaml directory laid out like the testsuite expects,
#	by copying and symlinking in bits from the install/build directory
	(cd _runtest; \
	 for exe in _install/bin/*; do ln -s $$exe; done; \
         ln -s . boot; \
	 for exe in ocamlc ocamlopt ocamllex; do \
	   rm -f $$exe; ln -s $$exe.byte $$exe; \
         touch ocamlc.opt ocamlopt.opt; \
	 done; \
	 ln -s _install/lib/ocaml stdlib; \
	 mkdir runtime; \
	 for f in ocamlrun* stdlib/caml stdlib/stublibs/* runtime/caml/threads.h; do \
	   ln -s ../$$f runtime/`basename $$f`; \
	 done; \
	 ln -s . lex; ln -s . yacc; \
	 ln -s _install/lib/ocaml/compiler-libs compilerlibs; \
	 mkdir -p otherlibs/{unix,dynlink/native,str,bigarray,runtime_events,eval}; \
	 ln -s ../stdlib/threads otherlibs/systhreads; \
         $(cpl) stdlib/unix/{lib,}unix* otherlibs/unix; \
         $(cpl) stdlib/dynlink/dynlink* otherlibs/dynlink; \
         $(cpl) stdlib/str/{lib,}str* otherlibs/str; \
         $(cpl) stdlib/{lib,}eval* otherlibs/eval; \
	 for universe in upstream_compatible stable beta alpha ; do \
		mkdir -p otherlibs/{stdlib_,}$${universe}; \
		$(cpl) stdlib/stdlib_$${universe}/* otherlibs/stdlib_$${universe}; \
	 done; \
	 $(cpl) stdlib/runtime_events/{lib,}runtime_events* otherlibs/runtime_events; \
	 ln -s ../_build/main/$(ocamldir)/toplevel/byte/.ocamltoplevel.objs/byte toplevel; \
	)

	# Various directories are put on the -I paths by tools/Makefile;
	# utils/ is one such, so we just dump the .cm* files in there for
	# various things.
	mkdir _runtest/utils
	cp _install/lib/ocaml/compiler-libs/*.{cmi,cmx} _runtest/utils
	cp $(main_build)/$(ocamldir)/.ocamlfrontend.objs/byte/*.cmo _runtest/utils
	cp $(main_build)/$(ocamldir)/.ocamlcommon.objs/byte/*.cmo _runtest/utils
	rm -f _runtest/utils/{topdirs,opttopdirs}.cmi
	cp _install/lib/ocaml/*.{cmi,cma,a,cmxa} _runtest/utils
	cp _install/lib/ocaml/{unix,str,dynlink}/*.{cmi,cma,a,cmxa} _runtest/utils
	cp $(main_build)/$(ocamldir)/.ocamlcommon.objs/native/config.o _runtest/utils
	# Needed for tests/warnings
	cp $(ocamldir)/utils/warnings.ml _runtest/utils
	# Suppress linker errors about -I directories not existing.
	for dir in asmcomp bytecomp driver file_formats lambda middle_end \
	  parsing typing; do ln -s utils _runtest/$$dir; done
	# stublibs
	mkdir -p _runtest/lib/ocaml/stublibs/
	cp $(main_prefix)/lib/ocaml/stublibs/*.so _runtest/lib/ocaml/stublibs
	# ocamldebug
	mkdir _runtest/debugger
	ln -s ../ocamldebug _runtest/debugger
	cp $(main_build)/$(ocamldir)/debugger/.ocamldebug.objs/byte/*.cm* \
	  _runtest/debugger
	# The ast_invariants test needs VERSION to be present.  In fact ideally
	# we should have all the source files in _runtest too for this test,
	# but for the moment we accept it being a weaker check.  We're not
	# working on parts of the compiler that deal with the AST anyway in
	# this repo.
	touch _runtest/VERSION
	# tools
	mkdir _runtest/tools
	ln -s ../_install/bin/ocamlmklib.byte _runtest/tools/ocamlmklib
	ln -s ../_install/bin/ocamlobjinfo.byte _runtest/tools/ocamlobjinfo
	ln -s ../_install/bin/dumpobj.byte _runtest/tools/dumpobj
	ln -s ../_install/bin/ocamlfilt _runtest/tools/ocamlfilt
        # ocamldoc
	# rm _runtest/ocamldoc
	# mkdir _runtest/ocamldoc
	# ln -s ../../_install/bin/ocamldoc.byte _runtest/ocamldoc/ocamldoc
	# cp $(main_build)/$(ocamldir)/ocamldoc/.odoc_lib.objs/byte/*.cm* _runtest/ocamldoc
	# ocamltest itself
	mkdir _runtest/ocamltest
	cp $(boot_build)/ocamltest/ocamltest.native _runtest/ocamltest/ocamltest
ifeq ($(with_jsir),true)
	cd _runtest/testsuite/lib && \
	  export OXCAML_JS_OF_OCAML=$(CURDIR)/_install/bin/js_of_ocaml && \
	  export OXCAML_WASM_OF_OCAML=$(CURDIR)/_install/bin/wasm_of_ocaml && \
	  for target in js_of_ocaml:js wasm_of_ocaml:wasm; do \
	    ocamlopt_jsir="../../ocamlopt.opt -target $${target%:*} -nostdlib \
	      -I ../../stdlib" && \
	    $$ocamlopt_jsir -S -c lib.ml && \
	    $$ocamlopt_jsir -S -linkall -a -o testing.cmxa-$${target#*:} testing.ml && \
	    $$ocamlopt_jsir -link-jsir -linkall -a \
	      -o testing.cmxa-$${target#*:} testing.cmx-$${target#*:} \
	      || exit 1; \
	  done
	cp _install/lib/ocaml/compiler-libs/*.cmx-js \
	  _install/lib/ocaml/compiler-libs/*.cmx-wasm _runtest/utils
	cp $(stdlib_jsir_build)/compiler-libs/*.cmo-js \
	  $(stdlib_jsir_build)/compiler-libs/*.cmo-wasm \
	  $(stdlib_jsir_build)/compiler-libs/*.cm-jsir-js \
	  $(stdlib_jsir_build)/compiler-libs/*.cm-jsir-wasm _runtest/utils
endif
test: install_for_test
	if [ "$(middle_end)" = "flambda2" ]; then \
	  for path in `cd testsuite; ls -1 -d tests/*`; do \
	    if [[ -d "testsuite/$$path" ]] && ! grep -q "^  $$path " oxcaml/testsuite/flambda2-test-list; then \
	      echo "  $$path"; \
	    fi; \
	  done > _runtest/flambda2-test-list; \
	fi
	(export OCAMLSRCDIR=$$(pwd)/_runtest; \
	 export CAML_LD_LIBRARY_PATH=$$(pwd)/_runtest/lib/ocaml/stublibs; \
	 if $$(which gfortran > /dev/null 2>&1); then \
	   export LIBRARY_PATH=$$(dirname $$(gfortran -print-file-name=libgfortran.a)); \
	 fi; \
	 cd _runtest/testsuite \
	  && if $$(which parallel > /dev/null 2>&1); \
             then \
	       echo "Running testsuite in parallel (nproc=$$(nproc))"; \
               if [ "$(middle_end)" = "flambda2" ]; then \
                 make --no-print-directory list-parallel FILE=$$(pwd)/../flambda2-test-list; \
	       else \
                 make --no-print-directory parallel; \
               fi \
             else \
	       echo "Running testsuite sequentially"; \
               if [ "$(middle_end)" = "flambda2" ]; then \
                 make --no-print-directory list FILE=$$(pwd)/../flambda2-test-list; \
	       else \
                 make --no-print-directory all; \
               fi \
             fi)

.PHONY: test-typing
test-typing: install_for_test
	(export OCAMLSRCDIR=$$(pwd)/_runtest; \
	 export CAML_LD_LIBRARY_PATH=$$(pwd)/_runtest/lib/ocaml/stublibs; \
	 if $$(which gfortran > /dev/null 2>&1); then \
	   export LIBRARY_PATH=$$(dirname $$(gfortran -print-file-name=libgfortran.a)); \
	 fi; \
	 cd _runtest/testsuite \
      && if $$(which parallel > /dev/null 2>&1); \
         then \
              echo "Running typing testsuite in parallel (nproc=$$(nproc))"; \
              make --no-print-directory parallel-typing; \
	       else \
              echo "Running typing testsuite sequentially"; \
              make --no-print-directory all-typing; \
         fi)

promote-failed:
	(export OCAMLSRCDIR=$$(pwd)/_runtest; \
	 export CAML_LD_LIBRARY_PATH=$$(pwd)/_runtest/lib/ocaml/stublibs; \
	 if $$(which gfortran > /dev/null 2>&1); then \
	   export LIBRARY_PATH=$$(dirname $$(gfortran -print-file-name=libgfortran.a)); \
	 fi; \
	 cd _runtest/testsuite && make promote-failed)

runtest-upstream: test

test-one: install_for_test
	$(MAKE) test-one-no-rebuild

# If the TEST argument is passed as `testsuite/tests/foo` (as is invited by
# tab completion) then look for it in `tests/foo`. Otherwise, if it's passed as
# just `foo`, then look for it in `tests/foo` for backward compatibility.
locate_test = \
  $(shell \
    test=$(shell echo "$1" | sed 's|^testsuite/tests/||g'); \
    echo "tests/$${test}"; \
  )

test-one-no-rebuild:
	(export OCAMLSRCDIR=$$(pwd)/_runtest; \
	 export CAML_LD_LIBRARY_PATH=$$(pwd)/_runtest/lib/ocaml/stublibs; \
	 if $$(which gfortran > /dev/null 2>&1); then \
	   export LIBRARY_PATH=$$(dirname $$(gfortran -print-file-name=libgfortran.a)); \
	 fi; \
	 cd _runtest/testsuite && make one $(if $(TEST),TEST=$(call locate_test,$(TEST))) $(if $(DIR),DIR=$(call locate_test,$(DIR))))

promote-one: install_for_test
	$(MAKE) promote-one-no-rebuild

promote-one-no-rebuild:
	(export OCAMLSRCDIR=$$(pwd)/_runtest; \
	 export CAML_LD_LIBRARY_PATH=$$(pwd)/_runtest/lib/ocaml/stublibs; \
	 if $$(which gfortran > /dev/null 2>&1); then \
	   export LIBRARY_PATH=$$(dirname $$(gfortran -print-file-name=libgfortran.a)); \
	 fi; \
	 cd _runtest/testsuite && make promote $(if $(TEST),TEST=$(call locate_test,$(TEST))) $(if $(DIR),DIR=$(call locate_test,$(DIR))))

# Also build the indexes for Merlin's find-all-references (merlin-index) when
# an ocaml-index is on PATH; it must come from the same Merlin as the editor's
# ocaml-lsp, as the one in the dev shell does. Restrict dune to our packages so
# that it runs that ocaml-index rather than external/merlin's, which can't read
# the boot compiler's cmt files. Both aliases are defined only in the root, and
# under --only-packages the recursive forms fail on external/merlin's promoted
# parsers, so build them non-recursively.
merlin_index_packages = ocaml,oxcaml,oxcaml-dev,compiler-libs
have_ocaml_index = $(shell $(opam_exec) which ocaml-index 2>/dev/null)
merlin_index_flags = $(if $(have_ocaml_index),--only-packages $(merlin_index_packages))
merlin_index_target = $(if $(have_ocaml_index),@@merlin-index)
hacking_targets = @@merlin-support $(merlin_index_target) $(boot_targets)

# This target is like a polling version of upstream "make ocamlopt"
.PHONY: hacking
hacking: _build/_bootinstall
	$(dune) build -w $(merlin_index_flags) $(hacking_targets)

# A one-shot build of what `make hacking` builds, for CI. It always restricts
# dune to $(merlin_index_packages), even without ocaml-index on PATH, so that
# it catches libraries those packages leave out.
.PHONY: check-hacking
check-hacking: _build/_bootinstall
	$(dune) build --only-packages $(merlin_index_packages) $(hacking_targets)

# The `hacking-emacs-poller` and `hacking-emacs-builder` targets make it
# possible to run the polling build with Emacs's `M-x compile`.  You should run
# `make hacking-emacs-poller` in your terminal from the root directory of the
# repo, and set Emacs's `compile-command` to `make hacking-emacs-builder` (from
# the appropriate directory).

.PHONY: hacking-emacs-poller
hacking-emacs-poller: _build/_bootinstall
	$(dune) build --passive-watch-mode $(merlin_index_flags)

.PHONY: hacking-emacs-builder
hacking-emacs-builder: _build/_bootinstall
	$(dune) rpc build -w $(hacking_targets)
	$(dune) diagnostics

.PHONY: debug-printers
debug-printers: boot-compiler # required for $(ws_main) to work
	 $(dune) build $(ws_main) $(ocamldir)/tools/debug_printers
	@echo
	@echo To load into ocamldebug, use:
	@echo source \"$$(realpath _build/main/$(ocamldir)/tools/debug_printers)\"
