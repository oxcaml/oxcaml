check argument Int : PARAM opaque.ml:8:14-8:17
check ascription opaque.ml:4:21-6:3 : OUT opaque.ml:4:29-6:3
check ascription M : OUT.T@R opaque.ml:9:17-9:40
dep OUT -definition-> <#1>
dep OUT.T@F(Int) -instance-> OUT.T@body(OUT)
