dep S@F(M) -strengthen-> S
dep S@F(M) -strengthen-> <M>
dep S@F(M) -instance-> <param(F.X)>
dep <M> -interface-> S
dep <param(F.X)> -strengthen-> S
dep <param(F.X)> -strengthen-> <M>
equal F(M) = FM
