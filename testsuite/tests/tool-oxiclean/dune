(rule
 (target repr.ml)
 (action
  (copy %{dep:../../../stdlib/repr.ml} repr.ml)))

(rule
 (target repr.mli)
 (action
  (copy %{dep:../../../stdlib/repr.mli} repr.mli)))

(rule
 (targets repr.cmi repr.cmti repr.cmt)
 (deps
  (:src repr.mli repr.ml)
  (glob_files ../../../stdlib/build/*.cmi))
 (action
  (run
   %{exe:../../../main_native.exe}
   -I
   ../../../stdlib/build
   -bin-annot
   -stop-after
   typing
   -c
   %{src})))

(rule
 (targets repr.intf.json repr.impl.json)
 (deps (glob_files ../../../stdlib/build/*.cmi))
 (action
  (run
   %{exe:../../../tools/oxiclean/oxiclean.exe}
   %{dep:repr.cmti}
   %{dep:repr.cmt})))

(rule
 (alias repr)
 (deps
  repr.intf.json
  repr.impl.json)
 (action
  (progn
   (diff repr.impl.json.expected repr.impl.json)
   (diff repr.intf.json.expected repr.intf.json))))

(rule
 (targets even.cmi even.cmti even.cmt)
 (deps
  (:src even.mli even.ml)
  (glob_files ../../../stdlib/build/*.cmi))
 (action
  (run
   %{exe:../../../main_native.exe}
   -I
   ../../../stdlib/build
   -bin-annot
   -stop-after
   typing
   -c
   %{src})))

(rule
 (targets even.intf.json even.impl.json)
 (deps (glob_files ../../../stdlib/build/*.cmi))
 (action
  (run
   %{exe:../../../tools/oxiclean/oxiclean.exe}
   %{dep:even.cmti}
   %{dep:even.cmt})))

(rule
 (alias even)
 (deps
  even.intf.json
  even.impl.json)
 (action
  (progn
   (diff even.impl.json.expected even.impl.json)
   (diff even.intf.json.expected even.intf.json))))
