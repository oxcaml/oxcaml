(env (_ (env-vars (LEAN_PATH ../../../tools/oxiclean/lean:.))))

(rule
 (target repr.ml)
 (action
  (copy %{dep:../../../stdlib/repr.ml} repr.ml)))

(rule
 (target repr.mli)
 (action
  (copy %{dep:../../../stdlib/repr.mli} repr.mli)))

(rule
 (targets repr.cmi repr.cmti repr.cmt)
 (deps
  (:src repr.mli repr.ml)
  (glob_files ../../../stdlib/build/*.cmi))
 (action
  (run
   %{exe:../../../main_native.exe}
   -I
   ../../../stdlib/build
   -bin-annot
   -stop-after
   typing
   -c
   %{src})))

(rule
 (targets repr.intf.json repr.impl.json extracted_oxcaml_repr.lean)
 (deps (glob_files ../../../stdlib/build/*.cmi))
 (mode (promote (until-clean) (only *.json)))
 (action
  (run
   %{exe:../../../tools/oxiclean/oxiclean.exe}
   %{dep:repr.cmti}
   %{dep:repr.cmt})))

(rule
 (targets extracted_oxcaml_repr.olean)
 (deps
  (sandbox preserve_file_kind)
  repr.intf.json
  repr.impl.json
  (glob_files ../../../tools/oxiclean/lean/Oxiclean/*.olean))
 (action
  (run lean -DautoImplicit=false -o %{targets} %{dep:extracted_oxcaml_repr.lean})))

(rule
 (alias repr)
 (deps
  repr.intf.json
  repr.impl.json
  extracted_oxcaml_repr.olean
  Repr.lean
  (glob_files ../../../tools/oxiclean/lean/Oxiclean/*.olean))
 (action
  (progn
   (diff repr.impl.json.expected repr.impl.json)
   (diff repr.intf.json.expected repr.intf.json)
   (run lean -DautoImplicit=false %{dep:Repr.lean}))))

(rule
 (targets even.cmi even.cmti even.cmt)
 (deps
  (:src even.mli even.ml)
  (glob_files ../../../stdlib/build/*.cmi))
 (action
  (run
   %{exe:../../../main_native.exe}
   -I
   ../../../stdlib/build
   -bin-annot
   -stop-after
   typing
   -c
   %{src})))

(rule
 (targets even.intf.json even.impl.json extracted_oxcaml_even.lean)
 (deps (glob_files ../../../stdlib/build/*.cmi))
 (mode (promote (until-clean) (only *.json)))
 (action
  (run
   %{exe:../../../tools/oxiclean/oxiclean.exe}
   %{dep:even.cmti}
   %{dep:even.cmt})))

(rule
 (targets extracted_oxcaml_even.olean)
 (deps
  (sandbox preserve_file_kind)
  even.intf.json
  even.impl.json
  (glob_files ../../../tools/oxiclean/lean/Oxiclean/*.olean))
 (action
  (run lean -DautoImplicit=false -o %{targets} %{dep:extracted_oxcaml_even.lean})))

(rule
 (alias even)
 (deps
  even.intf.json
  even.impl.json
  extracted_oxcaml_even.olean
  Even.lean
  (glob_files ../../../tools/oxiclean/lean/Oxiclean/*.olean))
 (action
  (progn
   (diff even.impl.json.expected even.impl.json)
   (diff even.intf.json.expected even.intf.json)
   (run lean -DautoImplicit=false %{dep:Even.lean}))))

(rule
 (targets downstream.cmi downstream.cmti downstream.cmt)
 (deps
  (:src downstream.mli downstream.ml)
  even.cmi
  (glob_files ../../../stdlib/build/*.cmi))
 (action
  (run
   %{exe:../../../main_native.exe}
   -I
   ../../../stdlib/build
   -I
   .
   -bin-annot
   -stop-after
   typing
   -c
   %{src})))

(rule
 (targets
  downstream.intf.json
  downstream.impl.json
  extracted_oxcaml_downstream.lean)
 (deps
  even.cmi
  (glob_files ../../../stdlib/build/*.cmi))
 (mode (promote (until-clean) (only *.json)))
 (action
  (run
   %{exe:../../../tools/oxiclean/oxiclean.exe}
   %{dep:downstream.cmti}
   %{dep:downstream.cmt})))

(rule
 (targets extracted_oxcaml_downstream.olean)
 (deps
  (sandbox preserve_file_kind)
  downstream.intf.json
  downstream.impl.json
  extracted_oxcaml_even.olean
  (glob_files ../../../tools/oxiclean/lean/Oxiclean/*.olean))
 (action
  (run lean -DautoImplicit=false -o %{targets} %{dep:extracted_oxcaml_downstream.lean})))

(rule
 (alias downstream)
 (deps
  downstream.intf.json
  downstream.impl.json
  extracted_oxcaml_even.olean
  extracted_oxcaml_downstream.olean
  Downstream.lean
  (glob_files ../../../tools/oxiclean/lean/Oxiclean/*.olean))
 (action
  (progn
   (diff downstream.impl.json.expected downstream.impl.json)
   (diff downstream.intf.json.expected downstream.intf.json)
   (run lean -DautoImplicit=false %{dep:Downstream.lean}))))
