ignore
  ((fun x -> x)
     ({ Labels_types.bar = "abc"; Labels_types.foo = 123 } : Labels_types.rcd) : 
  Labels_types.rcd)

ignore
  ((fun x -> x) (fun r -> (r : Labels_types.rcd).Labels_types.foo) : 
  Labels_types.rcd -> int)

ignore
  ((fun x -> x) (fun r -> (r : Labels_types.rcd).Labels_types.bar <- "xyz") : 
  Labels_types.rcd -> unit)

ignore
  ((fun x -> x)
     (function | ({ Labels_types.foo = foo;_} : Labels_types.rcd) -> foo) : 
  Labels_types.rcd -> int)

ignore
  ((fun x -> x) (Labels_types.Foo : Labels_types.vrt) : Labels_types.vrt)

ignore
  ((fun x -> x)
     (function
      | (Labels_types.Foo : Labels_types.vrt) -> 0
      | (Labels_types.Bar : Labels_types.vrt) -> 1) : Labels_types.vrt -> int)

ignore
  ((fun x -> x)
     { Labels_types.box = (#{ bar = 0; foo = 0 } : Labels_types.urcd) } : 
  Labels_types.urcd Labels_types.box_imm_imm)

ignore
  ((fun x -> x) (fun r -> let _ = (r : Labels_types.urcd).#foo in ()) : 
  Labels_types.urcd -> unit)

ignore
  ((fun x -> x) (function | (#{ foo;_} : Labels_types.urcd) -> foo) : 
  Labels_types.urcd -> int)

ignore
  ((fun x -> x)
     ({ Labels_types.bar = "abc"; Labels_types.foo = 123 } : _
                                                               Labels_types.rcd1) : 
  _ Labels_types.rcd1)

ignore
  ((fun x -> x)
     ({ Labels_types.bar = "abc"; Labels_types.foo = 123 } : (_, _)
                                                               Labels_types.rcd2) : 
  (_, _) Labels_types.rcd2)

ignore
  ((fun x -> x)
     ({ Labels_types.bar = "abc"; Labels_types.foo = 123 } : (_, _)
                                                               Labels_types.rcd2) : 
  (_, _) Labels_types.rcd2)

ignore
  ((fun x -> x)
     ({ Labels_types.bar = "abc"; Labels_types.foo = 123 } : (_, _, _)
                                                               Labels_types.rcd3) : 
  (_, _, _) Labels_types.rcd3)

