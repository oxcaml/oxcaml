(rule
 (targets record.cmi record.cmt)
 (deps record.ml)
 (action
  (run
   %{exe:../../../main_native.exe}
   -nostdlib
   -nopervasives
   -bin-annot
   -stop-after
   typing
   -c
   %{deps})))

(rule
 (with-stdout-to
  record.json
  (run
   %{exe:../../../tools/howdah/howdah.exe}
   %{dep:record.cmi}
   %{dep:record.cmt})))

(rule
 (alias record)
 (deps
  record.json
  (glob_files ../../../tools/howdah/lean/Howdah/*.olean))
 (action
  (run %{dep:../../../tools/howdah/lean/lean-with-flags} %{dep:Record.lean})))
