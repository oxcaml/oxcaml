(function "tak" (x:int y:int z:int)
  (if (>s x y)
      (app "tak":code_pointer (app "tak":code_pointer (- x 1) y z int)
                              (app "tak":code_pointer (- y 1) z x int)
                              (app "tak":code_pointer (- z 1) x y int) int)
      z))

(function "takmain" (dummy: int)
   (app "tak":code_pointer 18 12 6 int))
