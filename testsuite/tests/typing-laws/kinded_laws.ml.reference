[@@@ocaml.warning "-27"]
module Laws_gen_Kinded = Kinded
module Laws_gen_Stdlib = Stdlib
type 'a each =
  {
  kinded: 'a ;
  kinded_unused: 'a ;
  kinded_shared: 'a ;
  nullable: 'a ;
  plain: 'a }
let names =
  {
    kinded = "kinded";
    kinded_unused = "kinded_unused";
    kinded_shared = "kinded_shared";
    nullable = "nullable";
    plain = "plain"
  }
let map { kinded; kinded_unused; kinded_shared; nullable; plain } ~f =
  {
    kinded = (f kinded);
    kinded_unused = (f kinded_unused);
    kinded_shared = (f kinded_shared);
    nullable = (f nullable);
    plain = (f plain)
  }
let to_list { kinded; kinded_unused; kinded_shared; nullable; plain } =
  [kinded; kinded_unused; kinded_shared; nullable; plain]
type kinded_input =
  | Kinded_input: ('a : immutable_data) . {
  x: 'a } -> kinded_input 
type kinded_unused_input =
  | Kinded_unused_input: ('a : immutable_data) . {
  x: 'a } -> kinded_unused_input 
type kinded_shared_input =
  | Kinded_shared_input: ('a : immutable_data) . {
  x: 'a ;
  y: 'a } -> kinded_shared_input 
type nullable_input =
  | Nullable_input: ('a : value_or_null) . {
  x: 'a } -> nullable_input 
type plain_input =
  | Plain_input: ('a : value_or_null) . {
  x: 'a } -> plain_input 
module Instantiate(Choice:CamlinternalLaw.Choice) =
  struct
    module Law = (CamlinternalLaw.Make)(Choice)
    module type Choices  =
      sig
        val kinded : kinded_input Choice.t
        val kinded_unused : kinded_unused_input Choice.t
        val kinded_shared : kinded_shared_input Choice.t
        val nullable : nullable_input Choice.t
        val plain : plain_input Choice.t
      end
    let kinded ((module C)  : (module Choices))  : unit Law.t =
      Law.Bind
        ((Law.Choose C.kinded),
          (fun input ->
             Law.Assertion
               {
                 value = input;
                 source = C.kinded;
                 predicate =
                   (fun ((Kinded_input { x }) : kinded_input) ->
                      (Laws_gen_Kinded.f x : bool));
                 text = "f x"
               }))
    let kinded_unused ((module C)  : (module Choices))  : unit Law.t =
      Law.Bind
        ((Law.Choose C.kinded_unused),
          (fun input ->
             Law.Assertion
               {
                 value = input;
                 source = C.kinded_unused;
                 predicate =
                   (fun ((Kinded_unused_input { x }) : kinded_unused_input)
                      -> (true : bool));
                 text = "true"
               }))
    let kinded_shared ((module C)  : (module Choices))  : unit Law.t =
      Law.Bind
        ((Law.Choose C.kinded_shared),
          (fun input ->
             Law.Assertion
               {
                 value = input;
                 source = C.kinded_shared;
                 predicate =
                   (fun
                      ((Kinded_shared_input { x; y }) : kinded_shared_input)
                      ->
                      (Laws_gen_Stdlib.(&&) (Laws_gen_Kinded.f x)
                         (Laws_gen_Kinded.f y) : bool));
                 text = "(f x) && (f y)"
               }))
    let nullable ((module C)  : (module Choices))  : unit Law.t =
      Law.Bind
        ((Law.Choose C.nullable),
          (fun input ->
             Law.Assertion
               {
                 value = input;
                 source = C.nullable;
                 predicate =
                   (fun ((Nullable_input { x }) : nullable_input) ->
                      (true : bool));
                 text = "true"
               }))
    let plain ((module C)  : (module Choices))  : unit Law.t =
      Law.Bind
        ((Law.Choose C.plain),
          (fun input ->
             Law.Assertion
               {
                 value = input;
                 source = C.plain;
                 predicate =
                   (fun ((Plain_input { x }) : plain_input) -> (true : bool));
                 text = "true"
               }))
    let laws choices =
      {
        kinded = (kinded choices);
        kinded_unused = (kinded_unused choices);
        kinded_shared = (kinded_shared choices);
        nullable = (nullable choices);
        plain = (plain choices)
      }
  end
