let map
  { partly_hidden_hidden; map_find_elem; map_empty_find_empty; lex_refl;
    order_max_max_comm; order_max_pair_pair_refl; twice_g_idem;
    outer_inner_mk_ok }
  ~f =
  {
    partly_hidden_hidden = (f partly_hidden_hidden);
    map_find_elem = (f map_find_elem);
    map_empty_find_empty = (f map_empty_find_empty);
    lex_refl = (f lex_refl);
    order_max_max_comm = (f order_max_max_comm);
    order_max_pair_pair_refl = (f order_max_pair_pair_refl);
    twice_g_idem = (f twice_g_idem);
    outer_inner_mk_ok = (f outer_inner_mk_ok)
  }
let to_list
  { partly_hidden_hidden; map_find_elem; map_empty_find_empty; lex_refl;
    order_max_max_comm; order_max_pair_pair_refl; twice_g_idem;
    outer_inner_mk_ok }
  =
  [partly_hidden_hidden;
  map_find_elem;
  map_empty_find_empty;
  lex_refl;
  order_max_max_comm;
  order_max_pair_pair_refl;
  twice_g_idem;
  outer_inner_mk_ok]
type partly_hidden_hidden_input =
  | Partly_hidden_hidden_input: {
  x: int } -> partly_hidden_hidden_input 
module Instantiate(Choice:CamlinternalLaw.Choice) =
  struct
    module Law = (CamlinternalLaw.Make)(Choice)
    module type Map_choices  =
      sig
        module Key : Laws_gen_Gen_scopes.Comparable
        type find_elem_input =
          | Find_elem_input: 'a .
          {
          k: Key.t ;
          m: 'a Laws_gen_Gen_scopes.Map(Key).t } -> find_elem_input 
        type empty_find_empty_input =
          | Empty_find_empty_input: {
          k: Key.t } -> empty_find_empty_input 
        val find_elem : find_elem_input Choice.t
        val empty_find_empty : empty_find_empty_input Choice.t
      end
    module type Lex_choices  =
      sig
        module A : Laws_gen_Gen_scopes.Comparable
        module B : Laws_gen_Gen_scopes.Comparable
        type refl_input =
          | Refl_input: {
          p: (A.t * B.t) } -> refl_input 
        val refl : refl_input Choice.t
      end
    module type Order_max_choices  =
      sig
        module X : Laws_gen_Gen_scopes.Comparable
        type max_comm_input =
          | Max_comm_input: {
          a: X.t ;
          b: X.t } -> max_comm_input 
        module type Pair_choices  =
          sig
            module Y : sig type t val equal : t -> t -> bool end
            type pair_refl_input =
              | Pair_refl_input: {
              a: X.t ;
              b: Y.t } -> pair_refl_input 
            val pair_refl : pair_refl_input Choice.t
          end
        val max_comm : max_comm_input Choice.t
        val pair : (module Pair_choices) Choice.t
      end
    module type Twice_choices  =
      sig
        module X :
        sig
          val f : int -> int
          law? idem (x : int) : Laws_gen_Stdlib.(=) (f (f x)) (f x)
        end
        type g_idem_input =
          | G_idem_input: {
          x: int } -> g_idem_input 
        val g_idem : g_idem_input Choice.t
      end
    module type Outer_choices  =
      sig
        module X : Laws_gen_Gen_scopes.Comparable
        module type Inner_choices  =
          sig
            module X_1 : Laws_gen_Gen_scopes.Comparable
            type mk_ok_input =
              | Mk_ok_input: {
              x: X_1.t } -> mk_ok_input 
            val mk_ok : mk_ok_input Choice.t
          end
        val inner : (module Inner_choices) Choice.t
      end
    module type Choices  =
      sig
        val partly_hidden_hidden : partly_hidden_hidden_input Choice.t
        val map : (module Map_choices) Choice.t
        val lex : (module Lex_choices) Choice.t
        val order_max : (module Order_max_choices) Choice.t
        val twice : (module Twice_choices) Choice.t
        val outer : (module Outer_choices) Choice.t
      end
    let partly_hidden_hidden ((module C)  : (module Choices))  : unit Law.t =
      Law.Bind
        ((Law.Choose C.partly_hidden_hidden),
          (fun input ->
             Law.Assertion
               {
                 value = input;
                 source = C.partly_hidden_hidden;
                 predicate =
                   (fun
                      ((Partly_hidden_hidden_input { x }) :
                         partly_hidden_hidden_input)
                      ->
                      (Laws_gen_Stdlib.(=)
                         (Laws_gen_Gen_scopes.Partly_hidden.g x) x : 
                      bool));
                 location =
                   {
                     CamlinternalLaw.file = "gen_scopes.ml";
                     start_line = 28;
                     start_col = 26;
                     end_line = 28;
                     end_col = 33
                   }
               }))
    let map_find_elem ((module C)  : (module Choices))  : unit Law.t =
      Law.Bind
        ((Law.Choose C.map),
          (fun ((module M)  : (module Map_choices)) ->
             let module I = (Laws_gen_Gen_scopes.Map)(M.Key) in
               Law.Bind
                 ((Law.Choose M.find_elem),
                   (fun input ->
                      Law.Bind
                        ((Law.Assumption
                            {
                              value = input;
                              source = M.find_elem;
                              predicate =
                                (fun
                                   ((M.Find_elem_input { k; m }) :
                                      M.find_elem_input)
                                   ->
                                   (Laws_gen_Stdlib.not (I.elem m k) : 
                                   bool));
                              location =
                                {
                                  CamlinternalLaw.file = "gen_scopes.ml";
                                  start_line = 43;
                                  start_col = 4;
                                  end_line = 43;
                                  end_col = 18
                                }
                            }),
                          (fun () ->
                             Law.Assertion
                               {
                                 value = input;
                                 source = M.find_elem;
                                 predicate =
                                   (fun
                                      ((M.Find_elem_input { k; m }) :
                                         M.find_elem_input)
                                      ->
                                      (Laws_gen_Stdlib.Option.is_none
                                         (I.find m k) : bool));
                                 location =
                                   {
                                     CamlinternalLaw.file = "gen_scopes.ml";
                                     start_line = 43;
                                     start_col = 24;
                                     end_line = 43;
                                     end_col = 49
                                   }
                               }))))))
    let map_empty_find_empty ((module C)  : (module Choices))  : unit Law.t =
      Law.Bind
        ((Law.Choose C.map),
          (fun ((module M)  : (module Map_choices)) ->
             let module I = (Laws_gen_Gen_scopes.Map)(M.Key) in
               Law.Bind
                 ((Law.Choose M.empty_find_empty),
                   (fun input ->
                      Law.Assertion
                        {
                          value = input;
                          source = M.empty_find_empty;
                          predicate =
                            (fun
                               ((M.Empty_find_empty_input { k }) :
                                  M.empty_find_empty_input)
                               ->
                               (Laws_gen_Stdlib.Option.is_none
                                  (I.find I.empty k) : bool));
                          location =
                            {
                              CamlinternalLaw.file = "gen_scopes.ml";
                              start_line = 45;
                              start_col = 34;
                              end_line = 45;
                              end_col = 63
                            }
                        }))))
    let lex_refl ((module C)  : (module Choices))  : unit Law.t =
      Law.Bind
        ((Law.Choose C.lex),
          (fun ((module M)  : (module Lex_choices)) ->
             let module I = ((Laws_gen_Gen_scopes.Lex)(M.A))(M.B) in
               Law.Bind
                 ((Law.Choose M.refl),
                   (fun input ->
                      Law.Assertion
                        {
                          value = input;
                          source = M.refl;
                          predicate =
                            (fun ((M.Refl_input { p }) : M.refl_input) ->
                               (Laws_gen_Stdlib.(=) (I.compare p p) 0 : 
                               bool));
                          location =
                            {
                              CamlinternalLaw.file = "gen_scopes.ml";
                              start_line = 53;
                              start_col = 30;
                              end_line = 53;
                              end_col = 45
                            }
                        }))))
    let order_max_max_comm ((module C)  : (module Choices))  : unit Law.t =
      Law.Bind
        ((Law.Choose C.order_max),
          (fun ((module M)  : (module Order_max_choices)) ->
             let module I = (Laws_gen_Gen_scopes.Order.Max)(M.X) in
               Law.Bind
                 ((Law.Choose M.max_comm),
                   (fun input ->
                      Law.Assertion
                        {
                          value = input;
                          source = M.max_comm;
                          predicate =
                            (fun
                               ((M.Max_comm_input { a; b }) :
                                  M.max_comm_input)
                               ->
                               (Laws_gen_Stdlib.(=)
                                  (M.X.compare (I.max a b) (I.max b a)) 0 : 
                               bool));
                          location =
                            {
                              CamlinternalLaw.file = "gen_scopes.ml";
                              start_line = 65;
                              start_col = 40;
                              end_line = 65;
                              end_col = 73
                            }
                        }))))
    let order_max_pair_pair_refl ((module C)  : (module Choices))  :
      unit Law.t =
      Law.Bind
        ((Law.Choose C.order_max),
          (fun ((module M)  : (module Order_max_choices)) ->
             let module I = (Laws_gen_Gen_scopes.Order.Max)(M.X) in
               Law.Bind
                 ((Law.Choose M.pair),
                   (fun ((module M1)  : (module M.Pair_choices)) ->
                      let module I1 = (I.Pair)(M1.Y) in
                        Law.Bind
                          ((Law.Choose M1.pair_refl),
                            (fun input ->
                               Law.Assertion
                                 {
                                   value = input;
                                   source = M1.pair_refl;
                                   predicate =
                                     (fun
                                        ((M1.Pair_refl_input { a; b }) :
                                           M1.pair_refl_input)
                                        ->
                                        (Laws_gen_Stdlib.(&&)
                                           (Laws_gen_Stdlib.(=)
                                              (M.X.compare (I.max a a) a) 0)
                                           (M1.Y.equal b b) : bool));
                                   location =
                                     {
                                       CamlinternalLaw.file = "gen_scopes.ml";
                                       start_line = 68;
                                       start_col = 8;
                                       end_line = 68;
                                       end_col = 48
                                     }
                                 }))))))
    let twice_g_idem ((module C)  : (module Choices))  : unit Law.t =
      Law.Bind
        ((Law.Choose C.twice),
          (fun ((module M)  : (module Twice_choices)) ->
             let module I = (Laws_gen_Gen_scopes.Twice)(M.X) in
               Law.Bind
                 ((Law.Choose M.g_idem),
                   (fun input ->
                      Law.Assertion
                        {
                          value = input;
                          source = M.g_idem;
                          predicate =
                            (fun ((M.G_idem_input { x }) : M.g_idem_input) ->
                               (Laws_gen_Stdlib.(=) (I.g (I.g x)) (I.g x) : 
                               bool));
                          location =
                            {
                              CamlinternalLaw.file = "gen_scopes.ml";
                              start_line = 79;
                              start_col = 26;
                              end_line = 79;
                              end_col = 39
                            }
                        }))))
    let outer_inner_mk_ok ((module C)  : (module Choices))  : unit Law.t =
      Law.Bind
        ((Law.Choose C.outer),
          (fun ((module M)  : (module Outer_choices)) ->
             let module I = (Laws_gen_Gen_scopes.Outer)(M.X) in
               Law.Bind
                 ((Law.Choose M.inner),
                   (fun ((module M1)  : (module M.Inner_choices)) ->
                      let module I1 = (I.Inner)(M1.X_1) in
                        Law.Bind
                          ((Law.Choose M1.mk_ok),
                            (fun input ->
                               Law.Assertion
                                 {
                                   value = input;
                                   source = M1.mk_ok;
                                   predicate =
                                     (fun
                                        ((M1.Mk_ok_input { x }) :
                                           M1.mk_ok_input)
                                        ->
                                        (Laws_gen_Stdlib.(=) (I1.mk x)
                                           (I1.mk x) : bool));
                                   location =
                                     {
                                       CamlinternalLaw.file = "gen_scopes.ml";
                                       start_line = 87;
                                       start_col = 27;
                                       end_line = 87;
                                       end_col = 38
                                     }
                                 }))))))
    let laws choices =
      {
        partly_hidden_hidden = (partly_hidden_hidden choices);
        map_find_elem = (map_find_elem choices);
        map_empty_find_empty = (map_empty_find_empty choices);
        lex_refl = (lex_refl choices);
        order_max_max_comm = (order_max_max_comm choices);
        order_max_pair_pair_refl = (order_max_pair_pair_refl choices);
        twice_g_idem = (twice_g_idem choices);
        outer_inner_mk_ok = (outer_inner_mk_ok choices)
      }
  end
