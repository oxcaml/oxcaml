    let tuples ((module C)  : (module Choices))  : unit Law.t =
      Law.Bind
        ((Law.Choose C.tuples),
          (fun input ->
             Law.Assertion
               {
                 value = input;
                 source = C.tuples;
                 predicate =
                   (fun ((Tuples_input { x; y }) : tuples_input) ->
                      (Laws_gen_Stdlib.(&&)
                         (Laws_gen_Stdlib.(=) (x, y) (x, y))
                         (Laws_gen_Stdlib.(<>) (`A x) `B) : bool));
                 location =
                   {
                     CamlinternalLaw.file = "gen_flat.ml";
                     start_line = 50;
                     start_col = 37;
                     end_line = 50;
                     end_col = 66
                   }
               }))
    let control ((module C)  : (module Choices))  : unit Law.t =
      Law.Bind
        ((Law.Choose C.control),
          (fun input ->
             Law.Assertion
               {
                 value = input;
                 source = C.control;
                 predicate =
                   (fun ((Control_input { x }) : control_input) ->
                      (Laws_gen_Stdlib.(&&)
                         (Laws_gen_Stdlib.(>=)
                            (if Laws_gen_Stdlib.(>) x 0 then x else 0) 0)
                         (Laws_gen_Stdlib.(&&)
                            (Laws_gen_Stdlib.(=)
                               (Laws_gen_Gen_flat.g (() : unit); x) x)
                            (Laws_gen_Stdlib.(&&)
                               (Laws_gen_Stdlib.(=)
                                  (Laws_gen_Stdlib.Lazy.force (lazy x)) x)
                               (assert (Laws_gen_Stdlib.(=) x x);
                                (true : bool)))) : bool));
                 location =
                   {
                     CamlinternalLaw.file = "gen_flat.ml";
                     start_line = 56;
                     start_col = 2;
                     end_line = 57;
                     end_col = 54
