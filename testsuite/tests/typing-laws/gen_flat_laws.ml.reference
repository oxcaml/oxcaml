type poly_input =
  | Poly_input: 'a 'b . {
  xs: 'a list ;
  f: 'a -> 'b } -> poly_input 
type modes_input =
  | Modes_input: {
  g: int @ local -> int } -> modes_input 
type unboxed_input =
  | Unboxed_input: {
  x: float# } -> unboxed_input 
type type_input =
  | Type_input: {
  \#method: int } -> type_input 
type alias_input =
  | Alias_input: {
  x: int as 'a } -> alias_input 
type assumption_input =
  | Assumption_input: {
  x: int } -> assumption_input 
type constants_input =
  | Constants_input: {
  c: char } -> constants_input 
type constructors_input =
  | Constructors_input: {
  s: Laws_gen_Gen_flat.shape } -> constructors_input 
type tuples_input =
  | Tuples_input: {
  x: int ;
  y: string } -> tuples_input 
type control_input =
  | Control_input: {
  x: int } -> control_input 
type binding_input =
  | Binding_input: {
  s: Laws_gen_Gen_flat.shape } -> binding_input 
type functions_input =
  | Functions_input: {
  xs: int list } -> functions_input 
type local_input =
  | Local_input: {
  x: int } -> local_input 
type records_input =
  | Records_input: {
  p: Laws_gen_Gen_flat.point } -> records_input 
module Instantiate(Choice:CamlinternalLaw.Choice) =
  struct
    module Law = (CamlinternalLaw.Make)(Choice)
    let poly (choice : poly_input Choice.t)  : unit Law.t =
      Law.Bind
