             Law.Assertion
               {
                 value = input;
                 source = C.functions;
                 predicate =
                   (fun ((Functions_input { xs }) : functions_input) ->
                      (Laws_gen_Stdlib.(||)
                         (Laws_gen_Stdlib.(&&)
                            ((fun ?(min= 0) x -> Laws_gen_Stdlib.(>=) x min)
                               ?min:(None : _ option) 1)
                            (Laws_gen_Stdlib.List.for_all
                               (fun x -> Laws_gen_Stdlib.(>=) x 0) xs))
                         (Laws_gen_Stdlib.List.exists
