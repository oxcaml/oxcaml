                 source = C.records;
                 predicate =
                   (fun ((Records_input { p }) : records_input) ->
                      (Laws_gen_Stdlib.(&&)
                         (Laws_gen_Stdlib.(=)
                            (({ y = ((p : Laws_gen_Gen_flat.point).y); x = 0.
                              } : Laws_gen_Gen_flat.point) : Laws_gen_Gen_flat.point)
                            ({ p with x = 0. } : Laws_gen_Gen_flat.point))
