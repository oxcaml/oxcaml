        poly = (poly choices);
        modes = (modes choices);
        unboxed = (unboxed choices);
        \#type = (\#type choices);
        alias = (alias choices);
        assumption = (assumption choices);
        constants = (constants choices);
        constructors = (constructors choices);
        tuples = (tuples choices);
        control = (control choices);
        binding = (binding choices);
        functions = (functions choices);
        records = (records choices)
      }
  end
