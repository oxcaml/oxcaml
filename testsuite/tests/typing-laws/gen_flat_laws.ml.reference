               }))
    let binding ((module C)  : (module Choices))  : unit Law.t =
      Law.Bind
        ((Law.Choose C.binding),
          (fun input ->
             Law.Assertion
               {
                 value = input;
                 source = C.binding;
                 predicate =
                   (fun ((Binding_input { s }) : binding_input) ->
                      (let a =
                         match s with
                         | (Circle r : Laws_gen_Gen_flat.shape) -> r
                         | (Square w : Laws_gen_Gen_flat.shape) -> w in
                       Laws_gen_Stdlib.(||)
                         (try Laws_gen_Stdlib.(>=) a 0.
                          with | Laws_gen_Stdlib.Not_found -> (false : bool))
                         (Laws_gen_Stdlib.(<) a 0.) : bool));
                 location =
