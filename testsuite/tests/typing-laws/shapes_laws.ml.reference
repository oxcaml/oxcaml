let map
  { area_nonneg; poly; disamb; optional; modes; fmt; fake_format; unboxed;
    \#type; inferred }
  ~f =
  {
    area_nonneg = (f area_nonneg);
    poly = (f poly);
    disamb = (f disamb);
    optional = (f optional);
    modes = (f modes);
    fmt = (f fmt);
    fake_format = (f fake_format);
    unboxed = (f unboxed);
    \#type = (f \#type);
