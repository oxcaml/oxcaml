let map { kinded; narrowed; nullable; plain; refined } ~f =
  {
    kinded = (f kinded);
    narrowed = (f narrowed);
    nullable = (f nullable);
    plain = (f plain);
    refined = (f refined)
  }
let to_list { kinded; narrowed; nullable; plain; refined } =
  [kinded; narrowed; nullable; plain; refined]
type kinded_input =
  | Kinded_input: ('a : immutable_data) . {
  x: ('a : immutable_data) } -> kinded_input 
type narrowed_input =
  | Narrowed_input: ('a : immutable_data) . {
  x: 'a ;
  y: 'a } -> narrowed_input 
type nullable_input =
  | Nullable_input: ('a : value_or_null) . {
  x: 'a } -> nullable_input 
type plain_input =
  | Plain_input: 'a . {
  x: 'a } -> plain_input 
type refined_input =
  | Refined_input: 'a . {
  w: 'a Laws_gen_Gen_kinded.ty ;
  x: 'a } -> refined_input 
module Instantiate(Choice:CamlinternalLaw.Choice) =
  struct
    module Law = (CamlinternalLaw.Make)(Choice)
    module type Choices  =
      sig
        val kinded : kinded_input Choice.t
        val narrowed : narrowed_input Choice.t
        val nullable : nullable_input Choice.t
        val plain : plain_input Choice.t
        val refined : refined_input Choice.t
      end
    let kinded ((module C)  : (module Choices))  : unit Law.t =
      Law.Bind
        ((Law.Choose C.kinded),
          (fun input ->
             Law.Assertion
               {
                 value = input;
                 source = C.kinded;
                 predicate =
                   (fun ((Kinded_input { x }) : kinded_input) ->
                      (Laws_gen_Gen_kinded.f x : bool));
                 location =
                   {
                     CamlinternalLaw.file = "gen_kinded.ml";
                     start_line = 23;
                     start_col = 42;
                     end_line = 23;
                     end_col = 45
                   }
               }))
    let narrowed ((module C)  : (module Choices))  : unit Law.t =
      Law.Bind
        ((Law.Choose C.narrowed),
          (fun input ->
             Law.Assertion
               {
                 value = input;
                 source = C.narrowed;
                 predicate =
                   (fun ((Narrowed_input { x; y }) : narrowed_input) ->
                      (Laws_gen_Stdlib.(&&) (Laws_gen_Gen_kinded.f x)
                         (Laws_gen_Gen_kinded.f y) : bool));
                 location =
                   {
                     CamlinternalLaw.file = "gen_kinded.ml";
                     start_line = 25;
                     start_col = 34;
                     end_line = 25;
                     end_col = 44
                   }
               }))
    let nullable ((module C)  : (module Choices))  : unit Law.t =
      Law.Bind
        ((Law.Choose C.nullable),
          (fun input ->
             Law.Assertion
               {
                 value = input;
                 source = C.nullable;
                 predicate =
                   (fun ((Nullable_input { x }) : nullable_input) ->
                      (fun (type a : value_or_null) (x : a) ->
                         (Laws_gen_Stdlib.(=) 1 1 : bool)) x);
                 location =
                   {
                     CamlinternalLaw.file = "gen_kinded.ml";
                     start_line = 26;
                     start_col = 51;
                     end_line = 26;
                     end_col = 56
                   }
               }))
    let plain ((module C)  : (module Choices))  : unit Law.t =
      Law.Bind
        ((Law.Choose C.plain),
          (fun input ->
             Law.Assertion
               {
                 value = input;
                 source = C.plain;
                 predicate =
                   (fun ((Plain_input { x }) : plain_input) ->
                      (Laws_gen_Stdlib.(=) 1 1 : bool));
                 location =
                   {
                     CamlinternalLaw.file = "gen_kinded.ml";
                     start_line = 27;
                     start_col = 22;
                     end_line = 27;
                     end_col = 27
                   }
               }))
    let refined ((module C)  : (module Choices))  : unit Law.t =
      Law.Bind
        ((Law.Choose C.refined),
          (fun input ->
             Law.Assertion
               {
                 value = input;
                 source = C.refined;
                 predicate =
                   (fun ((Refined_input { w; x }) : refined_input) ->
                      (fun (type a) (w : a Laws_gen_Gen_kinded.ty) (x : a) ->
                         (Laws_gen_Stdlib.(&&)
                            (match w with
                             | (Int : _ Laws_gen_Gen_kinded.ty) ->
                                 Laws_gen_Stdlib.(>=) x 0
                             | (Bool : _ Laws_gen_Gen_kinded.ty) ->
                                 Laws_gen_Stdlib.(||) x (true : bool))
                            (Laws_gen_Stdlib.(==) x x) : bool)) w x);
                 location =
                   {
                     CamlinternalLaw.file = "gen_kinded.ml";
                     start_line = 31;
                     start_col = 2;
                     end_line = 31;
                     end_col = 60
                   }
               }))
    let laws choices =
      {
        kinded = (kinded choices);
        narrowed = (narrowed choices);
        nullable = (nullable choices);
        plain = (plain choices);
        refined = (refined choices)
      }
  end
