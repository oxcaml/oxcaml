(* Only [live]'s code is needed, but [unused = b] survives as a phantom alias.
   Keep [b]'s binder and a [Deleted] declaration. Check raw Flambda because the
   fexpr printer does not support deleted function declarations. *)

let code inline(never) size(1) live (x : val)
      specialised { x = x_slot }
      my_closure &my_alloc_region my_depth -> k * e : val =
  cont k (x)
in
let code inline(never) size(1) dead (x : val)
      my_closure &my_alloc_region my_depth -> k * e : val =
  cont k (x)
in
let code size(30) outer (x : val)
      my_closure &my_alloc_region my_depth -> k * e : val =
  let a = closure specialisation_site live &my_alloc_region
    synthetic { x_slot = 0 }
  and b = closure specialisation_site dead &my_alloc_region in
  let unused = b in
  apply direct(live &my_alloc_region) (0) -> k * e
in
let $outer = closure outer &toplevel in
let $camlSpecialised_params_phantom_sibling = Block 0 ($outer) in
cont done ($camlSpecialised_params_phantom_sibling)
