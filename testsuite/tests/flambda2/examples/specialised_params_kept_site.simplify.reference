let code inline(never) size(10)
      helper (x : val) my_closure &my_alloc_region my_depth -> k * e : val =
  cont k (x)
in
let code inline(never) size(10)
      helper2 (x : val) my_closure &my_alloc_region my_depth -> k * e : val =
  cont k (x)
in
let code map deleted in
let code inline(never) loopify(never) size(1) newer_version_of(helper)
      helper_1 (x : val) my_closure &my_alloc_region my_depth -> k * e : val =
  cont k (x)
in
let code inline(never) loopify(never) size(1) newer_version_of(helper2)
      helper2_1 (x : val) my_closure &my_alloc_region my_depth -> k * e : val =
