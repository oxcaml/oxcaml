let code square deleted in
let code loopify(never) size(5) newer_version_of(square)
      square_1 (x : val) my_closure &my_alloc_region my_depth -> k * e : val =
  let r = %int_barith.mul (x, x) in
  cont k (r)
in
let $square = closure square_1 @square &toplevel in
let code double deleted in
let code loopify(never) size(3) newer_version_of(double)
      double_1 (x : val) my_closure &my_alloc_region my_depth -> k * e : val =
  let r = %int_barith.add (x, x) in
  cont k (r)
in
let $double = closure double_1 @double &toplevel in
let code inline(never) size(10)
      helper (f : val, x : val) specialised { f = f_slot; x = x_slot }
        my_closure &my_alloc_region my_depth
        -> k * e
        : val =
  apply &my_alloc_region f (x) -> k * e
in
let code map deleted in
let code inline(never) loopify(never) size(1) newer_version_of(helper)
      helper_1 (f : val, x : val) specialised { f = f_slot; x = x_slot }
        my_closure &my_alloc_region my_depth
        -> k * e
        : val =
  cont k (1)
in
let code inline(never) loopify(never) size(5) newer_version_of(helper)
      helper_2 (f : val, x : val) specialised { f = f_slot; x = x_slot }
        my_closure &my_alloc_region my_depth
        -> k * e
        : val =
  let r = %int_barith.mul (x, x) in
  cont k (r)
in
let code loopify(never) size(23) newer_version_of(map)
      map_1 (g : val, x : val)
        my_closure &my_alloc_region my_depth
        -> k * e
        : val =
  apply direct(helper_2 &my_alloc_region)  ($square, x) -> k_square * e
    where k_square (y : val) =
      (apply direct(helper_1 &my_alloc_region)  ($square, 1) -> k_one * e
         where k_one (one : val) =
           (apply direct(helper &my_alloc_region)
               ($double, x) -> k_double * e
              where k_double (z : val) =
                (apply direct(helper &my_alloc_region)
                    (g, x) -> k_unknown * e
                   where k_unknown (w : val) =
                     let squares = %int_barith.add (y, one) in
                     let sum = %int_barith.add (squares, z) in
                     let total = %int_barith.add (sum, w) in
                     cont k (total))))
in
let $map = closure map_1 @map &toplevel in
let $camlSpecialised_params_guard = Block 0 ($map) in
cont done ($camlSpecialised_params_guard)
