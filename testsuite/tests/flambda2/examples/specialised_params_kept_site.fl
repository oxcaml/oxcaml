(* TEST
 compile_only = "true";
 ocamlopt_flags += " -flambda2-reaper -dflambda-invariants";
 flambda2;
 native-compiler;
 setup-simple-build-env;
 program = "${ocamlsrcdir}/testsuite/tools/fexprc";
 arguments = "-dcanonical-ids ${ocamlopt_flags} -dflambda -dfexpr-annot-after=simplify ${test_file}";
 fexpr_dump_file = "simplify.fl";
 output = "kept-site-check.output";
 stdout = "kept-site.output";
 stderr = "kept-site.output";
 run;
 check-fexpr-dump;
 stdout = "${output}";
 stderr = "${output}";
 script = "sh ${test_source_directory}/check-kept-specialisation-sites.sh kept-site.output";
 script;
*)

(* The joined closure is projected, so the variables bound to both sites stay
   live although [helper] is never called. *)

let code inline(never) size(10) helper (x : val)
      my_closure &my_alloc_region my_depth -> k * e : val =
  cont k (x)
in
let code inline(never) size(10) helper2 (x : val)
      my_closure &my_alloc_region my_depth -> k * e : val =
  cont k (x)
in
let code size(50) map (b : val, x : val)
      my_closure &my_alloc_region my_depth -> k * e : val =
  let c1 = closure specialisation_site helper &my_alloc_region
  and c1b = closure specialisation_site helper2 &my_alloc_region in
  let c2 = closure specialisation_site helper &my_alloc_region
  and c2b = closure specialisation_site helper2 &my_alloc_region in
  let ub = %untag_imm (b) in
  switch ub
    | 0 -> k1 (c1)
    | 1 -> k1 (c2)
  where k1 (p : val) =
    let h2 = %project_function_slot.[helper].[helper2] (p) in
    apply &my_alloc_region h2 (x) -> k * e
in
let $map = closure map &toplevel in
let $camlSpecialised_params_kept_site = Block 0 ($map) in
cont done ($camlSpecialised_params_kept_site)
