let code square deleted in
let code inline(always) loopify(never) size(5) newer_version_of(square)
      square_1 (x : val) my_closure &my_alloc_region my_depth -> k * e : val =
  let r = %int_barith.mul (x, x) in
  cont k (r)
in
let $square = closure square_1 @square &toplevel in
let code inline(never) size(10)
      first (f : val, x : val) specialised { f = f_slot }
        my_closure &my_alloc_region my_depth
        -> k * e
        : val =
  apply &my_alloc_region f (x) -> k * e
in
let code fallback deleted in
let code inline(never) loopify(never) size(4) newer_version_of(fallback)
      fallback_1 (f : val, x : val)
        my_closure &my_alloc_region my_depth
        -> k * e
        : val =
  apply direct(first &my_alloc_region)  (f, x) -> k * e
in
let $fallback = closure fallback_1 @fallback &toplevel in
let code bridge deleted in
let code outer deleted in
let code inline(never) loopify(never) size(5) newer_version_of(first)
      first_1 (f : val, x : val) specialised { f = f_slot }
        my_closure &my_alloc_region my_depth
        -> k * e
        : val =
  let r = %int_barith.mul (x, x) in
  cont k (r)
in
let code inline(never) loopify(never) size(4) newer_version_of(bridge)
      bridge_1 (x : val) my_closure &my_alloc_region my_depth -> k * e : val =
  apply direct(first_1 &my_alloc_region)  ($square, x) -> k * e
in
let code loopify(never) size(13) newer_version_of(outer)
      outer_1 (x : val) my_closure &my_alloc_region my_depth -> k * e : val =
  let a = closure specialisation_site first_1 @first &my_alloc_region in
  let b = closure specialisation_site bridge_1 @bridge &my_alloc_region in
  apply direct(bridge_1 &my_alloc_region)  (x) -> k * e
in
let $outer = closure outer_1 @outer &toplevel in
let $camlSpecialised_params_empty_bridge =
  Block 0 ($outer, $fallback, $square)
in
cont done ($camlSpecialised_params_empty_bridge)
