let code helper deleted in
let code outer deleted in
let code inline(never) loopify(never) size(1) newer_version_of(helper)
      helper_1 (p : val, x : val)
        my_closure &my_alloc_region my_depth
        -> k * e
        : val =
  cont k (x)
in
let code inline(never) loopify(never) size(13) newer_version_of(outer)
      outer_1 (x : val) my_closure &my_alloc_region my_depth -> k * e : val =
  let site =
