(* TEST
 compile_only = "true";
 ocamlopt_flags += " -flambda2-reaper -dflambda-invariants";
 flambda2;
 setup-simple-build-env;
 fexpr with dump-reaper;
*)

(* The site escapes, but its synthetic slots must not make [captured] escape.
   Reaper poisons the unused argument and removes its allocation and hint.
   The independently live [x] hint must survive. *)

let code inline(never) size(1) helper (p : val, x : val)
      specialised { p = p_slot }
      my_closure &my_alloc_region my_depth -> k * e : val =
  cont k (x)
in
let code inline(never) size(20) outer (x : val)
      my_closure &my_alloc_region my_depth -> k * e : val =
  let captured = %block.[`0`].my_alloc_region (x) in
  let site =
    closure specialisation_site helper &my_alloc_region
      synthetic { p_slot = captured; live_slot = x }
  in
  (apply direct(helper &my_alloc_region) site (captured, x) -> after * e)
    where after (result : val) =
      let pair = %block.[`0`].my_alloc_region (site, result) in
      cont k (pair)
in
let $outer = closure outer &toplevel in
let $camlSpecialised_params_escaping_hint = Block 0 ($outer) in
cont done ($camlSpecialised_params_escaping_hint)
