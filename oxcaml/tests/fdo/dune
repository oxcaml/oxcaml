; Tests for the FDO system with pseudo-instrumentation

(executable
 (name fdo_counters_test)
 (modules fdo_counters_test)
 (libraries ocamlcommon))

; The operations on pseudo-instrumentation counters ([Fdo_counter]).

(rule
 (enabled_if
  (= %{context_name} "main"))
 (action
  (with-stdout-to
   fdo_counters_test.output
   (run ./fdo_counters_test.exe))))

(rule
 (alias runtest)
 (enabled_if
  (= %{context_name} "main"))
 (deps fdo_counters_test.expected fdo_counters_test.output)
 (action
  (diff fdo_counters_test.expected fdo_counters_test.output)))
