; Deterministic test of -fdo-profile: build a profile that marks one branch
; of hot_cold.ml hot, compile with it, and check the block frequencies.

(executable
 (name filter_fdo_dump)
 (modules filter_fdo_dump))

(rule
 (targets hot_cold.fdo)
 (deps hot_cold_profile.txt gen_profile.exe)
 (enabled_if
  (= %{context_name} "main"))
 (action
  (run ./gen_profile.exe hot_cold_profile.txt hot_cold.fdo)))

(rule
 (targets hot_cold.output.corrected)
 (deps hot_cold.ml hot_cold.fdo filter_fdo_dump.exe)
 (enabled_if
  (= %{context_name} "main"))
 (action
  (progn
   (with-outputs-to
    hot_cold.output.raw
    (run
     %{bin:ocamlopt.opt}
     -c
     -g
     -fdo-profile
     hot_cold.fdo
     -dcfg
     -dfdo
     -color
     never
     hot_cold.ml))
   (with-outputs-to
    hot_cold.output.corrected
    (run ./filter_fdo_dump.exe hot_cold.output.raw)))))

(rule
 (alias runtest)
 (enabled_if
  (= %{context_name} "main"))
 (deps hot_cold.output hot_cold.output.corrected)
 (action
  (diff hot_cold.output hot_cold.output.corrected)))

; Stability of function ids: the entry counters of anonymous.ml and of
; anonymous_more.ml (the same module with extra anonymous functions inserted,
; compiled under the same module name via -o) must agree except for the
; inserted functions.

(executable
 (name entry_counters)
 (modules entry_counters))

(rule
 (targets empty.fdo)
 (deps empty_profile.txt gen_profile.exe)
 (enabled_if
  (= %{context_name} "main"))
 (action
  (run ./gen_profile.exe empty_profile.txt empty.fdo)))

(rule
 (targets anonymous.output.corrected)
 (deps anonymous.ml anonymous_more.ml empty.fdo entry_counters.exe)
 (enabled_if
  (= %{context_name} "main"))
 (action
  (progn
   (with-outputs-to
    anonymous.dump
    (run
     %{bin:ocamlopt.opt}
     -c
     -g
     -fdo-profile
     empty.fdo
     -dfdo
     -color
     never
     anonymous.ml))
   (with-outputs-to
    anonymous_more.dump
    (run
     %{bin:ocamlopt.opt}
     -c
     -g
     -fdo-profile
     empty.fdo
     -dfdo
     -color
     never
     -o
     anonymous.more.cmx
     anonymous_more.ml))
   (with-stdout-to
    anonymous.output.corrected
    (run ./entry_counters.exe anonymous.dump anonymous_more.dump)))))

(rule
 (alias runtest)
 (enabled_if
  (= %{context_name} "main"))
 (deps anonymous.output anonymous.output.corrected)
 (action
  (diff anonymous.output anonymous.output.corrected)))

; End-to-end test through the runtime's single-stepping LBR emulator (see
; runtime/singlestep_profiler.c, x86-64 Linux only): compile specialize.ml
; with counters, run it collecting a complete trace of its hot part, decode the
; trace into a profile and check it (specialize.profile), recompile with it,
; and check the block frequencies (specialize.output).

(rule
 (enabled_if
  (and
   (= %{context_name} "main")
   (= %{architecture} "amd64")
   (= %{system} "linux")))
 (target specialize.exe)
 ; The emulator is linked from the installed runtime, which dune does not
 ; track.
 (deps specialize.ml %{project_root}/runtime/singlestep_profiler.c)
 (action
  (run
   %{bin:ocamlopt.opt}
   -O3
   -fdo-counters
   -fdo-names
   -ccopt
   -no-pie
   specialize.ml
   -o
   specialize.exe)))

(rule
 (enabled_if
  (and
   (= %{context_name} "main")
   (= %{architecture} "amd64")
   (= %{system} "linux")))
 (targets specialize.lbr specialize.run)
 (deps specialize.exe)
 (action
  (with-outputs-to
   specialize.run
   (run ./specialize.exe specialize.lbr))))

(rule
 (enabled_if
  (and
   (= %{context_name} "main")
   (= %{architecture} "amd64")
   (= %{system} "linux")))
 (target specialize.fdo)
 (deps specialize.lbr specialize.exe)
 (action
  (run
   %{bin:oxcaml-fdo-decode}
   -perf-script-output
   specialize.lbr
   -binary
   specialize.exe
   -o
   specialize.fdo)))

; The decoded profile itself: its trie of counters and counts, named after
; the executable's -fdo-names metadata.

(rule
 (enabled_if
  (and
   (= %{context_name} "main")
   (= %{architecture} "amd64")
   (= %{system} "linux")))
 (target specialize.profile.corrected)
 (deps specialize.fdo specialize.exe)
 (action
  (with-outputs-to
   specialize.profile.corrected
   (run %{bin:oxcaml-fdo-decode} -dump specialize.fdo -binary specialize.exe))))

(rule
 (alias runtest)
 (enabled_if
  (and
   (= %{context_name} "main")
   (= %{architecture} "amd64")
   (= %{system} "linux")))
 (deps specialize.profile specialize.profile.corrected)
 (action
  (diff specialize.profile specialize.profile.corrected)))

; Depends on specialize.exe so that the two compilations of specialize.ml,
; which both write specialize.cm*, are sequenced.

(rule
 (enabled_if
  (and
   (= %{context_name} "main")
   (= %{architecture} "amd64")
   (= %{system} "linux")))
 (target specialize.output.corrected)
 (deps specialize.ml specialize.fdo specialize.exe filter_fdo_dump.exe)
 (action
  (progn
   (with-outputs-to
    specialize.dump
    (run
     %{bin:ocamlopt.opt}
     -O3
     -fdo-profile
     specialize.fdo
     -dcfg
     -dfdo
     -color
     never
     -c
     specialize.ml))
   (with-outputs-to
    specialize.output.corrected
    (run ./filter_fdo_dump.exe specialize.dump)))))

(rule
 (alias runtest)
 (enabled_if
  (and
   (= %{context_name} "main")
   (= %{architecture} "amd64")
   (= %{system} "linux")))
 (deps specialize.output specialize.output.corrected)
 (action
  (diff specialize.output specialize.output.corrected)))

; The metadata follows ordinary debug splitting and compression. Keep using
; the executable for address translation, and read names/data from the sidecar.

(rule
 (targets
  specialize.exe.debug
  specialize_stripped.exe
  specialize_split.fdo
  specialize_split.profile)
 (alias runtest)
 (enabled_if
  (and
   (= %{context_name} "main")
   (= %{architecture} "amd64")
   (= %{system} "linux")))
 (deps
  specialize.exe
  specialize.lbr
  specialize.fdo
  specialize.profile.corrected)
 (action
  (progn
   (run
    %{bin:objcopy}
    --only-keep-debug
    --compress-debug-sections=zlib
    specialize.exe
    specialize.exe.debug)
   (run
    %{bin:objcopy}
    --strip-debug
    --add-gnu-debuglink=specialize.exe.debug
    specialize.exe
    specialize_stripped.exe)
   (run
    %{bin:oxcaml-fdo-decode}
    -perf-script-output
    specialize.lbr
    -binary
    specialize_stripped.exe
    -debug-file
    specialize.exe.debug
    -o
    specialize_split.fdo)
   (run cmp specialize.fdo specialize_split.fdo)
   (with-outputs-to
    specialize_split.profile
    (run
     %{bin:oxcaml-fdo-decode}
     -dump
     specialize_split.fdo
     -debug-file
     specialize.exe.debug))
   (run cmp specialize.profile.corrected specialize_split.profile)
   (ignore-outputs
    (with-accepted-exit-codes
     1
     (run
      %{bin:oxcaml-fdo-decode}
      -perf-script-output
      specialize.lbr
      -binary
      specialize_stripped.exe
      -o
      missing_metadata.fdo))))))

