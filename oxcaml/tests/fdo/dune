; End-to-end test through the runtime's single-stepping LBR emulator (see
; runtime/singlestep_profiler.c, x86-64 Linux only): compile specialize.ml
; with counters, run it collecting a complete trace of its hot part, decode the
; trace into a profile and check it (specialize.profile).

(rule
 (enabled_if
  (and
   (= %{context_name} "main")
   (= %{architecture} "amd64")
   (= %{system} "linux")))
 (target specialize.exe)
 ; The emulator is linked from the installed runtime, which dune does not
 ; track.
 (deps specialize.ml %{project_root}/runtime/singlestep_profiler.c)
 (action
  (run
   %{bin:ocamlopt.opt}
   -O3
   -fdo-counters
   -fdo-names
   -ccopt
   -no-pie
   specialize.ml
   -o
   specialize.exe)))

(rule
 (enabled_if
  (and
   (= %{context_name} "main")
   (= %{architecture} "amd64")
   (= %{system} "linux")))
 (targets specialize.lbr specialize.run)
 (deps specialize.exe)
 (action
  (with-outputs-to
   specialize.run
   (run ./specialize.exe specialize.lbr))))

(rule
 (enabled_if
  (and
   (= %{context_name} "main")
   (= %{architecture} "amd64")
   (= %{system} "linux")))
 (target specialize.fdo)
 (deps specialize.lbr specialize.exe)
 (action
  (run
   %{bin:oxcaml-fdo-decode}
   -perf-script-output
   specialize.lbr
   -binary
   specialize.exe
   -o
   specialize.fdo)))

; The decoded profile itself: its trie of counters and counts, named after
; the executable's -fdo-names metadata.

(rule
 (enabled_if
  (and
   (= %{context_name} "main")
   (= %{architecture} "amd64")
   (= %{system} "linux")))
 (target specialize.profile.corrected)
 (deps specialize.fdo specialize.exe)
 (action
  (with-outputs-to
   specialize.profile.corrected
   (run %{bin:oxcaml-fdo-decode} -dump specialize.fdo -binary specialize.exe))))

(rule
 (alias runtest)
 (enabled_if
  (and
   (= %{context_name} "main")
   (= %{architecture} "amd64")
   (= %{system} "linux")))
 (deps specialize.profile specialize.profile.corrected)
 (action
  (diff specialize.profile specialize.profile.corrected)))

; The metadata follows ordinary debug splitting and compression. Keep using
; the executable for address translation, and read names/data from the sidecar.

(rule
 (targets
  specialize.exe.debug
  specialize_stripped.exe
  specialize_split.fdo
  specialize_split.profile)
 (alias runtest)
 (enabled_if
  (and
   (= %{context_name} "main")
   (= %{architecture} "amd64")
   (= %{system} "linux")))
 (deps
  specialize.exe
  specialize.lbr
  specialize.fdo
  specialize.profile.corrected)
 (action
  (progn
   (run
    %{bin:objcopy}
    --only-keep-debug
    --compress-debug-sections=zlib
    specialize.exe
    specialize.exe.debug)
   (run
    %{bin:objcopy}
    --strip-debug
    --add-gnu-debuglink=specialize.exe.debug
    specialize.exe
    specialize_stripped.exe)
   (run
    %{bin:oxcaml-fdo-decode}
    -perf-script-output
    specialize.lbr
    -binary
    specialize_stripped.exe
    -debug-file
    specialize.exe.debug
    -o
    specialize_split.fdo)
   (run cmp specialize.fdo specialize_split.fdo)
   (with-outputs-to
    specialize_split.profile
    (run
     %{bin:oxcaml-fdo-decode}
     -dump
     specialize_split.fdo
     -debug-file
     specialize.exe.debug))
   (run cmp specialize.profile.corrected specialize_split.profile)
   (ignore-outputs
    (with-accepted-exit-codes
     1
     (run
      %{bin:oxcaml-fdo-decode}
      -perf-script-output
      specialize.lbr
      -binary
      specialize_stripped.exe
      -o
      missing_metadata.fdo))))))

