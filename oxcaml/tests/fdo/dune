; The operations on pseudo-instrumentation counters ([Fdo_counter]).

(executable
 (name fdo_counters_test)
 (modules fdo_counters_test)
 (libraries ocamlcommon))

(rule
 (alias runtest)
 (enabled_if
  (= %{context_name} "main"))
 (action
  (run ./fdo_counters_test.exe)))

(executable
 (name fdo_decode_test)
 (modules fdo_decode_test)
 (libraries fdo_decode_lib))

(rule
 (alias runtest)
 (enabled_if
  (= %{context_name} "main"))
 (action
  (run ./fdo_decode_test.exe)))

; End-to-end test through the runtime's single-stepping LBR emulator (see
; runtime/singlestep_profiler.c, x86-64 Linux only): compile specialize.ml
; with counters and run it collecting a complete trace of its hot part.

(rule
 (enabled_if
  (and
   (= %{context_name} "main")
   (= %{architecture} "amd64")
   (= %{system} "linux")))
 (target specialize.exe)
 ; The emulator is linked from the installed runtime, which dune does not
 ; track.
 (deps specialize.ml %{project_root}/runtime/singlestep_profiler.c)
 (action
  (run
   %{bin:ocamlopt.opt}
   -O3
   -fdo-counters
   -fdo-names
   -ccopt
   -no-pie
   specialize.ml
   -o
   specialize.exe)))

(rule
 (enabled_if
  (and
   (= %{context_name} "main")
   (= %{architecture} "amd64")
   (= %{system} "linux")))
 (targets specialize.lbr specialize.run)
 (deps specialize.exe)
 (action
  (with-outputs-to
   specialize.run
   (run ./specialize.exe specialize.lbr))))

