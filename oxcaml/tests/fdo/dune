; Extracting the FDO annotations from fexpr dumps.

(executable
 (name fdo_annotations)
 (modules fdo_annotations))

; Function identities ([Fdo_function_naming]). function_ids_edited.ml is
; function_ids.ml with:
; - anonymous functions inserted: other functions keep their names;
; - an optional argument added to [opt]: it keeps its name, and gains a stub;
; - the second [shadowing] removed.
; In both:
; - shadowed functions and anonymous functions with the same body get distinct
;   discriminators;
; - functions without a location (as in classes) are named by their binders.

(rule
 (targets function_ids.output.corrected)
 (deps function_ids.ml function_ids_edited.ml fdo_annotations.exe)
 (enabled_if
  (= %{context_name} "main"))
 (action
  (progn
   (run
    %{bin:ocamlopt.opt}
    -c
    -fdo-counters
    -fexpr-print-fdo-counters
    -dfexpr-annot-after
    raw
    -color
    never
    function_ids.ml)
   (run
    %{bin:ocamlopt.opt}
    -c
    -fdo-counters
    -fexpr-print-fdo-counters
    -dfexpr-annot-after
    raw
    -color
    never
    -o
    function_ids.edited.cmx
    function_ids_edited.ml)
   (with-stdout-to
    function_ids.output.corrected
    (run
     ./fdo_annotations.exe
     compare-entries
     function_ids.raw.fl
     function_ids.edited.raw.fl)))))

(rule
 (alias runtest)
 (enabled_if
  (= %{context_name} "main"))
 (deps function_ids.output function_ids.output.corrected)
 (action
  (diff function_ids.output function_ids.output.corrected)))

; Body hashes ([Fdo_body_hash]). body_hash_edited.ml changes:
; - the [keep_*] functions in ways that must keep their hashes;
; - the [change_*] functions in ways that must change them.
; Functions with the same hash in both must have the same counters.

(rule
 (targets body_hash.output.corrected)
 (deps body_hash.ml body_hash_edited.ml fdo_annotations.exe)
 (enabled_if
  (= %{context_name} "main"))
 (action
  (progn
   (run
    %{bin:ocamlopt.opt}
    -c
    -fdo-counters
    -fexpr-print-fdo-counters
    -fexpr-print-branch-annotations
    -dfexpr-annot-after
    raw
    -color
    never
    body_hash.ml)
   (run
    %{bin:ocamlopt.opt}
    -c
    -fdo-counters
    -fexpr-print-fdo-counters
    -fexpr-print-branch-annotations
    -dfexpr-annot-after
    raw
    -color
    never
    -o
    body_hash.edited.cmx
    body_hash_edited.ml)
   (with-stdout-to
    body_hash.output.corrected
    (progn
     (run
      ./fdo_annotations.exe
      compare-entries
      body_hash.raw.fl
      body_hash.edited.raw.fl)
     (run
      ./fdo_annotations.exe
      compare-counters
      body_hash.raw.fl
      body_hash.edited.raw.fl))))))

(rule
 (alias runtest)
 (enabled_if
  (= %{context_name} "main"))
 (deps body_hash.output body_hash.output.corrected)
 (action
  (diff body_hash.output body_hash.output.corrected)))

; The counters attached by [Fdo_instrumentation] during the translation from
; Lambda: edges of switches, interior and module-level calls, in nested
; functions, functors and local modules.

(rule
 (targets instrumentation.output.corrected)
 (deps instrumentation.ml fdo_annotations.exe)
 (enabled_if
  (= %{context_name} "main"))
 (action
  (progn
   (run
    %{bin:ocamlopt.opt}
    -c
    -fdo-counters
    -fexpr-print-fdo-counters
    -fexpr-print-branch-annotations
    -dflambda-heavy-invariants
    -dfexpr-annot-after
    raw
    -color
    never
    instrumentation.ml)
   (with-stdout-to
    instrumentation.output.corrected
    (run ./fdo_annotations.exe list instrumentation.raw.fl)))))

(rule
 (alias runtest)
 (enabled_if
  (= %{context_name} "main"))
 (deps instrumentation.output instrumentation.output.corrected)
 (action
  (diff instrumentation.output instrumentation.output.corrected)))

; The counters after Simplify: inlined bodies get their call site as inlining
; context, the functions of inlined functor applications are copies with their
; own counters, and the counters of removed instructions (inlined calls, folded
; switches, self tail calls) are dropped. Compilation stops after the middle
; end, so that only its dropped counters are listed. They are read from the
; dump next to the .cmx file, so OCAMLPARAM is cleared: CI's metrics job sets
; dump-dir in it, which moves the dump.

(rule
 (targets simplify.output.corrected)
 (deps simplify.ml fdo_annotations.exe)
 (enabled_if
  (= %{context_name} "main"))
 (action
  (progn
   (setenv
    OCAMLPARAM
    ""
    (run
     %{bin:ocamlopt.opt}
     -c
     -fdo-counters
     -fexpr-print-fdo-counters
     -fexpr-print-branch-annotations
     -dflambda-heavy-invariants
     -dfexpr-annot-after
     simplify
     -dfdo-dropped-counters
     -dump-into-file
     -stop-after
     middle_end
     -color
     never
     simplify.ml))
   (with-stdout-to
    simplify.output.corrected
    (progn
     (run ./fdo_annotations.exe list simplify.simplify.fl)
     (run cat simplify.cmx.dump))))))

(rule
 (alias runtest)
 (enabled_if
  (= %{context_name} "main"))
 (deps simplify.output simplify.output.corrected)
 (action
  (diff simplify.output simplify.output.corrected)))

; The same at -O3 with the reaper, after the reaper (in a directory of its own,
; so that the module keeps its name). Without local value slots, which CI may
; enable by default and which remove the code of [R.step].

(rule
 (targets simplify_o3_reaper.output.corrected)
 (deps simplify.ml fdo_annotations.exe)
 (enabled_if
  (= %{context_name} "main"))
 (action
  (progn
   (run mkdir -p o3_reaper)
   (setenv
    OCAMLPARAM
    ""
    (run
     %{bin:ocamlopt.opt}
     -c
     -O3
     -flambda2-reaper
     -no-reaper-local-fields
     -fdo-counters
     -fexpr-print-fdo-counters
     -fexpr-print-branch-annotations
     -dflambda-heavy-invariants
     -dfexpr-annot-after
     reaper
     -dfdo-dropped-counters
     -dump-into-file
     -stop-after
     middle_end
     -color
     never
     -o
     o3_reaper/simplify.cmx
     simplify.ml))
   (with-stdout-to
    simplify_o3_reaper.output.corrected
    (progn
     (run ./fdo_annotations.exe list o3_reaper/simplify.reaper.fl)
     (run cat o3_reaper/simplify.cmx.dump))))))

(rule
 (alias runtest)
 (enabled_if
  (= %{context_name} "main"))
 (deps simplify_o3_reaper.output simplify_o3_reaper.output.corrected)
 (action
  (diff simplify_o3_reaper.output simplify_o3_reaper.output.corrected)))

; The counters in Cmm: none of the Flambda translated to Cmm is lost, and none
; is added. The Cmm dumps are read from next to the .cmx files, so OCAMLPARAM is
; cleared: CI's metrics job sets dump-dir in it, which moves them (as in the
; vectorizer tests). [to_cmm.ml] is also compiled with the inline fast path of
; [caml_apply], whose two calls share the counter, and [simplify.ml] at -O3 with
; the reaper.

(rule
 (targets to_cmm.output.corrected)
 (deps to_cmm.ml simplify.ml fdo_annotations.exe)
 (enabled_if
  (= %{context_name} "main"))
 (action
  (progn
   (run mkdir -p to_cmm_fast_path to_cmm_o3_reaper)
   (setenv
    OCAMLPARAM
    ""
    (run
     %{bin:ocamlopt.opt}
     -c
     -fdo-counters
     -fexpr-print-fdo-counters
     -fexpr-print-branch-annotations
     -dfexpr-annot-after
     simplify
     -dcmm
     -dump-into-file
     -color
     never
     -o
     to_cmm.cmx
     to_cmm.ml))
   (setenv
    OCAMLPARAM
    ""
    (run
     %{bin:ocamlopt.opt}
     -c
     -caml-apply-inline-fast-path
     -fdo-counters
     -fexpr-print-fdo-counters
     -fexpr-print-branch-annotations
     -dfexpr-annot-after
     simplify
     -dcmm
     -dump-into-file
     -color
     never
     -o
     to_cmm_fast_path/to_cmm.cmx
     to_cmm.ml))
   (setenv
    OCAMLPARAM
    ""
    (run
     %{bin:ocamlopt.opt}
     -c
     -O3
     -flambda2-reaper
     -fdo-counters
     -fexpr-print-fdo-counters
     -fexpr-print-branch-annotations
     -dfexpr-annot-after
     reaper
     -dcmm
     -dump-into-file
     -color
     never
     -o
     to_cmm_o3_reaper/simplify.cmx
     simplify.ml))
   (with-stdout-to
    to_cmm.output.corrected
    (progn
     (run
      ./fdo_annotations.exe
      compare-sets
      to_cmm.simplify.fl
      to_cmm.cmx.dump)
     (run ./fdo_annotations.exe list to_cmm.cmx.dump)
     (run
      ./fdo_annotations.exe
      compare-sets
      to_cmm_fast_path/to_cmm.simplify.fl
      to_cmm_fast_path/to_cmm.cmx.dump)
     (run ./fdo_annotations.exe list to_cmm_fast_path/to_cmm.cmx.dump)
     (run
      ./fdo_annotations.exe
      compare-sets
      to_cmm_o3_reaper/simplify.reaper.fl
      to_cmm_o3_reaper/simplify.cmx.dump))))))

(rule
 (alias runtest)
 (enabled_if
  (= %{context_name} "main"))
 (deps to_cmm.output to_cmm.output.corrected)
 (action
  (diff to_cmm.output to_cmm.output.corrected)))

; The counters of the switches To_cmm turns into a table lookup or a single
; jump, which the reaper leaves for it: they are on the edges into the code the
; switch was in.

(rule
 (targets to_cmm_reaper.output.corrected)
 (deps to_cmm_reaper.ml fdo_annotations.exe)
 (enabled_if
  (= %{context_name} "main"))
 (action
  (progn
   (setenv
    OCAMLPARAM
    ""
    (run
     %{bin:ocamlopt.opt}
     -c
     -O3
     -flambda2-reaper
     -fdo-counters
     -fexpr-print-fdo-counters
     -fexpr-print-branch-annotations
     -dflambda-heavy-invariants
     -dfexpr-annot-after
     reaper
     -dcmm
     -dump-into-file
     -color
     never
     to_cmm_reaper.ml))
   (with-stdout-to
    to_cmm_reaper.output.corrected
    (progn
     (run
      ./fdo_annotations.exe
      compare-sets
      to_cmm_reaper.reaper.fl
      to_cmm_reaper.cmx.dump)
     (run ./fdo_annotations.exe list to_cmm_reaper.cmx.dump))))))

(rule
 (alias runtest)
 (enabled_if
  (= %{context_name} "main"))
 (deps to_cmm_reaper.output to_cmm_reaper.output.corrected)
 (action
  (diff to_cmm_reaper.output to_cmm_reaper.output.corrected)))

; Continuation specialization, which needs match-in-match.

(rule
 (targets specialization.output.corrected)
 (deps specialization.ml fdo_annotations.exe)
 (enabled_if
  (= %{context_name} "main"))
 (action
  (progn
   (run
    %{bin:ocamlopt.opt}
    -c
    -O3
    -flambda2-match-in-match
    -fdo-counters
    -fexpr-print-fdo-counters
    -fexpr-print-branch-annotations
    -dflambda-heavy-invariants
    -dfexpr-annot-after
    simplify
    -color
    never
    specialization.ml)
   (with-stdout-to
    specialization.output.corrected
    (run ./fdo_annotations.exe list specialization.simplify.fl)))))

(rule
 (alias runtest)
 (enabled_if
  (= %{context_name} "main"))
 (deps specialization.output specialization.output.corrected)
 (action
  (diff specialization.output specialization.output.corrected)))
