; Tests for the FDO system with pseudo-instrumentation

; The operations on pseudo-instrumentation counters ([Fdo_counter]).

(executable
 (name fdo_counters)
 (modules fdo_counters)
 (libraries ocamlcommon))

(rule
 (enabled_if
  (= %{context_name} "main"))
 (action
  (with-stdout-to
   fdo_counters.output.corrected
   (run ./fdo_counters.exe))))

(rule
 (alias runtest)
 (enabled_if
  (= %{context_name} "main"))
 (deps fdo_counters.output fdo_counters.output.corrected)
 (action
  (diff fdo_counters.output fdo_counters.output.corrected)))

; Stability of function identities ([Fdo_fingerprint]): the entry counters of
; function_ids.ml and of function_ids_edited.ml (the same module with extra anonymous
; functions inserted, compiled under the same module name via -o) must agree
; except for the inserted functions. Additionally, the discriminators should distinguish
; functions with the same name (or anonymous functions with the same body).

(executable
 (name fdo_entries)
 (modules fdo_entries))

(rule
 (targets function_ids.output.corrected)
 (deps function_ids.ml function_ids_edited.ml fdo_entries.exe)
 (enabled_if
  (= %{context_name} "main"))
 (action
  (progn
   (with-outputs-to
    function_ids.dump
    (run
     %{bin:ocamlopt.opt}
     -c
     -fdo-counters
     -drawflambda
     -color
     never
     function_ids.ml))
   (with-outputs-to
    function_ids_edited.dump
    (run
     %{bin:ocamlopt.opt}
     -c
     -fdo-counters
     -drawflambda
     -color
     never
     -o
     function_ids.edited.cmx
     function_ids_edited.ml))
   (with-stdout-to
    function_ids.output.corrected
    (run ./fdo_entries.exe function_ids.dump function_ids_edited.dump)))))

(rule
 (alias runtest)
 (enabled_if
  (= %{context_name} "main"))
 (deps function_ids.output function_ids.output.corrected)
 (action
  (diff function_ids.output function_ids.output.corrected)))
