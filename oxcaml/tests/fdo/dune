; The decoder's decisions for each sample of a trace of decode_trace.ml.

(rule
 (enabled_if
  (and
   (= %{context_name} "main")
   (= %{architecture} "amd64")
   (= %{system} "linux")))
 (target decode_trace.exe)
 ; The emulator is linked from the installed runtime, which dune does not
 ; track.
 (deps decode_trace.ml %{project_root}/runtime/singlestep_profiler.c)
 (action
  (run
   %{bin:ocamlopt.opt}
   -O3
   -fdo-counters
   -fdo-names
   -ccopt
   -no-pie
   decode_trace.ml
   -o
   decode_trace.exe)))

(rule
 (enabled_if
  (and
   (= %{context_name} "main")
   (= %{architecture} "amd64")
   (= %{system} "linux")))
 (targets decode_trace.lbr decode_trace.run)
 (deps decode_trace.exe)
 (action
  (with-outputs-to
   decode_trace.run
   (run ./decode_trace.exe decode_trace.lbr))))

(rule
 (enabled_if
  (and
   (= %{context_name} "main")
   (= %{architecture} "amd64")
   (= %{system} "linux")))
 (target decode_trace.trace.corrected)
 (deps decode_trace.lbr decode_trace.exe)
 (action
  (with-outputs-to
   decode_trace.trace.corrected
   (run
    %{bin:oxcaml-fdo-decode}
    -dump-trace
    -perf-script-output
    decode_trace.lbr
    -binary
    decode_trace.exe))))

(rule
 (alias runtest)
 (enabled_if
  (and
   (= %{context_name} "main")
   (= %{architecture} "amd64")
   (= %{system} "linux")))
 (deps decode_trace.trace decode_trace.trace.corrected)
 (action
  (diff decode_trace.trace decode_trace.trace.corrected)))

