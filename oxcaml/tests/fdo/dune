; Tests for the FDO system with pseudo-instrumentation

; The operations on pseudo-instrumentation counters ([Fdo_counter]).

(executable
 (name fdo_counters)
 (modules fdo_counters)
 (libraries ocamlcommon))

(rule
 (enabled_if
  (= %{context_name} "main"))
 (action
  (with-stdout-to
   fdo_counters.output.corrected
   (run ./fdo_counters.exe))))

(rule
 (alias runtest)
 (enabled_if
  (= %{context_name} "main"))
 (deps fdo_counters.output fdo_counters.output.corrected)
 (action
  (diff fdo_counters.output fdo_counters.output.corrected)))

; Extracting the FDO annotations from fexpr dumps.

(executable
 (name fdo_annotations)
 (modules fdo_annotations))

; Function identities ([Fdo_function_naming]). function_ids_edited.ml is
; function_ids.ml with:
; - anonymous functions inserted: other functions keep their names;
; - an optional argument added to [opt]: it keeps its name, and gains a stub;
; - the second [shadowing] removed.
; In both:
; - shadowed functions and anonymous functions with the same body get distinct
;   discriminators;
; - functions without a location (as in classes) are named by their binders.

(rule
 (targets function_ids.output.corrected)
 (deps function_ids.ml function_ids_edited.ml fdo_annotations.exe)
 (enabled_if
  (= %{context_name} "main"))
 (action
  (progn
   (run
    %{bin:ocamlopt.opt}
    -c
    -fdo-counters
    -dfexpr-annot-after
    raw
    -color
    never
    function_ids.ml)
   (run
    %{bin:ocamlopt.opt}
    -c
    -fdo-counters
    -dfexpr-annot-after
    raw
    -color
    never
    -o
    function_ids.edited.cmx
    function_ids_edited.ml)
   (with-stdout-to
    function_ids.output.corrected
    (run
     ./fdo_annotations.exe
     compare-entries
     function_ids.raw.fl
     function_ids.edited.raw.fl)))))

(rule
 (alias runtest)
 (enabled_if
  (= %{context_name} "main"))
 (deps function_ids.output function_ids.output.corrected)
 (action
  (diff function_ids.output function_ids.output.corrected)))

; Body hashes ([Fdo_body_hash]). body_hash_edited.ml changes:
; - the [keep_*] functions in ways that must keep their hashes;
; - the [change_*] functions in ways that must change them.
; Functions with the same hash in both must have the same counters.

(rule
 (targets body_hash.output.corrected)
 (deps body_hash.ml body_hash_edited.ml fdo_annotations.exe)
 (enabled_if
  (= %{context_name} "main"))
 (action
  (progn
   (run
    %{bin:ocamlopt.opt}
    -c
    -fdo-counters
    -dfexpr-annot-after
    raw
    -color
    never
    body_hash.ml)
   (run
    %{bin:ocamlopt.opt}
    -c
    -fdo-counters
    -dfexpr-annot-after
    raw
    -color
    never
    -o
    body_hash.edited.cmx
    body_hash_edited.ml)
   (with-stdout-to
    body_hash.output.corrected
    (progn
     (run
      ./fdo_annotations.exe
      compare-entries
      body_hash.raw.fl
      body_hash.edited.raw.fl)
     (run
      ./fdo_annotations.exe
      compare-counters
      body_hash.raw.fl
      body_hash.edited.raw.fl))))))

(rule
 (alias runtest)
 (enabled_if
  (= %{context_name} "main"))
 (deps body_hash.output body_hash.output.corrected)
 (action
  (diff body_hash.output body_hash.output.corrected)))

; The counters attached by [Fdo_instrumentation] during the translation from
; Lambda: edges of switches, interior and module-level calls, in nested
; functions, functors and local modules.

(rule
 (targets instrumentation.output.corrected)
 (deps instrumentation.ml fdo_annotations.exe)
 (enabled_if
  (= %{context_name} "main"))
 (action
  (progn
   (run
    %{bin:ocamlopt.opt}
    -c
    -fdo-counters
    -dflambda-heavy-invariants
    -dfexpr-annot-after
    raw
    -color
    never
    instrumentation.ml)
   (with-stdout-to
    instrumentation.output.corrected
    (run ./fdo_annotations.exe list instrumentation.raw.fl)))))

(rule
 (alias runtest)
 (enabled_if
  (= %{context_name} "main"))
 (deps instrumentation.output instrumentation.output.corrected)
 (action
  (diff instrumentation.output instrumentation.output.corrected)))

; The counters after Simplify: inlined bodies get their call site as inlining
; context, the functions of inlined functor applications are copies with their
; own counters, and the counters of removed instructions (inlined calls, folded
; switches, self tail calls) are kept on the edges into the code they were in.

(rule
 (targets simplify.output.corrected)
 (deps simplify.ml fdo_annotations.exe)
 (enabled_if
  (= %{context_name} "main"))
 (action
  (progn
   (run
    %{bin:ocamlopt.opt}
    -c
    -fdo-counters
    -dflambda-heavy-invariants
    -dfexpr-annot-after
    simplify
    -color
    never
    simplify.ml)
   (with-stdout-to
    simplify.output.corrected
    (run ./fdo_annotations.exe list simplify.simplify.fl)))))

(rule
 (alias runtest)
 (enabled_if
  (= %{context_name} "main"))
 (deps simplify.output simplify.output.corrected)
 (action
  (diff simplify.output simplify.output.corrected)))

; Continuation specialization, which needs match-in-match.

(rule
 (targets specialization.output.corrected)
 (deps specialization.ml fdo_annotations.exe)
 (enabled_if
  (= %{context_name} "main"))
 (action
  (progn
   (run
    %{bin:ocamlopt.opt}
    -c
    -O3
    -flambda2-match-in-match
    -fdo-counters
    -dflambda-heavy-invariants
    -dfexpr-annot-after
    simplify
    -color
    never
    specialization.ml)
   (with-stdout-to
    specialization.output.corrected
    (run ./fdo_annotations.exe list specialization.simplify.fl)))))

(rule
 (alias runtest)
 (enabled_if
  (= %{context_name} "main"))
 (deps specialization.output specialization.output.corrected)
 (action
  (diff specialization.output specialization.output.corrected)))
