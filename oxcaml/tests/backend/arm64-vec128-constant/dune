; ACTUAL COMPILER: Cross-target semantics and arm64 assembly coverage.
(rule
 (enabled_if
  (and
   (= %{context_name} "main")
   (or (= %{architecture} "arm64") (= %{architecture} "amd64"))))
 (targets accesses.exe accesses.cmi accesses.cmx accesses.o accesses.s)
 (deps accesses.ml)
 (action
  (setenv OCAMLPARAM ""
   (run %{bin:ocamlopt.opt} -O3 -S -extension simd -o accesses.exe accesses.ml))))

(rule
 (enabled_if
  (and
   (= %{context_name} "main")
   (or (= %{architecture} "arm64") (= %{architecture} "amd64"))))
 (targets contract.exe contract.cmi contract.cmx contract.o)
 (deps contract.ml)
 (action
  (setenv OCAMLPARAM ""
   (run %{bin:ocamlopt.opt} -O3 -o contract.exe contract.ml))))

(rule
 (alias runtest)
 (enabled_if
  (and (= %{context_name} "main") (= %{architecture} "arm64")))
 (deps check.sh accesses.s)
 (action (run bash check.sh accesses.s)))

(rule
 (alias runtest)
 (enabled_if
  (and
   (= %{context_name} "main")
   (or (= %{architecture} "arm64") (= %{architecture} "amd64"))))
 (deps accesses.exe contract.exe)
 (action
  (progn
   (run ./accesses.exe)
   (run ./contract.exe))))

(subdir default
 (rule
  (enabled_if
   (and
    (= %{context_name} "main")
    (or (= %{architecture} "arm64") (= %{architecture} "amd64"))))
  (targets accesses.ml accesses.exe accesses.cmi accesses.cmx accesses.o)
  (deps ../accesses.ml)
  (action
   (progn
    (copy ../accesses.ml accesses.ml)
    (setenv OCAMLPARAM ""
     (run %{bin:ocamlopt.opt} -extension simd -o accesses.exe accesses.ml)))))
 (rule
  (enabled_if
   (and
    (= %{context_name} "main")
    (or (= %{architecture} "arm64") (= %{architecture} "amd64"))))
  (targets contract.ml contract.exe contract.cmi contract.cmx contract.o)
  (deps ../contract.ml)
  (action
   (progn
    (copy ../contract.ml contract.ml)
    (setenv OCAMLPARAM ""
     (run %{bin:ocamlopt.opt} -o contract.exe contract.ml)))))
 (rule
  (alias runtest)
  (enabled_if
   (and
    (= %{context_name} "main")
    (or (= %{architecture} "arm64") (= %{architecture} "amd64"))))
  (deps accesses.exe contract.exe)
  (action
   (progn
    (run ./accesses.exe)
    (run ./contract.exe)))))

