(executable
 (name grep_dump)
 (libraries str)
 (modules grep_dump))

(rule
 (targets backend_attributes.output.corrected)
 (deps backend_attributes.ml grep_dump.exe)
 ; CR mvellacott: [@@@ocaml.flambda_oclassic] used to pin this test's -dcfg
 ; dump count across CI configurations (in particular, classic mode disables
 ; the vectorizer, so vectorize=1 in OCAMLPARAM added no extra dump). With
 ; classic mode disabled the attribute is inert, so clear OCAMLPARAM instead
 ; to keep the output deterministic. Remove the setenv when classic mode is
 ; re-enabled.
 (action
  (setenv OCAMLPARAM ""
   (progn
    (with-outputs-to
     backend_attributes.output.raw
     (run %{bin:ocamlopt.opt} -c -dcfg -color never -w +A-70 backend_attributes.ml))
    (with-outputs-to
     backend_attributes.output.corrected
     (run ./grep_dump.exe backend_attributes.output.raw))))))

(rule
 (alias runtest)
 (deps backend_attributes.output backend_attributes.output.corrected)
 (action
  (diff backend_attributes.output backend_attributes.output.corrected)))
