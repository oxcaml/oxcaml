; AVX512 intrinsics tests: each emitted intrinsic is checked bit-for-bit against
; the real C intrinsic (the C compiler is the oracle). The test sources are
; generated by tools/simdgen from the same data as the selection table: gen512
; covers the register forms and gen512_mem the loads, stores, gathers, and
; scatters. Each is also built with -internal-assembler, cross-checking the
; binary emitter's EVEX encodings against GAS. Enabled on amd64 non-macos in the
; main context, like the other AVX512 tests.
;
; The C oracles must be compiled by clang: the host gcc (8.5) lacks many of the
; newer AVX512 intrinsic names. Without clang, the stubs are built with %{cc}
; and no AVX512 flags, which makes every oracle an aborting stub (so that the
; executables still link), and the tests do not run. The run rule execs the
; tests only if the host CPU and OS support AVX512 (see
; ../avx512_available.exe), leaving empty output otherwise.

(rule
 (targets gen512.ml)
 (deps
  (:gen %{workspace_root}/tools/simdgen/simdgen.exe)
  (:csv %{workspace_root}/tools/simdgen/amd64/amd64.csv)
  (:xml %{workspace_root}/tools/simdgen/x86-intel.xml))
 (enabled_if
  (and
   (= %{context_name} "main")
   (= %{architecture} "amd64")
   (<> %{system} macosx)))
 (action
  (with-stdout-to
   %{targets}
   (run %{gen} intrins tests-ml %{csv} %{xml}))))

(rule
 (targets gen512_mem.ml)
 (deps
  (:gen %{workspace_root}/tools/simdgen/simdgen.exe)
  (:csv %{workspace_root}/tools/simdgen/amd64/amd64.csv)
  (:xml %{workspace_root}/tools/simdgen/x86-intel.xml))
 (enabled_if
  (and
   (= %{context_name} "main")
   (= %{architecture} "amd64")
   (<> %{system} macosx)))
 (action
  (with-stdout-to
   %{targets}
   (run %{gen} intrins tests-mem-ml %{csv} %{xml}))))

(rule
 (targets gen512_stubs.c)
 (deps
  (:gen %{workspace_root}/tools/simdgen/simdgen.exe)
  (:csv %{workspace_root}/tools/simdgen/amd64/amd64.csv)
  (:xml %{workspace_root}/tools/simdgen/x86-intel.xml))
 (enabled_if
  (and
   (= %{context_name} "main")
   (= %{architecture} "amd64")
   (<> %{system} macosx)))
 (action
  (with-stdout-to
   %{targets}
   (run %{gen} intrins tests-c %{csv} %{xml}))))

(rule
 (targets gen512_ia.ml)
 (enabled_if
  (and
   (= %{context_name} "main")
   (= %{architecture} "amd64")
   (<> %{system} macosx)))
 (action
  (copy gen512.ml %{targets})))

(rule
 (targets gen512_mem_ia.ml)
 (enabled_if
  (and
   (= %{context_name} "main")
   (= %{architecture} "amd64")
   (<> %{system} macosx)))
 (action
  (copy gen512_mem.ml %{targets})))

(rule
 (targets libgen512stubs.a)
 (deps helpers.c gen512_stubs.c (source_tree %{workspace_root}/runtime/caml))
 (enabled_if
  (and
   (= %{context_name} "main")
   (= %{architecture} "amd64")
   (<> %{system} macosx)
   %{bin-available:clang}))
 (action
  (progn
   (run clang -c -O2 -mavx512f -mavx512vl -mavx512dq -mavx512bw -mavx512cd
     -I %{workspace_root}/runtime helpers.c gen512_stubs.c)
   (run ar rcs %{targets} helpers.o gen512_stubs.o))))

(rule
 (targets libgen512stubs.a)
 (deps helpers.c gen512_stubs.c (source_tree %{workspace_root}/runtime/caml))
 (enabled_if
  (and
   (= %{context_name} "main")
   (= %{architecture} "amd64")
   (<> %{system} macosx)
   (not %{bin-available:clang})))
 (action
  (progn
   (run %{cc} -c -I %{workspace_root}/runtime helpers.c gen512_stubs.c)
   (run ar rcs %{targets} helpers.o gen512_stubs.o))))

(executables
 (names gen512 gen512_mem)
 (modules gen512 gen512_mem)
 (enabled_if
  (and
   (= %{context_name} "main")
   (= %{architecture} "amd64")
   (<> %{system} macosx)))
 (ocamlopt_flags
  (:standard -extension simd_alpha -favx512f -favx512vl -favx512dq -favx512bw))
 (libraries stdlib_stable stdlib_upstream_compatible)
 (foreign_archives gen512stubs))

(executables
 (names gen512_ia gen512_mem_ia)
 (modules gen512_ia gen512_mem_ia)
 (enabled_if
  (and
   (= %{context_name} "main")
   (= %{architecture} "amd64")
   (<> %{system} macosx)))
 (ocamlopt_flags
  (:standard -extension simd_alpha -favx512f -favx512vl -favx512dq -favx512bw
   -internal-assembler))
 (libraries stdlib_stable stdlib_upstream_compatible)
 (foreign_archives gen512stubs))

(rule
 (alias runtest)
 (enabled_if
  (and
   (= %{context_name} "main")
   (= %{architecture} "amd64")
   (<> %{system} macosx)
   %{bin-available:clang}))
 (deps
  ../avx512_available.exe
  gen512.exe
  gen512_ia.exe
  gen512_mem.exe
  gen512_mem_ia.exe)
 (action
  (with-outputs-to
   gen512.out
   (run bash -c
    "if ../avx512_available.exe; then for t in gen512 gen512_ia gen512_mem gen512_mem_ia; do ./$t.exe || echo \"$t.exe exited with $?\"; done; fi"))))

(rule
 (alias runtest)
 (enabled_if
  (and
   (= %{context_name} "main")
   (= %{architecture} "amd64")
   (<> %{system} macosx)
   %{bin-available:clang}))
 (action
  (diff empty.expected gen512.out)))
