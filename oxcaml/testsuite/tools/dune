(library
 (name expectcommon)
 (modes byte native)
 (libraries ocamlfrontend)
 (modules expectcommon))

(executable
 (name expect)
 (modes byte)
 (libraries expectcommon ocamltoplevel)
 (flags (:standard -linkall))
 (modules expect))

(executable
 (name expectnat)
 (modes native)
 (libraries expectcommon ocamlopttoplevel)
 (flags (:standard -linkall))
 (modules expectnat))

(ocamllex
 (modules lexcmm))

(ocamlyacc
 (modules parsecmm))

(executable
 (name codegen_main)
 (modes native)
 (libraries ocamlfrontend ocamloptcomp unix)
 (modules codegen_main codegen_host_variant lexcmm parsecmm parsecmmaux))

; The codegen variant of this context, for which codegen_main generates
; code: it takes no option that selects one. These are the constants that
; the _build/_bootinstall recipe in Makefile.common-ox generates for
; otherlibs/dynlink.
(rule
 (targets codegen_host_variant.ml)
 (action
  (copy
   %{project_root}/duneconf/dynlink_host_variant_%{context_name}.ml
   %{targets})))

; What ocamltest runs for the native tests that compile inside a tool
; (expect.opt and the asmgen tests), built for a codegen variant: the
; install_for_test recipe in Makefile.common-ox puts them where ocamltest
; looks for the tools of that variant. Only enabled in the codegen-variant
; contexts; see otherlibs/unix/dune. The stanzas of the same name in
; toplevel/native and testsuite/lib add the native toplevel and the
; libraries of the tests.
(alias
 (name codegen-variant-test-hosts)
 (enabled_if
  (and
   (<> %{context_name} "default")
   (<> %{context_name} "main")))
 (deps expectnat.exe codegen_main.exe))

(rule
 (targets asmgen_arm64.o)
 (deps asmgen_arm64.S)
 (action
  (bash
   "%{env:ASPP=aspp-env-var-not-set} %{env:ASPPFLAGS=asppflags-env-var-not-set} -DSYS_%{env:SYSTEM=system-env-var-not-set} -DMODEL_%{env:MODEL=model-env-var-not-set} -o asmgen_arm64.o asmgen_arm64.S")))

(rule
 (targets asmgen_amd64.o)
 (deps asmgen_amd64.S)
 (action
  (bash
   "%{env:ASPP=aspp-env-var-not-set} %{env:ASPPFLAGS=asppflags-env-var-not-set} -DSYS_%{env:SYSTEM=system-env-var-not-set} -DMODEL_%{env:MODEL=model-env-var-not-set} -o asmgen_amd64.o asmgen_amd64.S")))
