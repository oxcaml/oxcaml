(library
 (name expectcommon)
 (modes byte native)
 (libraries ocamlcommon)
 (modules expectcommon))

(executable
 (name expect)
 (modes byte)
 (libraries expectcommon ocamltoplevel)
 (flags (:standard -linkall))
 (modules expect))

(executable
 (name expectnat)
 (modes native)
 (libraries expectcommon ocamlopttoplevel)
 (flags (:standard -linkall))
 (modules expectnat))

; Used only by [make runtest-upstream-boot]; see compiler_shim.ml.
(executable
 (name compiler_shim)
 (modes byte)
 (modules compiler_shim))

(ocamllex
 (modules lexcmm))

(ocamlyacc
 (modules parsecmm))

(executable
 (name codegen_main)
 (modes native)
 (libraries ocamlcommon ocamloptcomp unix)
 (modules codegen_main lexcmm parsecmm parsecmmaux))

(rule
 (targets asmgen_arm64.o)
 (deps asmgen_arm64.S)
 (action
  (bash
   "%{env:ASPP=aspp-env-var-not-set} %{env:ASPPFLAGS=asppflags-env-var-not-set} -DSYS_%{env:SYSTEM=system-env-var-not-set} -DMODEL_%{env:MODEL=model-env-var-not-set} -o asmgen_arm64.o asmgen_arm64.S")))

(rule
 (targets asmgen_amd64.o)
 (deps asmgen_amd64.S)
 (action
  (bash
   "%{env:ASPP=aspp-env-var-not-set} %{env:ASPPFLAGS=asppflags-env-var-not-set} -DSYS_%{env:SYSTEM=system-env-var-not-set} -DMODEL_%{env:MODEL=model-env-var-not-set} -o asmgen_amd64.o asmgen_amd64.S")))
