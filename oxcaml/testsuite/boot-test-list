# Tests excluded from [make runtest-upstream-boot], which tests the boot
# compiler's native binaries and only builds the stdlib (and the stdlib_*
# universes), the bytecode compiler-libs (for the expect tool, the byte
# toplevel and the byte tools), the testsuite support libraries, and — in
# the boot context, by the system compiler — fexprc and codegen. Neither
# the otherlibs (unix, str, threads, runtime_events, dynlink, eval) nor
# native compiler-libs built by the boot compiler (needed by expectnat and
# ocamlnat) are available.
#
# Only directories where most tests require the missing pieces are excluded;
# directories where only a few tests do are kept, so a small number of
# failures is expected in this mode (in particular the few expect.opt tests
# outside of excluded directories, which need expectnat; note that the
# toplevel.opt tests fail in the regular flow too, which does not build
# ocamlnat either).
#
# excluded test                  | reason for not running
# ------------------------------------------------------------------------------------------------
  tests/ast-invariants           | links the native compiler-libs
  tests/codegen                  | expect.opt tests, require expectnat
  tests/language-extensions      | links the native compiler-libs
  tests/lib-bigarray-file        | requires unix
  tests/lib-domain               | requires threads
  tests/lib-dynlink-bytecode     | requires dynlink
  tests/lib-dynlink-init-info    | requires dynlink
  tests/lib-dynlink-initializers | requires dynlink
  tests/lib-dynlink-native       | requires dynlink
  tests/lib-dynlink-packed       | requires dynlink
  tests/lib-dynlink-private      | requires dynlink
  tests/lib-dynlink-pr4229       | requires dynlink
  tests/lib-dynlink-pr4839       | requires dynlink
  tests/lib-dynlink-pr6950       | requires dynlink
  tests/lib-dynlink-pr9209       | requires dynlink
  tests/lib-runtime-events       | requires runtime_events
  tests/lib-scanf-2              | requires unix
  tests/lib-str                  | requires str
  tests/lib-systhreads           | requires threads
  tests/lib-threads              | requires threads
  tests/lib-unix                 | requires unix
  tests/manifests                | links the native compiler-libs
  tests/parallel                 | requires unix and threads
  tests/quotation                | requires the eval library (ocaml-jit)
  tests/tool-debugger            | requires ocamldebug
  tests/tool-expect-test         | requires expectnat and unix
  tests/tool-ocamlfilt           | requires the native ocamlfilt
