; Link time optimisation of ocamlopt itself, expressed with explicit rules.
;
; The ordinary build of the main context already compiles every unit with
; -support-lto (see the lto=yes variable in Makefile.common-ox), which makes
; each .cmx carry the Reaper's link time optimisation information. On top of
; that, the rules below run the two remaining phases and relink:
;
;   * one serial "solve" over every .cmx of the program, producing
;     program.ltosol, the Reaper's whole-program solution;
;   * one "rebuild" per library, which is where the solution is applied: each
;     unit is recompiled from the Flambda 2 term stored in its .cmx, and the
;     results are re-archived into <library>.lto.cmxa. The rebuild of a unit
;     needs nothing but its own .cmx and program.ltosol, so these rules are
;     independent of one another and run in parallel. The rebuild runs the
;     backend again, so each rule passes (after "--") the backend-relevant
;     flags of the library's ordinary compilation in the main context: -g and
;     -directory from (flags ...), -O3 and -fno-asan from (ocamlopt_flags ...)
;     and, for the libraries that include ocamlopt_flags.sexp, the
;     -function-sections it contains;
;   * a link of the reaped archives into ocamlopt_lto.exe.
;
; Everything below the solve rule is mechanical, one block per library. The
; set of libraries, the order they are linked in and the flags they were
; compiled with are the only things a rule cannot work out for itself, so they
; are transcribed here from
;
;   dune rules --root=. --workspace=duneconf/main.ws oxcaml_main_native.exe
;
; and have to be updated when the libraries of ocamlopt or their flags change.
; Teaching Dune itself about LTO, so that it derives all of this from
; (libraries ...), would remove the need for this file.
;
; Build it with
;   rm -f duneconf/main.ws && rm -rf _build
;   make lto=yes lto-compiler
;
; Do not invoke dune directly on the @lto alias: the root dune file selects the
; backend with (copy_files# "backend/%{env:ARCH=amd64}/..."), so a dune command
; that does not inherit ARCH from the Makefile silently recompiles the backend
; for amd64, and the resulting compiler emits x86-64 assembly on an arm64 host.

(executable
 (name lto_helper)
 (modes native)
 (modules lto_helper)
 (libraries ocamloptcomp))

; The solve is the one phase that cannot be split up: it reasons about the
; program as a whole.
(rule
 (targets program.ltosol)
 (deps
  (glob_files ../../otherlibs/unix/.unix.objs/native/*.cmx)
  (glob_files ../../external/memtrace/src/.memtrace.objs/native/*.cmx)
  (glob_files ../../middle_end/flambda2/numbers/floats/.flambda2_floats.objs/native/*.cmx)
  (glob_files ../../.ocamlcommon.objs/native/*.cmx)
  (glob_files ../../.ocamlfrontend.objs/native/*.cmx)
  (glob_files ../../.ocamlbytecomp.objs/native/*.cmx)
  (glob_files ../../backend/debug/dwarf/dwarf_flags/.dwarf_flags.objs/native/*.cmx)
  (glob_files ../../backend/asm_targets/.asm_targets.objs/native/*.cmx)
  (glob_files ../../backend/arm64/ast/.arm64_ast.objs/native/*.cmx)
  (glob_files ../../backend/binary_emitter_intf/.binary_emitter_intf.objs/native/*.cmx)
  (glob_files ../../backend/arm64/binary_emitter/.arm64_binary_emitter.objs/native/*.cmx)
  (glob_files ../../.oxcaml_common.objs/native/*.cmx)
  (glob_files ../../middle_end/flambda2/algorithms/.flambda2_algorithms.objs/native/*.cmx)
  (glob_files ../../middle_end/flambda2/ui/.flambda2_ui.objs/native/*.cmx)
  (glob_files ../../middle_end/flambda2/datalog/.flambda2_datalog.objs/native/*.cmx)
  (glob_files ../../middle_end/flambda2/numbers/.flambda2_numbers.objs/native/*.cmx)
  (glob_files ../../middle_end/flambda2/kinds/.flambda2_kinds.objs/native/*.cmx)
  (glob_files ../../middle_end/flambda2/import/.flambda2_import.objs/native/*.cmx)
  (glob_files ../../middle_end/flambda2/identifiers/.flambda2_identifiers.objs/native/*.cmx)
  (glob_files ../../middle_end/flambda2/nominal/.flambda2_nominal.objs/native/*.cmx)
  (glob_files ../../middle_end/flambda2/bound_identifiers/.flambda2_bound_identifiers.objs/native/*.cmx)
  (glob_files ../../middle_end/flambda2/lattices/.flambda2_lattices.objs/native/*.cmx)
  (glob_files ../../middle_end/flambda2/term_basics/.flambda2_term_basics.objs/native/*.cmx)
  (glob_files ../../middle_end/flambda2/classic_mode_types/.flambda2_classic_mode_types.objs/native/*.cmx)
  (glob_files ../../middle_end/flambda2/types/.flambda2_types.objs/native/*.cmx)
  (glob_files ../../middle_end/flambda2/terms/.flambda2_terms.objs/native/*.cmx)
  (glob_files ../../middle_end/flambda2/simplify_shared/.flambda2_simplify_shared.objs/native/*.cmx)
  (glob_files ../../middle_end/flambda2/cmx/.flambda2_cmx.objs/native/*.cmx)
  (glob_files ../../external/owee/.compiler_owee.objs/native/*.cmx)
  (glob_files ../../external/gc-timings/.gc_timings.objs/native/*.cmx)
  (glob_files ../../backend/debug/dwarf/dwarf_low/.dwarf_low.objs/native/*.cmx)
  (glob_files ../../backend/debug/dwarf/dwarf_high/.dwarf_high.objs/native/*.cmx)
  (glob_files ../../.ocamloptcomp.objs/native/*.cmx)
  (glob_files ../../middle_end/flambda2/from_lambda/.flambda2_from_lambda.objs/native/*.cmx)
  (glob_files ../../middle_end/flambda2/parser/.flambda2_parser.objs/native/*.cmx)
  (glob_files ../../middle_end/flambda2/simplify/.flambda2_simplify.objs/native/*.cmx)
  (glob_files ../../middle_end/flambda2/to_cmm/.flambda2_to_cmm.objs/native/*.cmx)
  (glob_files ../../middle_end/flambda2/to_jsir/jsoo_imports/.jsoo_imports.objs/native/*.cmx)
  (glob_files ../../middle_end/flambda2/to_jsir/.flambda2_to_jsir.objs/native/*.cmx)
  (glob_files ../../middle_end/flambda2/reaper/.flambda2_reaper.objs/native/*.cmx)
  (glob_files ../../middle_end/flambda2/.flambda2.objs/native/*.cmx)
  (glob_files ../../.oxcaml_main_native.eobjs/native/*.cmx))
 (action
  (run %{ocamlopt} -reaper-solve %{deps} -o program.ltosol)))

(rule
 (targets unix.lto.cmxa unix.lto.a)
 (deps
  program.ltosol
  ../../otherlibs/unix/unix.cmxa
  (glob_files ../../otherlibs/unix/.unix.objs/native/*.cmx))
 (action
  (run
   ./lto_helper.exe
   -ocamlopt %{ocamlopt}
   -ltosol program.ltosol
   -archive ../../otherlibs/unix/unix.cmxa
   -o unix.lto.cmxa
   %{deps}
   -- -g -O3 -fno-asan -directory compiler-distro -function-sections)))

