  ../../external/owee/compiler_owee.cmxa
  (glob_files ../../external/owee/.compiler_owee.objs/native/*.cmx))
 (action
  (run
   ./lto_helper.exe
   -ocamlopt %{ocamlopt}
   -ltosol program.ltosol
   -archive ../../external/owee/compiler_owee.cmxa
   -o compiler_owee.lto.cmxa
   %{deps}
   -- -g -O3 -fno-asan -directory compiler-distro)))

