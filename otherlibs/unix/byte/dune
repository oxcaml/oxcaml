; Byte-only "internal" build of the unix modules with NO C stubs, whose .cma
; records the runtime-id *suffixed* stub name via -dllib-suffixed. Because this
; library is byte-only, library_flags reach only "ocamlc -a" (not "ocamlopt -a",
; which rejects -dllib-suffixed). The compiler's own bytecode tools link this
; (rather than the plain-stubbed unix library) so they load only this version's
; dllunix_stubs. The C stubs (.a and .so) come from the sibling unix library.

(copy_files ../unix.mli)
(copy_files ../unixLabels.mli)
(copy_files ../unix.ml)
(copy_files ../unixLabels.ml)

(library
 (name unix_byte)
 (wrapped false)
 (modes byte)
 (flags
  (:standard
   -absname
   -bin-annot
   -g
   -safe-string
   -strict-sequence
   -strict-formats
   -nolabels ; for UnixLabels
   ))
 (modules unix unixLabels)
 (library_flags
  (:standard -linkall -dllib-suffixed -lunix_stubs -cclib -lunix_stubs)))

; Builds the suffixed dllunix_stubs-<target>-<id>.so (copy of the sibling unix
; library's plain one) that the compiler opens to check primitives when linking
; a bytecode tool against this library. Generated by Makefile.common-ox because
; the suffixed filename is a build-configuration value.
(include stubdll.inc)
