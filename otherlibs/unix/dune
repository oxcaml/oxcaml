(copy_files# caml/*.h)

(library
 (name unix)
 ; Public for the libraries of external/ast-dependent-libs (see
 ; dune-project), in every context but the boot one (the main context and
 ; the codegen-variant contexts, which rebuild this library per variant):
 ; in the boot context, other projects such as merlin get the unix library
 ; of the system compiler.
 (public_name unix)
 (enabled_if
  (<> %{context_name} default))
 (wrapped false)
 (modes byte native)
 (flags
  (:standard
   -absname
   -bin-annot
   -g
   -safe-string
   -strict-sequence
   -strict-formats
   -nolabels ; for UnixLabels
   ))
 ; The build contexts compile with -fno-asan, which keeps the compiler's
 ; own code uninstrumented (see Makefile.common-ox). This library is for
 ; user programs, so in an AddressSanitizer variant it is instrumented.
 (ocamlopt_flags
  (:standard (:include %{project_root}/ocamlopt_flags.sexp) \ -fno-asan))
 (library_flags (:standard -linkall))
 (modules unix unixLabels)
 (foreign_stubs (language c) (names
   accept_unix
   access
   addrofstr
   alarm
   bind_unix
   channels_unix
   chdir
   chmod
   chown
   chroot
   close_unix
   closedir
   connect_unix
   cst2constr
   cstringv
   dup2
   dup_unix
   envir_unix
   errmsg_unix
   execv
   execve
   execvp
   exit
   fchmod
   fchown
   fcntl
   fork
   fsync
   ftruncate
   getaddrinfo
   getcwd
   getegid
   geteuid
   getgid
   getgr
   getgroups
   gethost
   gethostname
   getlogin
   getnameinfo
   getpeername_unix
   getpid_unix
   getppid
   getproto
   getpw
   getserv
   getsockname_unix
   gettimeofday
   getuid
   gmtime
   initgroups
   isatty_unix
   itimer
   kill
   link_unix
   listen_unix
   lockf_unix
   lseek_unix
   mkdir
   mkfifo
   mmap_ba
   mmap_unix
   nice
   open_unix
   opendir
   pipe_unix
   putenv
   read_unix
   readdir
   readlink_unix
   realpath_unix
   rename_unix
   rewinddir
   rmdir
   select_unix
   sendrecv_unix
   setgid
   setgroups
   setsid
   setuid
   shutdown_unix
   signals
   sleep_unix
   socket_unix
   socketaddr
   socketpair_unix
   sockopt_unix
   spawn
   stat_unix
   strofaddr
   symlink_unix
   termios
   time
   times_unix
   truncate_unix
   umask
   unixsupport_unix
   unlink
   utimes_unix
   wait
   write_unix
   )
   ; OC_CFLAGS_SEXP names the C flags of the context: a codegen-variant
   ; context compiles its stubs with the C flags of its variant (see
   ; VARIANT_ENV_VARS in Makefile.common-ox).
   (flags ((:include %{project_root}/%{env:OC_CFLAGS_SEXP=oc_cflags.sexp})
           (:include %{project_root}/sharedlib_cflags.sexp)
           (:include %{project_root}/oc_cppflags.sexp)))
 ))

(install
  (files
    (.unix.objs/native/unix.cmx as unix/unix.cmx)
    (.unix.objs/native/unixLabels.cmx as unix/unixLabels.cmx)
    (unix.cmxa as unix/unix.cmxa)
    (unix.a as unix/unix.a)
    (unix.cma as unix/unix.cma)
    (.unix.objs/byte/unix.cmi as unix/unix.cmi)
    (.unix.objs/byte/unix.cmt as unix/unix.cmt)
    (.unix.objs/byte/unix.cmti as unix/unix.cmti)
    (.unix.objs/byte/unixLabels.cmi as unix/unixLabels.cmi)
    (.unix.objs/byte/unixLabels.cmt as unix/unixLabels.cmt)
    (.unix.objs/byte/unixLabels.cmti as unix/unixLabels.cmti)
    (unix.cmxs as unix/unix.cmxs)
    (unix.mli as unix/unix.mli)
    (unixLabels.mli as unix/unixLabels.mli)
    (libunix_stubs.a as unix/libunix_stubs.a)
    (libunix_stubs.a as libunix_stubs_native.a) ; for special_dune compat
    (dllunix_stubs.so as stublibs/dllunix_stubs.so)
    (socketaddr.h as caml/socketaddr.h)
    (unixsupport.h as caml/unixsupport.h)
    (META as unix/META)
  )
  (section lib)
  (package ocaml))


(alias
 (name C-only)
 (deps libunix_stubs.a dllunix_stubs.so))

; A check that the C flags above, which every stub stanza of the compiler's
; libraries has, are those of this context's codegen variant: the file fails
; to compile otherwise (see codegen_variant_stub_macros.c). The last line of
; flags says what the context's variant is; its files come from the
; _build/_bootinstall recipe in Makefile.common-ox. Only in the
; codegen-variant contexts, where the alias below builds it with the
; libraries.
(foreign_library
 (archive_name codegen_variant_stub_macros)
 (language c)
 (names codegen_variant_stub_macros)
 (enabled_if
  (and (<> %{context_name} "default") (<> %{context_name} "main")))
 (flags
  ((:include %{project_root}/%{env:OC_CFLAGS_SEXP=oc_cflags.sexp})
   (:include %{project_root}/sharedlib_cflags.sexp)
   (:include %{project_root}/oc_cppflags.sexp)
   (:include %{project_root}/duneconf/stub_macros_%{context_name}.sexp))))

; Native artifacts harvested into the codegen-variant library trees
; (lib/ocaml/variants/<name>/) by the _install recipe in Makefile.common-ox.
; Only enabled in the codegen-variant contexts (the complement of the
; default and main contexts), which compile with the variant's per-axis
; flags (see Makefile.common-ox and
; %{project_root}/duneconf/ocamlopt_flags_main-<name>.sexp).
(alias
 (name codegen-variant-libs)
 (enabled_if
  (and (<> %{context_name} "default") (<> %{context_name} "main")))
 (deps unix.cmxa unix.a unix.cmxs libunix_stubs.a
  codegen_variant_stub_macros.o))

(rule
  (targets unix.ml)
  (mode fallback)
  (action
    (bash
      "echo %{targets} should have been generated by ./configure >&2; exit 1")))
