;; config.status isn't needed for the rule, the -o config.status allows the rule
;; to run in an unconfigured tree.
(rule
 (targets build_settings.txt ld.conf)
 (deps
  ../../Makefile.upstream ../../Makefile.common ../../Makefile.config_if_required
  ../../Makefile.build_config ../../Makefile.config ../../Makefile.best_binaries
  ../../Makefile.menhir ../../.depend.menhir ../../Makefile.dev ../StdlibModules)
 (action (chdir ../../ (run make -s -o config.status -f Makefile.upstream V=1 COMPUTE_DEPS=false stdlib/dune_rules/build_settings.txt stdlib/dune_rules/ld.conf))))

(executable
 (name gen)
 (modules gen)
 (modes native))

(rule
 (target runtime.dune)
 (enabled_if (= %{context_name} default))
 (action
   (with-stdout-to %{target} (run
     %{dep:gen.exe}
     %{dep:build_settings.txt}
     runtime))))

(rule
 (target stdlib_module_deps.txt)
 (deps (:stdlib (glob_files ../*.ml) (glob_files ../*.mli)))
 (action (with-stdout-to %{target} (chdir .. (run %{dep:../../tools/ocamldep.exe} -one-line -as-map %{stdlib})))))

;; stdlib.dune needs ocamldep which cannot be built in an unconfigured tree. In
;; an unconfigured tree ../META will be empty.
(rule
 (target stdlib.dune)
 (enabled_if (and (= %{context_name} default) (<> %{read:../META} "")))
 (action
   (with-stdout-to %{target} (run
     %{dep:gen.exe}
     %{dep:build_settings.txt}
     stdlib
     %{dep:stdlib_module_deps.txt}))))

(rule
 (target stdlib.dune)
 (enabled_if (and (= %{context_name} default) (= %{read:../META} "")))
 (action (write-file %{target} "")))

;; Codegen-variant (frame-pointer) stdlib trees. These are generated like
;; stdlib.dune, but gen.exe emits rules only for the frame-pointer mode
;; OPPOSITE to the configure default (and only when codegen variants are
;; enabled); the other file contains just an empty @stdlib_fp/@stdlib_base
;; alias. See the comment on write_stdlib_dune in gen.ml.
(rule
 (target stdlib_fp.dune)
 (enabled_if (and (= %{context_name} default) (<> %{read:../META} "")))
 (action
   (with-stdout-to %{target} (run
     %{dep:gen.exe}
     %{dep:build_settings.txt}
     stdlib_fp
     %{dep:stdlib_module_deps.txt}))))

(rule
 (target stdlib_fp.dune)
 (enabled_if (and (= %{context_name} default) (= %{read:../META} "")))
 (action (write-file %{target} "")))

(rule
 (target stdlib_base.dune)
 (enabled_if (and (= %{context_name} default) (<> %{read:../META} "")))
 (action
   (with-stdout-to %{target} (run
     %{dep:gen.exe}
     %{dep:build_settings.txt}
     stdlib_base
     %{dep:stdlib_module_deps.txt}))))

(rule
 (target stdlib_base.dune)
 (enabled_if (and (= %{context_name} default) (= %{read:../META} "")))
 (action (write-file %{target} "")))

;; In the main build (and any other non-boot context, e.g. the main-fp
;; codegen-variant context), don't rebuild the runtime and stdlib
(rule
 (target runtime.dune)
 (enabled_if (<> %{context_name} default))
 (action
   (with-stdout-to %{target} (run
     %{dep:gen.exe}
     %{dep:build_settings.txt}
     primitives))))
(rule
 (target stdlib.dune)
 (enabled_if (<> %{context_name} default))
 (action (write-file %{target} "")))
(rule
 (target stdlib_fp.dune)
 (enabled_if (<> %{context_name} default))
 (action (write-file %{target} "")))
(rule
 (target stdlib_base.dune)
 (enabled_if (<> %{context_name} default))
 (action (write-file %{target} "")))
