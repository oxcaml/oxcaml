;; In the main build (and any other non-boot context, e.g. the main-<name>
;; codegen-variant contexts), don't rebuild the runtime and stdlib
(rule
 (target runtime.dune)
 (enabled_if (<> %{context_name} default))
 (action
   (with-stdout-to %{target} (run
     %{dep:gen.exe}
     %{dep:build_settings.txt}
     primitives))))
