(subdir build (dynamic_include ../dune_rules/stdlib.dune))

;; Codegen-variant stdlib trees, statically enumerated for the closed
;; curated name set (dune subdir stanzas cannot be generated). Only the
;; trees named in the configure-computed variant list contain build rules;
;; every other one (the configure default, a name that configure did not
;; select, or all of them with --disable-codegen-variants) contains only an
;; empty @stdlib_<name> alias. See stdlib/dune_rules/gen.ml.
(subdir build_base (dynamic_include ../dune_rules/stdlib_base.dune))
(subdir build_fp (dynamic_include ../dune_rules/stdlib_fp.dune))
(subdir build_sc (dynamic_include ../dune_rules/stdlib_sc.dune))
(subdir build_poll (dynamic_include ../dune_rules/stdlib_poll.dune))
(subdir build_asan-fp (dynamic_include ../dune_rules/stdlib_asan-fp.dune))
(subdir build_asan-fp-poll
  (dynamic_include ../dune_rules/stdlib_asan-fp-poll.dune))
(subdir build_fp-poll (dynamic_include ../dune_rules/stdlib_fp-poll.dune))
(subdir build_fp-poll-sc
  (dynamic_include ../dune_rules/stdlib_fp-poll-sc.dune))
(subdir build_fp-sc (dynamic_include ../dune_rules/stdlib_fp-sc.dune))
(subdir build_poll-sc (dynamic_include ../dune_rules/stdlib_poll-sc.dune))

;; Write an empty file in an unconfigured tree
(rule (target META) (mode fallback) (action (write-file %{target} "")))

;; We're trying to copy a few files around, but copy_files triggers a bug
;; in dependency cycle detection when in a statically visible dune stanza.
;; So here's a weird workaround, to hide copy_files inside dynamic_include.
;; See https://github.com/ocaml/dune/issues/16516
(subdir copy_workaround
  (rule (target headers.dune) (action (write-file %{target} "(copy_files ../../../runtime/caml/*.{h,tbl})")))
  (rule (target meta.dune) (action (write-file %{target} "(copy_files ../../META)")))
  (rule (target fake_dynlink.dune) (action (write-file %{target} "(rule (target dynlink.cmxa) (action (write-file \%{target} \"\")))"))))
(subdir build/caml (dynamic_include ../../copy_workaround/headers.dune))
(subdir build/stdlib (dynamic_include ../../copy_workaround/meta.dune))
(subdir build/dynlink (dynamic_include ../../copy_workaround/fake_dynlink.dune))
(subdir build_base/caml (dynamic_include ../../copy_workaround/headers.dune))
(subdir build_base/dynlink
  (dynamic_include ../../copy_workaround/fake_dynlink.dune))
(subdir build_fp/caml (dynamic_include ../../copy_workaround/headers.dune))
(subdir build_fp/dynlink
  (dynamic_include ../../copy_workaround/fake_dynlink.dune))
(subdir build_sc/caml (dynamic_include ../../copy_workaround/headers.dune))
(subdir build_sc/dynlink
  (dynamic_include ../../copy_workaround/fake_dynlink.dune))
(subdir build_poll/caml (dynamic_include ../../copy_workaround/headers.dune))
(subdir build_poll/dynlink
  (dynamic_include ../../copy_workaround/fake_dynlink.dune))
(subdir build_asan-fp/caml
  (dynamic_include ../../copy_workaround/headers.dune))
(subdir build_asan-fp/dynlink
  (dynamic_include ../../copy_workaround/fake_dynlink.dune))
(subdir build_asan-fp-poll/caml
  (dynamic_include ../../copy_workaround/headers.dune))
(subdir build_asan-fp-poll/dynlink
  (dynamic_include ../../copy_workaround/fake_dynlink.dune))
(subdir build_fp-poll/caml
  (dynamic_include ../../copy_workaround/headers.dune))
(subdir build_fp-poll/dynlink
  (dynamic_include ../../copy_workaround/fake_dynlink.dune))
(subdir build_fp-poll-sc/caml
  (dynamic_include ../../copy_workaround/headers.dune))
(subdir build_fp-poll-sc/dynlink
  (dynamic_include ../../copy_workaround/fake_dynlink.dune))
(subdir build_fp-sc/caml (dynamic_include ../../copy_workaround/headers.dune))
(subdir build_fp-sc/dynlink
  (dynamic_include ../../copy_workaround/fake_dynlink.dune))
(subdir build_poll-sc/caml
  (dynamic_include ../../copy_workaround/headers.dune))
(subdir build_poll-sc/dynlink
  (dynamic_include ../../copy_workaround/fake_dynlink.dune))
