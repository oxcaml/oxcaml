(include_subdirs unqualified)

(library
 (name flambda2_algorithms)
 (wrapped true)
 ; Erase OxCaml syntax extensions for the system compiler; see tools/oxpp.
 ; Dune refuses to combine an action-based (preprocess ...) with
 ; (instrumentation ...), so this library is no longer instrumented with
 ; bisect_ppx for coverage builds.
 (preprocess
  (action
   (progn
    (run
     %{exe:../../../tools/oxpp/oxpp.exe}
     -context
     %{context_name}
     %{input-file}))))
 (foreign_stubs
  (language c)
  (names builtin_stubs)
  (flags
   ((:include %{project_root}/%{env:OC_CFLAGS_SEXP=oc_cflags.sexp})
    (:include %{project_root}/sharedlib_cflags.sexp)
    (:include %{project_root}/oc_cppflags.sexp))))
 (ocamlopt_flags
  (:standard
   (:include %{project_root}/ocamlopt_flags.sexp)
   -O3
   -open
   Int_replace_polymorphic_compare))
 (libraries ocamlfrontend))

(install
 (files
  (dllflambda2_algorithms_stubs.so as stublibs/dllflambda2_algorithms_stubs.so))
 (section lib)
 (package ocaml))
