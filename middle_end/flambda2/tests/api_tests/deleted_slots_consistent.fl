(* ACTUAL COMPILER: exercise repeated declarations of one function slot. *)
let code size(1) live (x) closure_var &ar depth -> ret * ex =
  cont ret (x)
in
let first_live = closure live @live_slot &toplevel
and first_deleted = closure deleted conflicting(2) &toplevel
in
let second_live = closure live @live_slot &toplevel
and second_deleted = closure deleted conflicting(2) &toplevel
in
let $Result = Block 0 () in
cont done ($Result)
