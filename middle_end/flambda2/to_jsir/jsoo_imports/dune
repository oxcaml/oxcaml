; The JSIR definition (in code.ml{i}) and its dependencies are imported from the
; js_of_ocaml subtree (external/js_of_ocaml/compiler/lib).

(copy_files#
 %{project_root}/external/js_of_ocaml/compiler/lib/{code,debug,int_set,int_trie,optimization_hint,parse_info,reserved,sizable_int,stdlib,targetint,targetnativeint,timer,warning}.{ml,mli})

; [Stdlib.Float32] is implemented with C stubs.

(copy_files
 %{project_root}/external/js_of_ocaml/compiler/lib/float32_stubs.c)

(rule
 (target ocaml_or_oxcaml.ml)
 (action
  (copy
    ; nothing in to_jsir should use OxCaml-dependent functionality
   %{project_root}/external/js_of_ocaml/compiler/lib/ocaml_or_oxcaml.ocaml.ml
   %{target})))

(library
 (name jsoo_imports)
 (wrapped true)
 (instrumentation
  (backend bisect_ppx))
 (flags
  (:standard -w -4-7-18-32-37-44))
 (foreign_stubs
  (language c)
  (names float32_stubs)
  (flags
   ((:include %{project_root}/%{env:OC_CFLAGS_SEXP=oc_cflags.sexp})
    (:include %{project_root}/sharedlib_cflags.sexp)
    (:include %{project_root}/oc_cppflags.sexp))))
 (ocamlopt_flags
  (:standard -O3)))

(install
 (files
  (dlljsoo_imports_stubs.so as stublibs/dlljsoo_imports_stubs.so))
 (section lib)
 (package ocaml))
