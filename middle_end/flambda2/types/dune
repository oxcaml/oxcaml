(include_subdirs unqualified)

; Note that the type system does not depend on Flambda2_terms.

(library
 (name flambda2_types)
 (wrapped true)
 ; Erase OxCaml syntax extensions for the system compiler; see tools/oxpp.
 ; Dune refuses to combine an action-based (preprocess ...) with
 ; (instrumentation ...), so this library is no longer instrumented with
 ; bisect_ppx for coverage builds.
 (preprocess
  (action
   (progn
    (run
     %{exe:../../../tools/oxpp/oxpp.exe}
     -context
     %{context_name}
     %{input-file}))))
 (flags
  (:standard
   -open
   Flambda2_algorithms
   -open
   Flambda2_bound_identifiers
   -open
   Flambda2_identifiers
   -open
   Flambda2_kinds
   -open
   Flambda2_lattices
   -open
   Flambda2_nominal
   -open
   Flambda2_numbers
   -open
   Flambda2_term_basics
   -open
   Flambda2_classic_mode_types
   -open
   Flambda2_ui))
 (ocamlopt_flags
  (:standard
   (:include %{project_root}/ocamlopt_flags.sexp)
   -O3
   -open
   Int_replace_polymorphic_compare))
 (libraries
  ocamlfrontend
  flambda2_algorithms
  flambda2_bound_identifiers
  flambda2_classic_mode_types
  flambda2_identifiers
  flambda2_kinds
  flambda2_lattices
  flambda2_nominal
  flambda2_numbers
  flambda2_term_basics
  flambda2_ui))
