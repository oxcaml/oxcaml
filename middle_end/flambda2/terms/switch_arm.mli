type t

include Contains_names.S with type t := t

include Contains_ids.S with type t := t

val create : annotations:Branch_annotations.t -> Apply_cont_expr.t -> t

val from_apply_cont : Apply_cont_expr.t -> t

val annotations : t -> Branch_annotations.t

val action : t -> Apply_cont_expr.t

val likelihood : t -> Likelihood.t

(** A cold arm is an arm with zero weight (expected to be taken a minuscule
    amount of time compared to the other arms). *)
val is_cold : t -> bool

val map_action : (Apply_cont_expr.t -> Apply_cont_expr.t) -> t -> t
